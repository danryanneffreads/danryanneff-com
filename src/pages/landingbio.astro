---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="LandingBio | Dan Ryan Neff"
  description="LandingBio is a simple personal page for introducing yourself, sharing what matters, and helping people find their way to your work and ways to connect."
>
  <!-- An immediate explanation and a useful next step -->
  <section class="relative overflow-hidden border-b border-gray-200 bg-white dark:border-gray-800 dark:bg-gray-900">
    <div class="pointer-events-none absolute inset-0" aria-hidden="true">
      <div class="absolute -right-24 top-0 h-72 w-72 rounded-full bg-cyan-100/60 blur-3xl dark:bg-cyan-900/20"></div>
      <div class="absolute -left-24 bottom-0 h-64 w-64 rounded-full bg-indigo-100/60 blur-3xl dark:bg-indigo-900/20"></div>
    </div>

    <div class="relative mx-auto max-w-6xl px-4 py-14 sm:px-6 sm:py-20 lg:px-8 lg:py-24">
      <div class="max-w-3xl">
        <p class="text-sm font-semibold uppercase tracking-[0.16em] text-blue-600 dark:text-blue-400">
          Digital project
        </p>
        <h1 class="mt-4 text-4xl font-bold tracking-tight text-gray-900 dark:text-white sm:text-5xl lg:text-6xl">
          LandingBio
        </h1>
        <p class="mt-5 text-2xl font-medium leading-snug text-gray-900 dark:text-white sm:text-3xl">
          A simple place to introduce yourself online.
        </p>
        <p class="mt-5 max-w-2xl text-lg leading-8 text-gray-600 dark:text-gray-300">
          LandingBio helps people understand who you are, what you're working on, and where to go next. Make a personal page with a short introduction, useful links, and room to change as you do. You don't need a full website or a constant stream of posts.
        </p>

        <div class="mt-8 flex flex-wrap gap-3">
          <a
            href="https://landingbio.com/start-here/"
            target="_blank"
            rel="noopener noreferrer"
            class="landingbio-action landingbio-action--primary inline-flex items-center justify-center rounded-lg bg-blue-600 px-5 py-3 font-semibold text-white"
          >
            Get started
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M7 17 17 7M8 7h9v9" /></svg>
          </a>
          <a
            href="https://landingbio.com/members"
            target="_blank"
            rel="noopener noreferrer"
            class="landingbio-action landingbio-action--secondary inline-flex items-center justify-center rounded-lg border border-gray-300 px-5 py-3 font-semibold text-gray-900 dark:border-gray-700 dark:text-white"
          >
            Explore profiles
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M7 17 17 7M8 7h9v9" /></svg>
          </a>
        </div>
      </div>

      <!-- Use the existing artwork, but keep it visually contained on desktop -->
      <figure class="mt-10 max-w-4xl overflow-hidden rounded-2xl border border-gray-200 bg-gray-950 shadow-sm dark:border-gray-700 sm:mt-12">
        <img
          src="/images/landingbio-hero-personal-entry-page-v1.webp"
          alt="LandingBio project artwork showing a personal entry page on the internet"
          width="1680"
          height="600"
          class="landingbio-preview block h-auto w-full object-contain"
          loading="eager"
          decoding="async"
        />
      </figure>
    </div>
  </section>

  <!-- Benefits in plain language -->
  <section class="bg-gray-50 py-14 dark:bg-gray-950 sm:py-20">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl">
        <h2 class="text-3xl font-bold tracking-tight text-gray-900 dark:text-white sm:text-4xl">
          What you can do with it
        </h2>
        <p class="mt-4 text-lg leading-8 text-gray-600 dark:text-gray-300">
          Start small. Your page can become more useful as your work and interests evolve.
        </p>
      </div>

      <div class="mt-8 grid gap-5 md:grid-cols-3">
        <article class="rounded-2xl border border-gray-200 bg-white p-6 dark:border-gray-800 dark:bg-gray-900">
          <h3 class="text-xl font-bold text-gray-900 dark:text-white">Introduce yourself</h3>
          <p class="mt-3 leading-7 text-gray-600 dark:text-gray-300">
            Add an image and a short bio so visitors can quickly understand who you are.
          </p>
        </article>
        <article class="rounded-2xl border border-gray-200 bg-white p-6 dark:border-gray-800 dark:bg-gray-900">
          <h3 class="text-xl font-bold text-gray-900 dark:text-white">Point people somewhere useful</h3>
          <p class="mt-3 leading-7 text-gray-600 dark:text-gray-300">
            Share links to your work, projects, profiles, or ways to get in touch.
          </p>
        </article>
        <article class="rounded-2xl border border-gray-200 bg-white p-6 dark:border-gray-800 dark:bg-gray-900">
          <h3 class="text-xl font-bold text-gray-900 dark:text-white">Keep it current</h3>
          <p class="mt-3 leading-7 text-gray-600 dark:text-gray-300">
            Update what you're highlighting as your priorities change, without rebuilding a website.
          </p>
        </article>
      </div>
    </div>
  </section>

  <!-- A brief audience explanation and personal context -->
  <section class="border-t border-gray-200 bg-white py-14 dark:border-gray-800 dark:bg-gray-900 sm:py-20">
    <div class="mx-auto grid max-w-6xl gap-10 px-4 sm:px-6 lg:grid-cols-2 lg:gap-16 lg:px-8">
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.16em] text-blue-600 dark:text-blue-400">Who it's for</p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight text-gray-900 dark:text-white sm:text-4xl">
          One place to start, even when you do many things.
        </h2>
        <p class="mt-5 text-lg leading-8 text-gray-600 dark:text-gray-300">
          LandingBio can be useful for independent professionals, artists, makers, people with several projects, or anyone who wants a clear personal introduction to share. It offers a lightweight alternative to building an entire website.
        </p>
      </div>
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.16em] text-blue-600 dark:text-blue-400">Why I built it</p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight text-gray-900 dark:text-white sm:text-4xl">
          Make it easier to connect.
        </h2>
        <p class="mt-5 text-lg leading-8 text-gray-600 dark:text-gray-300">
          I like the idea of having more say in how we introduce ourselves online and how people find their way to us. LandingBio is my exploration of a simple, flexible starting point for those connections.
        </p>
      </div>
    </div>
  </section>

  <!-- A clear action, without requiring the visitor to read more -->
  <section class="border-t border-gray-200 bg-gray-50 py-14 dark:border-gray-800 dark:bg-gray-950 sm:py-16">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <div class="rounded-2xl border border-gray-200 bg-white p-7 dark:border-gray-800 dark:bg-gray-900 sm:p-10">
        <h2 class="text-2xl font-bold text-gray-900 dark:text-white sm:text-3xl">
          See what you can make of it.
        </h2>
        <p class="mt-3 max-w-2xl text-lg leading-8 text-gray-600 dark:text-gray-300">
          Try LandingBio for yourself. If you have feedback or an idea worth exploring together, I'd be glad to hear from you.
        </p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a href="https://landingbio.com/start-here/" target="_blank" rel="noopener noreferrer" class="landingbio-action landingbio-action--primary inline-flex items-center rounded-lg bg-blue-600 px-5 py-3 font-semibold text-white">
            Visit LandingBio
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M7 17 17 7M8 7h9v9" /></svg>
          </a>
          <a href="/contact/" class="landingbio-action landingbio-action--secondary inline-flex items-center rounded-lg border border-gray-300 px-5 py-3 font-semibold text-gray-900 dark:border-gray-700 dark:text-white">
            Contact me
          </a>
          <a href="/projects/" class="inline-flex items-center px-2 py-3 font-medium text-blue-700 dark:text-blue-400">Other projects</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Explicit sizing prevents the oversized desktop image panels seen in an earlier project page. */
  .landingbio-preview {
    display: block;
    width: 100%;
    height: auto;
    max-height: 310px;
    object-fit: contain;
  }
  /* Keep CTA contrast and padding stable even if site-wide link styles apply. */
  a.landingbio-action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    min-height: 3.1rem;
    padding: 0.8rem 1.25rem !important;
    border-radius: 0.65rem;
    line-height: 1.25;
    text-decoration: none !important;
    white-space: normal;
    transition: background-color 160ms ease, border-color 160ms ease;
  }
  a.landingbio-action--primary,
  a.landingbio-action--primary:visited,
  a.landingbio-action--primary:hover { color: #fff !important; }
  a.landingbio-action--primary { background-color: #2563eb; }
  a.landingbio-action--primary:hover { background-color: #1d4ed8; }
  a.landingbio-action--secondary,
  a.landingbio-action--secondary:visited { color: #111827 !important; }
  a.landingbio-action--secondary:hover { background-color: #f3f4f6; }
  :global(.dark) a.landingbio-action--secondary,
  :global(.dark) a.landingbio-action--secondary:visited { color: #fff !important; }
  :global(.dark) a.landingbio-action--secondary:hover { background-color: #1f2937; }
  a.landingbio-action:focus-visible { outline: 3px solid #60a5fa; outline-offset: 3px; }
  a.landingbio-action svg { flex: none; }
</style>
