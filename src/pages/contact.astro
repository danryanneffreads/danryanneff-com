---
import BaseLayout from "../layouts/BaseLayout.astro";

const calUrl = "https://cal.com/danryanneff/conversation";
const emailAddress = "danryanneff@gmail.com";
---

<BaseLayout
  title="Contact | Dan Ryan Neff"
  description="Start a conversation, follow new work by email, or contact Dan Ryan Neff directly."
>
  <main>
    <!-- Hero -->
    <section class="hero">
      <div class="hero__content">
        <p class="eyebrow">Contact</p>

        <h1>What are you thinking about?</h1>

        <div class="hero__intro">
          <p>
            You may be developing an idea, reconsidering how something works,
            or exploring a question that overlaps with my interests.
          </p>

          <p>
            I welcome thoughtful conversations about websites, technology,
            organizations, accessibility, creativity, communities, and the
            systems that shape everyday life.
          </p>
        </div>
      </div>

      <figure class="hero__art" aria-hidden="true">
        <img
          src="/images/orange-loops-green-background.webp"
          alt=""
          width="660"
          height="660"
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
      </figure>
    </section>

    <!-- Contact options -->
    <section class="contact-options" aria-label="Ways to connect">
      <!-- Conversation -->
      <article class="contact-option">
        <p class="contact-option__number" aria-hidden="true">01</p>

        <div class="contact-option__content">
          <p class="contact-option__label">A place to begin</p>

          <h2>Schedule a conversation</h2>

          <div class="contact-option__copy">
            <p>
              A conversation can help clarify an idea, reveal a useful
              connection, or open a direction neither person had anticipated.
            </p>

            <p>
              This is a free, informal conversation rather than a sales call.
              There is no expectation that it needs to lead anywhere in
              particular.
            </p>
          </div>

          <a
            class="button"
            href={calUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            Choose a time
            <span aria-hidden="true">↗</span>
          </a>
        </div>
      </article>

      <!-- Email updates -->
      <article class="contact-option">
        <p class="contact-option__number" aria-hidden="true">02</p>

        <div class="contact-option__content">
          <p class="contact-option__label">Occasional updates</p>

          <h2>Follow what I’m exploring</h2>

          <div class="contact-option__copy">
            <p>
              I occasionally share new projects, observations, questions, and
              additions to the site.
            </p>

            <p>
              Messages are infrequent and written when there is something
              worthwhile to share.
            </p>
          </div>

          <div class="email-signup">
            <iframe
              src="https://embeds.beehiiv.com/7b7905fd-bdf1-49b9-9cbc-754021ddf12e?slim=true"
              data-test-id="beehiiv-embed"
              title="Subscribe to email updates from Dan Ryan Neff"
              height="52"
              frameborder="0"
              scrolling="no"
            ></iframe>
          </div>
        </div>
      </article>

      <!-- Direct email -->
      <article class="contact-option">
        <p class="contact-option__number" aria-hidden="true">03</p>

        <div class="contact-option__content">
          <p class="contact-option__label">Direct contact</p>

          <h2>Send me an email</h2>

          <div class="contact-option__copy">
            <p>
              Email may be the simplest option if you already know what you
              would like to discuss or share.
            </p>
          </div>

          <a
            class="email-link"
            href={`mailto:${emailAddress}`}
            aria-label={`Email ${emailAddress}`}
          >
            {emailAddress}
          </a>
        </div>
      </article>
    </section>

    <!-- Closing -->
    <section class="closing">
      <figure class="closing__art" aria-hidden="true">
        <img
          src="/images/mandala-blue-labyrinth-660.webp"
          alt=""
          width="660"
          height="660"
          loading="lazy"
          decoding="async"
        />
      </figure>

      <div class="closing__content">
        <p class="eyebrow">An open door</p>

        <p class="closing__statement">
          You do not need to arrive with a finished idea.
        </p>

        <p class="closing__support">
          Curiosity, a useful question, or something you have begun noticing is
          enough.
        </p>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  main {
    overflow: hidden;
  }

  .hero,
  .contact-options,
  .closing {
    width: min(1120px, calc(100% - 2rem));
    margin-inline: auto;
  }

  /* Hero */

  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(280px, 0.85fr);
    align-items: center;
    gap: clamp(3rem, 8vw, 7rem);
    min-height: 72vh;
    padding-block: clamp(5rem, 11vw, 9rem);
  }

  .hero__content {
    max-width: 760px;
  }

  .eyebrow,
  .contact-option__label {
    margin: 0;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .eyebrow {
    margin-bottom: 1.25rem;
  }

  h1 {
    max-width: 800px;
    margin: 0;
    font-size: clamp(3.2rem, 7vw, 6.8rem);
    font-weight: 450;
    line-height: 0.98;
    letter-spacing: -0.055em;
    text-wrap: balance;
  }

  .hero__intro {
    max-width: 650px;
    margin-top: 2rem;
    font-size: clamp(1.15rem, 2vw, 1.45rem);
    line-height: 1.6;
  }

  .hero__intro p {
    margin: 0;
  }

  .hero__intro p + p {
    margin-top: 1rem;
  }

  .hero__art {
    margin: 0;
  }

  .hero__art img,
  .closing__art img {
    display: block;
    width: 100%;
    height: auto;
  }

  .hero__art img {
    border-radius: 50%;
  }

  /* Contact options */

  .contact-options {
    border-top: 1px solid currentColor;
  }

  .contact-option {
    display: grid;
    grid-template-columns: minmax(3rem, 0.25fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 5vw, 5rem);
    padding-block: clamp(3.5rem, 7vw, 5.5rem);
    border-bottom: 1px solid currentColor;
  }

  .contact-option__number {
    margin: 0.5rem 0 0;
    font-size: 0.78rem;
    letter-spacing: 0.12em;
  }

  .contact-option__content {
    width: 100%;
    max-width: 760px;
  }

  .contact-option__label {
    margin-bottom: 1rem;
    opacity: 0.68;
  }

  h2 {
    max-width: 720px;
    margin: 0;
    font-size: clamp(2rem, 4.5vw, 4rem);
    font-weight: 450;
    line-height: 1.05;
    letter-spacing: -0.04em;
    text-wrap: balance;
  }

  .contact-option__copy {
    max-width: 640px;
    margin-top: 1.5rem;
    font-size: clamp(1.05rem, 1.8vw, 1.25rem);
    line-height: 1.65;
  }

  .contact-option__copy p {
    margin: 0;
  }

  .contact-option__copy p + p {
    margin-top: 1rem;
  }

  /* Links and actions */

  .button,
  .email-link {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    margin-top: 2rem;
    color: inherit;
    font-weight: 600;
    text-underline-offset: 0.25em;
  }

  .button {
    padding: 0.9rem 1.2rem;
    border: 1px solid currentColor;
    border-radius: 999px;
    text-decoration: none;
    transition:
      opacity 160ms ease,
      transform 160ms ease;
  }

  .button:hover {
    opacity: 0.72;
    transform: translateY(-2px);
  }

  .email-link {
    font-size: clamp(1rem, 2vw, 1.15rem);
    overflow-wrap: anywhere;
  }

  .button:focus-visible,
  .email-link:focus-visible {
    outline: 3px solid currentColor;
    outline-offset: 5px;
  }

  /* Email signup */

  .email-signup {
    width: 100%;
    max-width: 640px;
    margin-top: 2rem;
    overflow: hidden;
  }

  .email-signup iframe {
    display: block;
    width: 100%;
    min-height: 52px;
    margin: 0;
    border: 0;
    background-color: transparent;
  }

  /* Closing */

  .closing {
    display: grid;
    grid-template-columns: minmax(240px, 0.75fr) minmax(0, 1.25fr);
    align-items: center;
    gap: clamp(3rem, 8vw, 7rem);
    padding-block: clamp(5rem, 11vw, 10rem);
  }

  .closing__art {
    max-width: 420px;
    margin: 0;
  }

  .closing__content {
    max-width: 720px;
  }

  .closing__content .eyebrow {
    opacity: 0.68;
  }

  .closing__statement {
    margin: 0;
    font-size: clamp(1.8rem, 4vw, 3.6rem);
    line-height: 1.15;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  .closing__support {
    max-width: 600px;
    margin: 1.5rem 0 0;
    font-size: clamp(1.05rem, 1.8vw, 1.25rem);
    line-height: 1.65;
  }

  /* Responsive */

  @media (max-width: 760px) {
    .hero,
    .closing {
      grid-template-columns: 1fr;
    }

    .hero {
      min-height: auto;
      padding-top: 5rem;
    }

    .hero__art {
      width: min(78vw, 420px);
      margin-inline: auto;
    }

    .contact-option {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }

    .contact-option__number {
      margin: 0;
    }

    .email-signup iframe {
      width: 100%;
    }

    .closing__art {
      width: min(72vw, 360px);
      margin-inline: auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .button {
      transition: none;
    }

    .button:hover {
      transform: none;
    }
  }
</style>