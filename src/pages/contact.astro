---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE_NAME, OG_IMAGE } from "../lib/constants";

// Keep these in one place so they're easy to update later.
const emailAddress = "danryanneff@gmail.com";
const calUrl = "https://cal.com/danryanneff/conversation";
const emailHref = `mailto:${emailAddress}`;
const collaborationHref = `mailto:${emailAddress}?subject=${encodeURIComponent("Work or collaboration inquiry")}`;

const pageTitle = `Contact | ${SITE_NAME}`;
const pageDescription =
  "Get in touch with Dan Ryan Neff about daily money management, administrative and technology-related work, creative projects, or a conversation.";
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  ogTitle={pageTitle}
  ogDescription={pageDescription}
  ogImage={OG_IMAGE}
>
  <!-- A short, direct invitation with two easy ways to reach Dan. -->
  <section
    class="relative overflow-hidden border-b border-gray-200 bg-white dark:border-gray-800 dark:bg-gray-900"
    aria-labelledby="contact-heading"
  >
    <div class="pointer-events-none absolute inset-0" aria-hidden="true">
      <div class="absolute -right-24 top-0 h-80 w-80 rounded-full bg-blue-100/70 blur-3xl dark:bg-blue-900/20"></div>
      <div class="absolute -left-24 bottom-0 h-64 w-64 rounded-full bg-indigo-100/60 blur-3xl dark:bg-indigo-900/20"></div>
    </div>

    <div class="relative mx-auto grid max-w-6xl items-center gap-10 px-4 py-16 sm:px-6 sm:py-20 lg:grid-cols-[minmax(0,1.2fr)_minmax(220px,0.65fr)] lg:gap-16 lg:px-8 lg:py-24">
      <div class="max-w-3xl">
        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-blue-700 dark:text-blue-400">
          Contact Dan Ryan Neff
        </p>
        <h1
          id="contact-heading"
          class="mt-5 text-5xl font-bold leading-[1.04] tracking-tight text-gray-900 dark:text-white sm:text-6xl"
        >
          Let's talk.
        </h1>
        <p class="mt-6 max-w-2xl text-xl font-semibold leading-8 text-gray-900 dark:text-gray-100 sm:text-2xl sm:leading-9">
          Looking for help, considering a collaboration, or simply think we should connect?
        </p>
        <p class="mt-5 max-w-2xl text-lg leading-8 text-gray-700 dark:text-gray-300">
          I'm open to conversations about practical work, technology, creative projects, and new possibilities. You don't need a finished plan or a formal proposal to reach out.
        </p>

        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a
            href={emailHref}
            class="inline-flex min-h-12 items-center justify-center rounded-lg bg-blue-700 px-6 py-3 font-semibold text-white transition-colors hover:bg-blue-800 hover:text-white focus-visible:outline focus-visible:outline-4 focus-visible:outline-offset-2 focus-visible:outline-blue-600 dark:bg-blue-500 dark:text-gray-950 dark:hover:bg-blue-400 dark:hover:text-gray-950"
          >
            Email me
            <span class="ml-2" aria-hidden="true">→</span>
          </a>
          <a
            href={calUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex min-h-12 items-center justify-center rounded-lg border border-gray-300 bg-white px-6 py-3 font-semibold text-gray-900 transition-colors hover:border-blue-500 hover:text-blue-700 focus-visible:outline focus-visible:outline-4 focus-visible:outline-offset-2 focus-visible:outline-blue-600 dark:border-gray-700 dark:bg-gray-900 dark:text-gray-100 dark:hover:border-blue-400 dark:hover:text-blue-300"
          >
            Schedule a conversation
            <span class="ml-2" aria-hidden="true">↗</span>
          </a>
        </div>
        <p class="mt-5 text-base text-gray-700 dark:text-gray-300">
          Or write directly to
          <a
            href={emailHref}
            class="font-semibold text-blue-700 underline underline-offset-4 hover:text-blue-900 dark:text-blue-400 dark:hover:text-blue-300"
          >{emailAddress}</a>.
        </p>
      </div>

      <!-- Use Dan's original artwork, not generic business stock imagery. -->
      <figure class="mx-auto w-full max-w-[280px] sm:max-w-[320px] lg:justify-self-end" aria-hidden="true">
        <img
          src="/images/orange-loops-green-background.webp"
          alt=""
          class="aspect-square w-full rounded-full object-cover shadow-lg shadow-gray-200/60 dark:shadow-black/20"
          width="660"
          height="660"
          loading="eager"
          decoding="async"
        />
      </figure>
    </div>
  </section>

  <!-- Let a visitor recognize their reason for contacting Dan immediately. -->
  <section class="bg-gray-50 py-16 dark:bg-gray-950 sm:py-20" aria-labelledby="reasons-heading">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-[0.18em] text-blue-700 dark:text-blue-400">
        A few places to start
      </p>
      <h2 id="reasons-heading" class="mt-3 text-3xl font-bold tracking-tight text-gray-900 dark:text-white sm:text-4xl">
        What can we talk about?
      </h2>
      <div class="mt-9 grid gap-5 md:grid-cols-3">
        <article class="flex flex-col rounded-2xl border border-gray-200 bg-white p-6 dark:border-gray-800 dark:bg-gray-900 sm:p-7">
          <div class="mb-5 h-1 w-12 rounded-full bg-blue-600 dark:bg-blue-400" aria-hidden="true"></div>
          <h3 class="text-xl font-bold text-gray-900 dark:text-white">Daily Money Management</h3>
          <p class="mt-3 flex-1 text-base leading-7 text-gray-700 dark:text-gray-300">
            Help with bills, paperwork, financial records, and other everyday responsibilities for yourself or someone you care about.
          </p>
          <a href="/dmm/" class="mt-6 inline-flex w-fit items-center font-semibold text-blue-700 underline-offset-4 hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-blue-600 dark:text-blue-400">
            Learn about the service <span class="ml-2" aria-hidden="true">→</span>
          </a>
        </article>

        <article class="flex flex-col rounded-2xl border border-gray-200 bg-white p-6 dark:border-gray-800 dark:bg-gray-900 sm:p-7">
          <div class="mb-5 h-1 w-12 rounded-full bg-indigo-500 dark:bg-indigo-400" aria-hidden="true"></div>
          <h3 class="text-xl font-bold text-gray-900 dark:text-white">Work &amp; collaboration</h3>
          <p class="mt-3 flex-1 text-base leading-7 text-gray-700 dark:text-gray-300">
            Have a need involving administration, coordination, better processes, or technology? I'm interested in discussing where my experience might be useful.
          </p>
          <a href={collaborationHref} class="mt-6 inline-flex w-fit items-center font-semibold text-blue-700 underline-offset-4 hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-blue-600 dark:text-blue-400">
            Discuss an opportunity <span class="ml-2" aria-hidden="true">→</span>
          </a>
        </article>

        <article class="flex flex-col rounded-2xl border border-gray-200 bg-white p-6 dark:border-gray-800 dark:bg-gray-900 sm:p-7">
          <div class="mb-5 h-1 w-12 rounded-full bg-emerald-500 dark:bg-emerald-400" aria-hidden="true"></div>
          <h3 class="text-xl font-bold text-gray-900 dark:text-white">Creative projects &amp; ideas</h3>
          <p class="mt-3 flex-1 text-base leading-7 text-gray-700 dark:text-gray-300">
            Curious about something I'm building, have feedback, or see a possibility for working together? I'd enjoy hearing about it.
          </p>
          <a href="/projects/" class="mt-6 inline-flex w-fit items-center font-semibold text-blue-700 underline-offset-4 hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-blue-600 dark:text-blue-400">
            Explore projects <span class="ml-2" aria-hidden="true">→</span>
          </a>
        </article>
      </div>
    </div>
  </section>

  <!-- No complicated intake process or newsletter required. -->
  <section class="border-t border-gray-200 bg-white dark:border-gray-800 dark:bg-gray-900" aria-labelledby="starting-heading">
    <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6 sm:py-16 lg:px-8">
      <div class="max-w-3xl">
        <h2 id="starting-heading" class="text-2xl font-bold tracking-tight text-gray-900 dark:text-white sm:text-3xl">
          A few sentences are enough to begin.
        </h2>
        <p class="mt-4 text-lg leading-8 text-gray-700 dark:text-gray-300">
          Tell me a little about what you have in mind. We can start with a message or a conversation and see whether there's a useful next step.
        </p>
        <p class="mt-5 text-sm leading-6 text-gray-600 dark:text-gray-400">
          For financial matters, please don't include account numbers, passwords, or other sensitive information in an ordinary email. We can discuss appropriate ways to share documents if needed.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
