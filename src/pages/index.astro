---
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  SITE_NAME,
  OG_IMAGE,
} from '../lib/constants';

const capabilities = [
  {
    title: 'Learning',
    description:
      'How do we deepen understanding, remain curious, and use powerful tools without giving up the work of thinking for ourselves?',
  },
  {
    title: 'Creating',
    description:
      'What helps people move from imagination to expression—and experience creativity as a form of attention, discovery, and participation?',
  },
  {
    title: 'Participating',
    description:
      'How can accessibility, thoughtful design, and supportive environments help more people engage fully with the world around them?',
  },
  {
    title: 'Working together',
    description:
      'What makes organizations more humane, capable, and responsive without reducing people to processes, outputs, or data?',
  },
  {
    title: 'Living well',
    description:
      'How do our habits, technologies, relationships, and surroundings affect our ability to live with energy, focus, meaning, and agency?',
  },
  {
    title: 'Shaping environments',
    description:
      'How do the physical and digital places we create influence what people notice, believe, attempt, and become able to do?',
  },
];

const projects = [
  {
    title: 'Mandalafy',
    description:
      'A creative project exploring symmetry, color, attention, play, and the experience of making and encountering patterns.',
    href: '/projects/mandalafy/',
    theme: 'Creativity and attention',
  },
  {
    title: 'LandingBio',
    description:
      'An exploration of how people represent themselves, share what matters to them, and create a more intentional home online.',
    href: '/projects/landingbio/',
    theme: 'Identity and connection',
  },
  {
    title: 'ImagineThis.Site',
    description:
      'A growing collection of ideas and practical tools for imagining, planning, and building meaningful places on the web.',
    href: '/projects/imaginethis-site/',
    theme: 'Learning and expression',
  },
];

const currentQuestions = [
  'When does technology expand human capability, and when does it quietly diminish it?',
  'What helps people preserve attention in environments designed to capture it?',
  'How can accessibility change not only who can participate, but the quality of an experience for everyone?',
  'What makes an organization genuinely capable rather than merely efficient?',
  'How do the places we build—physical and digital—shape what people believe is possible?',
];

const pageTitle = `${SITE_NAME} | Exploring human capability`;

const pageDescription =
  'Exploring what helps people learn, create, participate, work together, and live more fully.';
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  ogTitle={pageTitle}
  ogDescription={pageDescription}
  ogImage={OG_IMAGE}
>
  <!-- Hero -->
  <section
    class="relative overflow-hidden border-b border-gray-200 bg-white dark:border-gray-800 dark:bg-gray-900"
  >
    <div
      class="pointer-events-none absolute inset-0"
      aria-hidden="true"
    >
      <div
        class="absolute -right-32 top-8 h-96 w-96 rounded-full bg-blue-100/70 blur-3xl dark:bg-blue-900/20"
      >
      </div>

      <div
        class="absolute -left-32 bottom-0 h-80 w-80 rounded-full bg-indigo-100/60 blur-3xl dark:bg-indigo-900/20"
      >
      </div>
    </div>

    <div
      class="relative mx-auto max-w-6xl px-4 py-20 sm:px-6 sm:py-28 lg:px-8 lg:py-32"
    >
      <div
        class="grid items-center gap-14 lg:grid-cols-[minmax(0,1.5fr)_minmax(240px,0.5fr)] lg:gap-16"
      >
        <div class="max-w-4xl">
          <p
            class="mb-6 text-sm font-semibold uppercase tracking-[0.18em] text-blue-600 dark:text-blue-400"
          >
            An ongoing exploration
          </p>

          <h1
            class="text-5xl font-bold leading-[1.02] tracking-tight text-gray-900 dark:text-white sm:text-6xl lg:text-7xl"
          >
            Exploring human capability.
          </h1>

          <p
            class="mt-8 max-w-3xl text-2xl font-medium leading-tight tracking-tight text-gray-800 dark:text-gray-100 sm:text-3xl"
          >
            What helps people become more capable?
          </p>

          <div
            class="mt-8 max-w-3xl space-y-5 text-lg leading-8 text-gray-600 dark:text-gray-300 sm:text-xl"
          >
            <p>
              Technology sometimes does.
            </p>

            <p>
              So do healthy habits, creative practice, accessible design,
              thoughtful organizations, supportive communities, and the
              environments we build together.
            </p>

            <p>
              This site is where I explore those possibilities through ideas,
              projects, and conversation.
            </p>
          </div>

          <div class="mt-10 flex flex-wrap gap-4">
            <a
              href="#explore"
              class="inline-flex items-center rounded-lg bg-blue-600 px-6 py-3 font-medium text-white transition-colors hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 dark:focus:ring-offset-gray-900"
            >
              Begin exploring
              <span class="ml-2" aria-hidden="true">↓</span>
            </a>

            <a
              href="/projects/"
              class="inline-flex items-center rounded-lg border border-gray-300 bg-white px-6 py-3 font-medium text-gray-800 transition-colors hover:border-blue-500 hover:text-blue-600 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 dark:border-gray-700 dark:bg-gray-900 dark:text-gray-200 dark:hover:border-blue-400 dark:hover:text-blue-400 dark:focus:ring-offset-gray-900"
            >
              Explore projects
            </a>
          </div>
        </div>

        <figure
          class="mx-auto w-full max-w-xs lg:mx-0 lg:max-w-none lg:justify-self-end"
        >
          <div
            class="relative overflow-hidden rounded-[2rem] border border-gray-200 bg-gray-100 shadow-lg shadow-gray-200/60 dark:border-gray-700 dark:bg-gray-800 dark:shadow-black/20"
          >
            <img
              src="/images/dan-ryan-neff.webp"
              alt="Dan Ryan Neff outdoors"
              class="aspect-[4/5] w-full object-cover object-center"
              width="640"
              height="800"
              loading="eager"
              decoding="async"
              fetchpriority="high"
            />
          </div>

          <figcaption
            class="mt-4 text-center text-sm text-gray-500 dark:text-gray-400 lg:text-left"
          >
            Dan Ryan Neff
          </figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- Central idea -->
  <section
    id="explore"
    class="scroll-mt-24 bg-white dark:bg-gray-900"
  >
    <div
      class="mx-auto grid max-w-6xl gap-8 px-4 py-20 sm:px-6 lg:grid-cols-[0.42fr_1fr] lg:px-8 lg:py-28"
    >
      <div>
        <p
          class="text-sm font-semibold uppercase tracking-[0.18em] text-blue-600 dark:text-blue-400"
        >
          The central idea
        </p>
      </div>

      <div class="max-w-3xl">
        <p
          class="text-3xl font-semibold leading-tight tracking-tight text-gray-900 dark:text-white sm:text-4xl"
        >
          Human capability is shaped by more than individual talent or effort.
        </p>

        <div
          class="mt-8 space-y-5 text-lg leading-8 text-gray-600 dark:text-gray-300"
        >
          <p>
            It is shaped by the tools available to us, the systems surrounding
            us, the people who support us, the habits we cultivate, and the
            environments in which we live and work.
          </p>

          <p>
            A good tool can extend perception, memory, creativity, movement, or
            communication. A thoughtful organization can help people contribute
            at a level they could not reach alone. An accessible environment can
            turn exclusion into participation.
          </p>

          <p>
            The opposite is also true. Tools can weaken judgment. Systems can
            narrow possibility. Environments can exhaust attention or prevent
            people from participating at all.
          </p>

          <p class="font-medium text-gray-900 dark:text-white">
            The question is not simply what people can do. It is what helps them
            become able to do more.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Dimensions of capability -->
  <section
    class="border-y border-gray-200 bg-gray-50 dark:border-gray-800 dark:bg-gray-950"
  >
    <div
      class="mx-auto max-w-6xl px-4 py-20 sm:px-6 lg:px-8 lg:py-28"
    >
      <div class="max-w-3xl">
        <p
          class="text-sm font-semibold uppercase tracking-[0.18em] text-blue-600 dark:text-blue-400"
        >
          Dimensions of capability
        </p>

        <h2
          class="mt-5 text-4xl font-bold tracking-tight text-gray-900 dark:text-white sm:text-5xl"
        >
          Becoming capable takes many forms.
        </h2>

        <p
          class="mt-6 text-lg leading-8 text-gray-600 dark:text-gray-300"
        >
          Capability is not one fixed trait. It changes across situations,
          stages of life, relationships, and environments.
        </p>
      </div>

      <div class="mt-14 grid gap-6 md:grid-cols-2">
        {
          capabilities.map((capability, index) => (
            <article
              class="rounded-2xl border border-gray-200 bg-white p-7 dark:border-gray-800 dark:bg-gray-900 sm:p-8"
            >
              <div class="flex items-start gap-4">
                <span
                  class="pt-1 font-mono text-xs text-gray-400 dark:text-gray-500"
                >
                  {String(index + 1).padStart(2, '0')}
                </span>

                <div>
                  <h3
                    class="text-xl font-bold text-gray-900 dark:text-white"
                  >
                    {capability.title}
                  </h3>

                  <p
                    class="mt-4 leading-7 text-gray-600 dark:text-gray-300"
                  >
                    {capability.description}
                  </p>
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Technology -->
  <section class="bg-white dark:bg-gray-900">
    <div
      class="mx-auto grid max-w-6xl gap-10 px-4 py-20 sm:px-6 lg:grid-cols-[0.85fr_1.15fr] lg:items-start lg:px-8 lg:py-28"
    >
      <div>
        <p
          class="text-sm font-semibold uppercase tracking-[0.18em] text-blue-600 dark:text-blue-400"
        >
          Technology and human life
        </p>

        <h2
          class="mt-5 text-4xl font-bold tracking-tight text-gray-900 dark:text-white sm:text-5xl"
        >
          Technology is one influence among many—but an increasingly powerful
          one.
        </h2>
      </div>

      <div
        class="space-y-5 text-lg leading-8 text-gray-600 dark:text-gray-300"
      >
        <p>
          Technology can help people communicate across distance, navigate
          disability, learn unfamiliar subjects, create new forms of art, manage
          complex work, and gain access to knowledge that once belonged to only
          a few.
        </p>

        <p>
          It can also overwhelm attention, replace judgment, intensify
          inequality, weaken relationships, and reorganize human life around the
          needs of systems rather than people.
        </p>

        <p>
          I am interested in neither rejecting technology nor accepting every
          new capability uncritically. I am interested in learning how to use,
          design, and shape technology in ways that expand human possibility
          without diminishing human life.
        </p>
      </div>
    </div>
  </section>

  <!-- Environments -->
  <section
    class="border-y border-gray-200 bg-gray-50 dark:border-gray-800 dark:bg-gray-950"
  >
    <div
      class="mx-auto grid max-w-6xl gap-10 px-4 py-20 sm:px-6 lg:grid-cols-2 lg:items-center lg:px-8 lg:py-28"
    >
      <div>
        <p
          class="text-sm font-semibold uppercase tracking-[0.18em] text-blue-600 dark:text-blue-400"
        >
          The places we inhabit
        </p>

        <h2
          class="mt-5 text-4xl font-bold tracking-tight text-gray-900 dark:text-white sm:text-5xl"
        >
          Environments shape what people are able to do.
        </h2>
      </div>

      <div
        class="space-y-5 text-lg leading-8 text-gray-600 dark:text-gray-300"
      >
        <p>
          Some environments are physical: homes, workplaces, neighborhoods,
          cities, natural landscapes, and public spaces.
        </p>

        <p>
          Others are digital: websites, platforms, online communities,
          information systems, and spaces increasingly shaped by artificial
          intelligence.
        </p>

        <p>
          Each environment directs attention, encourages certain behaviors,
          makes some actions easier, and makes others difficult or impossible.
          None of us merely occupies these places. Through our choices, we also
          help shape them for the people who come after us.
        </p>
      </div>
    </div>
  </section>

  <!-- Projects -->
  <section class="bg-white dark:bg-gray-900">
    <div
      class="mx-auto max-w-6xl px-4 py-20 sm:px-6 lg:px-8 lg:py-28"
    >
      <div
        class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between"
      >
        <div class="max-w-3xl">
          <p
            class="text-sm font-semibold uppercase tracking-[0.18em] text-blue-600 dark:text-blue-400"
          >
            Selected projects
          </p>

          <h2
            class="mt-5 text-4xl font-bold tracking-tight text-gray-900 dark:text-white sm:text-5xl"
          >
            Ideas become clearer when they take form.
          </h2>

          <p
            class="mt-6 text-lg leading-8 text-gray-600 dark:text-gray-300"
          >
            These projects explore different aspects of creativity, identity,
            learning, participation, and life online.
          </p>
        </div>

        <a
          href="/projects/"
          class="font-medium text-blue-600 transition-colors hover:text-blue-700 dark:text-blue-400 dark:hover:text-blue-300"
        >
          View all projects
          <span class="ml-1" aria-hidden="true">→</span>
        </a>
      </div>

      <div class="mt-14 grid gap-6 lg:grid-cols-3">
        {
          projects.map((project) => (
            <a
              href={project.href}
              class="group flex min-h-80 flex-col justify-between rounded-2xl border border-gray-200 bg-gray-50 p-8 transition-all hover:-translate-y-1 hover:border-blue-300 hover:shadow-lg dark:border-gray-800 dark:bg-gray-950 dark:hover:border-blue-700"
            >
              <div>
                <p
                  class="text-xs font-semibold uppercase tracking-[0.16em] text-blue-600 dark:text-blue-400"
                >
                  {project.theme}
                </p>

                <h3
                  class="mt-5 text-3xl font-bold tracking-tight text-gray-900 dark:text-white"
                >
                  {project.title}
                </h3>

                <p
                  class="mt-5 leading-7 text-gray-600 dark:text-gray-300"
                >
                  {project.description}
                </p>
              </div>

              <span
                class="mt-10 font-medium text-gray-900 dark:text-white"
              >
                Explore project

                <span
                  class="ml-2 inline-block transition-transform group-hover:translate-x-1"
                  aria-hidden="true"
                >
                  →
                </span>
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Current questions -->
  <section class="bg-gray-900 text-white dark:bg-black">
    <div
      class="mx-auto grid max-w-6xl gap-12 px-4 py-20 sm:px-6 lg:grid-cols-[0.62fr_1fr] lg:px-8 lg:py-28"
    >
      <div>
        <p
          class="text-sm font-semibold uppercase tracking-[0.18em] text-blue-400"
        >
          Current questions
        </p>

        <h2
          class="mt-5 text-4xl font-bold tracking-tight sm:text-5xl"
        >
          Questions worth staying with.
        </h2>

        <p class="mt-6 max-w-xl text-lg leading-8 text-gray-300">
          I do not expect every question here to resolve into a simple answer.
          The value is often in learning how to see the question more clearly.
        </p>
      </div>

      <ol class="border-t border-gray-700">
        {
          currentQuestions.map((question, index) => (
            <li
              class="grid grid-cols-[2rem_1fr] gap-4 border-b border-gray-700 py-6 sm:grid-cols-[3rem_1fr]"
            >
              <span class="pt-1 font-mono text-xs text-gray-500">
                {String(index + 1).padStart(2, '0')}
              </span>

              <p class="text-xl leading-8 text-gray-200 sm:text-2xl">
                {question}
              </p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- About bridge -->
  <section class="bg-white dark:bg-gray-900">
    <div
      class="mx-auto grid max-w-6xl gap-10 px-4 py-20 sm:px-6 lg:grid-cols-[0.8fr_1.2fr] lg:items-center lg:px-8 lg:py-28"
    >
      <div>
        <p
          class="text-sm font-semibold uppercase tracking-[0.18em] text-blue-600 dark:text-blue-400"
        >
          Why I am exploring this
        </p>

        <h2
          class="mt-5 text-4xl font-bold tracking-tight text-gray-900 dark:text-white sm:text-5xl"
        >
          My work has repeatedly brought me to the intersection of people,
          systems, and technology.
        </h2>
      </div>

      <div>
        <div
          class="space-y-5 text-lg leading-8 text-gray-600 dark:text-gray-300"
        >
          <p>
            I spent more than two decades working inside organizations,
            including years leading people, improving operations, building
            processes, and helping others navigate change.
          </p>

          <p>
            Alongside that work, I have built websites, developed digital
            projects, explored accessibility, experimented with artificial
            intelligence, and continued thinking about the systems that shape
            how people live and participate.
          </p>

          <p>
            Those experiences have made me less interested in technology as an
            end in itself and more interested in the human possibilities it can
            strengthen—or weaken.
          </p>
        </div>

        <a
          href="/about/"
          class="mt-8 inline-flex items-center font-medium text-blue-600 transition-colors hover:text-blue-700 dark:text-blue-400 dark:hover:text-blue-300"
        >
          Read more about me
          <span class="ml-2" aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Invitation -->
  <section
    class="border-t border-gray-200 bg-gray-50 dark:border-gray-800 dark:bg-gray-950"
  >
    <div
      class="mx-auto max-w-6xl px-4 py-20 sm:px-6 lg:px-8 lg:py-28"
    >
      <div
        class="rounded-3xl border border-gray-200 bg-white px-6 py-14 dark:border-gray-800 dark:bg-gray-900 sm:px-10 lg:px-14 lg:py-20"
      >
        <div class="max-w-4xl">
          <p
            class="text-sm font-semibold uppercase tracking-[0.18em] text-blue-600 dark:text-blue-400"
          >
            Continue the exploration
          </p>

          <h2
            class="mt-5 text-4xl font-bold tracking-tight text-gray-900 dark:text-white sm:text-5xl"
          >
            Meaningful questions become more useful when we explore them
            together.
          </h2>

          <p
            class="mt-6 max-w-3xl text-lg leading-8 text-gray-600 dark:text-gray-300"
          >
            You may be building something, navigating change, thinking about
            technology, or trying to create conditions in which people can do
            better work and live more fully. I welcome thoughtful conversation
            about any of it.
          </p>

          <a
            href="/contact/"
            class="mt-9 inline-flex items-center rounded-lg bg-blue-600 px-6 py-3 font-medium text-white transition-colors hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 dark:focus:ring-offset-gray-900"
          >
            Start a conversation
            <span class="ml-2" aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>