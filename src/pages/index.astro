---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE_NAME, OG_IMAGE } from "../lib/constants";

const environments = [
  {
    title: "Technology & AI",
    description:
      "Using powerful tools in ways that strengthen judgment, creativity, learning, and human connection.",
  },
  {
    title: "Health & Daily Life",
    description:
      "How habits, relationships, movement, rest, and everyday choices compound into a better life.",
  },
  {
    title: "Organizations",
    description:
      "Creating the conditions for people to work together effectively, contribute meaningfully, and pursue shared goals.",
  },
  {
    title: "Accessibility",
    description:
      "Designing experiences and environments that enable more people to participate fully and independently.",
  },
  {
    title: "Creativity",
    description:
      "Making things, following ideas, and giving imagination a form that can be shared with others.",
  },
  {
    title: "Communities & Places",
    description:
      "How cities, public spaces, gardens, transportation, and local relationships shape the way people live.",
  },
];

const projects = [
  {
    title: "Mandalafy",
    description:
      "A creative project shaped by symmetry, color, attention, play, and the pleasure of encountering a compelling pattern.",
    href: "/projects/mandalafy/",
    theme: "Art and creativity",
    image: "/images/mandala-woven-sunlight-660.webp",
    imageAlt: "Intricate circular mandala in yellow, green, blue, and red",
    imageClass: "object-contain p-4",
  },
  {
    title: "LandingBio",
    description:
      "A different way for people to create a thoughtful, personal, and intentional presence on the web.",
    href: "/projects/landingbio/",
    theme: "Identity and connection",
    image: "/images/landingbio-hero-personal-entry-page-v1.webp",
    imageAlt: "LandingBio personal entry page shown against a starry background",
    imageClass: "object-contain p-3",
  },
  {
    title: "ImagineThis.Site",
    description:
      "Ideas, examples, and practical resources for imagining and building websites that better reflect their purpose.",
    href: "/projects/imaginethis-site/",
    theme: "Websites and possibility",
    image: "/images/DOT_artist_with_ideas.webp",
    imageAlt: "Illustration of an artist surrounded by interconnected ideas",
    imageClass: "object-contain p-4",
  },
];

const currentQuestions = [
  "What kinds of environments help people and meaningful work flourish?",
  "How can AI strengthen our thinking without doing all of our thinking for us?",
  "What makes an organization effective, humane, and capable of pursuing its purpose?",
  "How do our habits and surroundings influence the lives we gradually build?",
  "What helps more people participate fully in our workplaces, communities, and shared spaces?",
  "How can we contribute to the internet without overwhelming it with disposable content?",
];

const pageTitle = `${SITE_NAME} | Good judgment in a changing world`;

const pageDescription =
  "Ideas, projects, and conversations about how thoughtful judgment, good design, and human creativity can help people participate well in a changing world.";
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  ogTitle={pageTitle}
  ogDescription={pageDescription}
  ogImage={OG_IMAGE}
>
  <!-- Hero -->
  <section
    class="relative overflow-hidden border-b border-gray-200 bg-white dark:border-gray-800 dark:bg-gray-900"
  >
    <div class="pointer-events-none absolute inset-0" aria-hidden="true">
      <div
        class="absolute -right-32 top-8 h-96 w-96 rounded-full bg-blue-100/70 blur-3xl dark:bg-blue-900/20"
      >
      </div>

      <div
        class="absolute -left-32 bottom-0 h-80 w-80 rounded-full bg-indigo-100/60 blur-3xl dark:bg-indigo-900/20"
      >
      </div>
    </div>

    <div
      class="relative mx-auto max-w-6xl px-4 py-20 sm:px-6 sm:py-28 lg:px-8 lg:py-32"
    >
      <div
        class="grid items-center gap-14 lg:grid-cols-[minmax(0,1.5fr)_minmax(240px,0.5fr)] lg:gap-16"
      >
        <div class="max-w-4xl">
          <p
            class="mb-6 text-sm font-semibold uppercase tracking-[0.18em] text-blue-600 dark:text-blue-400"
          >
            Dan Ryan Neff
          </p>

          <!-- Mobile artwork: deliberately cropped so the hero begins visually -->
          <div
            class="relative -mx-4 mb-8 h-48 overflow-hidden sm:-mx-6 sm:h-56 lg:hidden"
            aria-hidden="true"
          >
            <div
              class="absolute left-1/2 top-1/2 h-80 w-80 -translate-x-1/2 -translate-y-1/2 sm:h-96 sm:w-96"
            >
              <img
                src="/images/mandala-red-fire-maze-660.webp"
                alt=""
                class="h-full w-full animate-spin-slow object-contain opacity-90"
                width="660"
                height="660"
                loading="eager"
                decoding="async"
              />
            </div>
          </div>

          <h1
            class="text-5xl font-bold leading-[1.02] tracking-tight text-gray-900 dark:text-white sm:text-6xl lg:text-7xl"
          >
            Good judgment in a changing world.
          </h1>

          <div
            class="mt-8 max-w-3xl space-y-5 text-lg leading-8 text-gray-600 dark:text-gray-300 sm:text-xl"
          >
            <p>
              We live within many kinds of environments—technological,
              organizational, physical, and social. The choices we make within
              them shape what becomes possible for ourselves and for one
              another.
            </p>

            <p>
              My work explores how thoughtful judgment, good design, and human
              creativity can help people participate more fully in those
              environments.
            </p>

            <p>
              Through projects, writing, conversations, and ongoing experiments,
              I explore ideas that can make people more capable, communities
              stronger, and technology more humane.
            </p>
          </div>

          <p
            class="mt-7 max-w-3xl text-lg font-medium leading-8 text-gray-800 dark:text-gray-100 sm:text-xl"
          >
            You’re invited to think alongside me, explore what I’m building, and
            follow the ideas wherever they lead.
          </p>

          <figure class="mt-8 lg:hidden">
            <div
              class="w-40 overflow-hidden rounded-2xl border border-gray-200 bg-gray-100 shadow-md shadow-gray-200/50 dark:border-gray-700 dark:bg-gray-800 dark:shadow-black/20 sm:w-44"
            >
              <img
                src="/images/dan-ryan-neff.webp"
                alt="Dan Ryan Neff outdoors"
                class="aspect-square w-full object-cover object-center"
                width="640"
                height="640"
                loading="eager"
                decoding="async"
              />
            </div>
          </figure>

          <div class="mt-10 flex flex-wrap gap-4">
            <a
              href="/projects/"
              class="inline-flex items-center rounded-lg bg-blue-600 px-6 py-3 font-medium text-white transition-colors hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 dark:focus:ring-offset-gray-900"
            >
              Explore projects
              <span class="ml-2" aria-hidden="true">→</span>
            </a>

            <a
              href="/contact/"
              class="inline-flex items-center rounded-lg border border-gray-300 bg-white px-6 py-3 font-medium text-gray-800 transition-colors hover:border-blue-500 hover:text-blue-600 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 dark:border-gray-700 dark:bg-gray-900 dark:text-gray-200 dark:hover:border-blue-400 dark:hover:text-blue-400 dark:focus:ring-offset-gray-900"
            >
              Start a conversation
            </a>
          </div>
        </div>

        <figure
          class="relative mx-auto hidden w-full max-w-xs lg:block lg:max-w-none lg:justify-self-end"
        >
          <!-- The mandala acts as an artistic halo rather than a page background. -->
          <div
            class="pointer-events-none absolute -inset-16 flex items-center justify-center"
            aria-hidden="true"
          >
            <img
              src="/images/mandala-red-fire-maze-660.webp"
              alt=""
              class="h-[27rem] w-[27rem] max-w-none animate-spin-slow object-contain opacity-45 dark:opacity-50"
              width="660"
              height="660"
              loading="eager"
              decoding="async"
            />
          </div>

          <div
            class="relative z-10 overflow-hidden rounded-[2rem] border border-gray-200 bg-gray-100 shadow-lg shadow-gray-200/60 dark:border-gray-700 dark:bg-gray-800 dark:shadow-black/20"
          >
            <img
              src="/images/dan-ryan-neff.webp"
              alt="Dan Ryan Neff outdoors"
              class="aspect-[4/5] w-full object-cover object-center"
              width="640"
              height="800"
              loading="eager"
              decoding="async"
              fetchpriority="high"
            />
          </div>
        </figure>
      </div>
    </div>
  </section>

  <!-- Orientation -->
  <section id="explore" class="scroll-mt-24 bg-white dark:bg-gray-900">
    <div
      class="mx-auto grid max-w-6xl gap-8 px-4 py-20 sm:px-6 lg:grid-cols-[0.42fr_1fr] lg:px-8 lg:py-28"
    >
      <div>
        <p
          class="text-sm font-semibold uppercase tracking-[0.18em] text-blue-600 dark:text-blue-400"
        >
          A place to explore
        </p>
      </div>

      <div class="max-w-3xl">
        <h2
          class="text-3xl font-semibold leading-tight tracking-tight text-gray-900 dark:text-white sm:text-4xl"
        >
          Better lives emerge from the environments we shape together.
        </h2>

        <div
          class="mt-8 space-y-6 text-lg leading-8 text-gray-600 dark:text-gray-300"
        >
          <p>
            Technology is one environment. Organizations are another. So are
            our communities, our habits, our homes, and the digital spaces we
            create.
          </p>

          <p>
            Each influences how we learn, contribute, connect, and pursue what
            matters. I am interested in how these environments interact—and in
            the thoughtful choices that help people, meaningful work, and
            communities flourish.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Environments -->
  <section
    class="border-y border-gray-200 bg-gray-50 dark:border-gray-800 dark:bg-gray-950"
  >
    <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 lg:px-8 lg:py-28">
      <div class="max-w-3xl">
        <p
          class="text-sm font-semibold uppercase tracking-[0.18em] text-blue-600 dark:text-blue-400"
        >
          Environments I explore
        </p>

        <h2
          class="mt-5 text-4xl font-bold tracking-tight text-gray-900 dark:text-white sm:text-5xl"
        >
          Different environments. One continuing inquiry.
        </h2>

        <p class="mt-6 text-lg leading-8 text-gray-600 dark:text-gray-300">
          These are some of the environments where I spend my time learning,
          building, and asking questions. Each offers a different perspective
          on what helps people participate well in a changing world.
        </p>
      </div>

      <div class="mt-14 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {
          environments.map((environment, index) => (
            <article class="rounded-2xl border border-gray-200 bg-white p-7 dark:border-gray-800 dark:bg-gray-900 sm:p-8">
              <div class="flex items-start gap-4">
                <span class="pt-1 font-mono text-xs text-gray-400 dark:text-gray-500">
                  {String(index + 1).padStart(2, "0")}
                </span>

                <div>
                  <h3 class="text-xl font-bold text-gray-900 dark:text-white">
                    {environment.title}
                  </h3>

                  <p class="mt-4 leading-7 text-gray-600 dark:text-gray-300">
                    {environment.description}
                  </p>
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Connected ideas visual -->
  <section
    class="border-b border-gray-200 bg-white dark:border-gray-800 dark:bg-gray-900"
    aria-labelledby="connected-ideas-heading"
  >
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:px-8 lg:py-20">
      <div class="mx-auto max-w-5xl">
        <p
          id="connected-ideas-heading"
          class="mb-7 text-center text-sm font-semibold uppercase tracking-[0.18em] text-blue-600 dark:text-blue-400"
        >
          Ideas in connection
        </p>

        <figure
          class="overflow-hidden rounded-3xl border border-gray-200 bg-gray-950 shadow-lg shadow-gray-200/50 dark:border-gray-800 dark:shadow-black/20"
        >
          <img
            src="/images/dot-compilation.webp"
            alt="A collection of circular illustrations connected within one composition"
            class="h-auto w-full object-contain"
            width="1200"
            height="675"
            loading="lazy"
            decoding="async"
          />
        </figure>
      </div>
    </div>
  </section>

  <!-- Projects -->
  <section class="bg-white dark:bg-gray-900">
    <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 lg:px-8 lg:py-28">
      <div
        class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between"
      >
        <div class="max-w-3xl">
          <p
            class="text-sm font-semibold uppercase tracking-[0.18em] text-blue-600 dark:text-blue-400"
          >
            Selected projects
          </p>

          <h2
            class="mt-5 text-4xl font-bold tracking-tight text-gray-900 dark:text-white sm:text-5xl"
          >
            Some ideas become things you can visit.
          </h2>

          <div
            class="mt-6 max-w-3xl space-y-4 text-lg leading-8 text-gray-600 dark:text-gray-300"
          >
            <p>
              Some ideas remain questions. Others become experiments, websites,
              creative projects, or practical resources that people can use.
            </p>

            <p>
              These projects are places where ideas take on a more tangible
              form.
            </p>
          </div>
        </div>

        <a
          href="/projects/"
          class="font-medium text-blue-600 transition-colors hover:text-blue-700 dark:text-blue-400 dark:hover:text-blue-300"
        >
          View all projects
          <span class="ml-1" aria-hidden="true">→</span>
        </a>
      </div>

      <div class="mt-14 grid gap-6 lg:grid-cols-3">
        {
          projects.map((project) => (
            <a
              href={project.href}
              class="group flex min-h-[30rem] flex-col overflow-hidden rounded-2xl border border-gray-200 bg-gray-50 transition-all hover:-translate-y-1 hover:border-blue-300 hover:shadow-lg dark:border-gray-800 dark:bg-gray-950 dark:hover:border-blue-700"
            >
              <div
                class="overflow-hidden border-b border-gray-200 bg-gray-900 dark:border-gray-800"
              >
                <img
                  src={project.image}
                  alt={project.imageAlt}
                  class:list={[
                    "aspect-[16/9] w-full transition-transform duration-500 group-hover:scale-[1.025]",
                    project.imageClass,
                  ]}
                  width="660"
                  height="371"
                  loading="lazy"
                  decoding="async"
                />
              </div>

              <div class="flex flex-1 flex-col justify-between p-8">
                <div>
                  <p class="text-xs font-semibold uppercase tracking-[0.16em] text-blue-600 dark:text-blue-400">
                    {project.theme}
                  </p>

                  <h3 class="mt-5 text-3xl font-bold tracking-tight text-gray-900 dark:text-white">
                    {project.title}
                  </h3>

                  <p class="mt-5 leading-7 text-gray-600 dark:text-gray-300">
                    {project.description}
                  </p>
                </div>

                <span class="mt-10 font-medium text-gray-900 dark:text-white">
                Explore project
                <span
                  class="ml-2 inline-block transition-transform group-hover:translate-x-1"
                  aria-hidden="true"
                >
                  →
                </span>
              </span>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Current questions -->
  <section class="bg-gray-900 text-white dark:bg-black">
    <div
      class="mx-auto grid max-w-6xl gap-12 px-4 py-20 sm:px-6 lg:grid-cols-[0.62fr_1fr] lg:px-8 lg:py-28"
    >
      <div>
        <p
          class="text-sm font-semibold uppercase tracking-[0.18em] text-blue-400"
        >
          Questions on my mind
        </p>

        <h2 class="mt-5 text-4xl font-bold tracking-tight sm:text-5xl">
          Curiosity is often a good place to begin.
        </h2>

        <p class="mt-6 max-w-xl text-lg leading-8 text-gray-300">
          These are some of the questions I keep returning to. They shape what I
          notice, what I build, and the conversations I most enjoy having.
        </p>
      </div>

      <ol class="border-t border-gray-700">
        {
          currentQuestions.map((question, index) => (
            <li class="grid grid-cols-[2rem_1fr] gap-4 border-b border-gray-700 py-6 sm:grid-cols-[3rem_1fr]">
              <span class="pt-1 font-mono text-xs text-gray-500">
                {String(index + 1).padStart(2, "0")}
              </span>

              <p class="text-xl leading-8 text-gray-200 sm:text-2xl">
                {question}
              </p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- About -->
  <section class="bg-white dark:bg-gray-900">
    <div
      class="mx-auto grid max-w-6xl gap-10 px-4 py-20 sm:px-6 lg:grid-cols-[0.62fr_1fr] lg:items-center lg:gap-16 lg:px-8 lg:py-28"
    >
      <div>
        <p
          class="text-sm font-semibold uppercase tracking-[0.18em] text-blue-600 dark:text-blue-400"
        >
          About Dan
        </p>

        <figure
          class="mt-7 overflow-hidden rounded-2xl border border-gray-200 bg-stone-50 shadow-sm dark:border-gray-800 dark:bg-gray-950"
        >
          <img
            src="/images/SubtleCircles.webp"
            alt="A quiet abstract composition of circles, lines, and geometric relationships"
            class="aspect-[16/10] w-full object-cover"
            width="1200"
            height="750"
            loading="lazy"
            decoding="async"
          />
        </figure>
      </div>

      <div class="max-w-3xl">
        <h2
          class="text-3xl font-semibold leading-tight tracking-tight text-gray-900 dark:text-white sm:text-4xl"
        >
          My perspective has been shaped by many different environments.
        </h2>

        <div
          class="mt-8 space-y-5 text-lg leading-8 text-gray-600 dark:text-gray-300"
        >
          <p>
            I spent more than two decades working in operations and people
            leadership. Today my work also includes websites, AI,
            accessibility, nonprofit organizations, and independent creative
            projects.
          </p>

          <p>
            Across those experiences, I have become increasingly interested in
            how thoughtful decisions and well-designed systems help people
            participate more fully, contribute more effectively, and pursue
            what matters most to them.
          </p>
        </div>

        <a
          href="/about/"
          class="mt-8 inline-flex items-center font-medium text-blue-600 transition-colors hover:text-blue-700 dark:text-blue-400 dark:hover:text-blue-300"
        >
          Learn more about me
          <span class="ml-2" aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Invitation -->
  <section
    class="border-t border-gray-200 bg-gray-50 dark:border-gray-800 dark:bg-gray-950"
  >
    <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 lg:px-8 lg:py-28">
      <div
        class="rounded-3xl border border-gray-200 bg-white px-6 py-14 dark:border-gray-800 dark:bg-gray-900 sm:px-10 lg:px-14 lg:py-20"
      >
        <div class="max-w-4xl">
          <p
            class="text-sm font-semibold uppercase tracking-[0.18em] text-blue-600 dark:text-blue-400"
          >
            Continue exploring
          </p>

          <h2
            class="mt-5 text-4xl font-bold tracking-tight text-gray-900 dark:text-white sm:text-5xl"
          >
            Follow an idea. Visit a project. Start a conversation.
          </h2>

          <div
            class="mt-6 max-w-3xl space-y-4 text-lg leading-8 text-gray-600 dark:text-gray-300"
          >
            <p>
              Whether you are exploring technology, building an organization,
              creating something new, or simply thinking through an important
              question, I hope you find something here that is useful.
            </p>

            <p>
              If an idea resonates, I would be glad to continue the
              conversation.
            </p>
          </div>

          <div class="mt-9 flex flex-wrap gap-4">
            <a
              href="/projects/"
              class="inline-flex items-center rounded-lg bg-blue-600 px-6 py-3 font-medium text-white transition-colors hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 dark:focus:ring-offset-gray-900"
            >
              Explore the projects
              <span class="ml-2" aria-hidden="true">→</span>
            </a>

            <a
              href="/contact/"
              class="inline-flex items-center rounded-lg border border-gray-300 bg-white px-6 py-3 font-medium text-gray-800 transition-colors hover:border-blue-500 hover:text-blue-600 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 dark:border-gray-700 dark:bg-gray-900 dark:text-gray-200 dark:hover:border-blue-400 dark:hover:text-blue-400 dark:focus:ring-offset-gray-900"
            >
              Start a conversation
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>


<style>
  @keyframes spin-slow {
    from {
      transform: rotate(0deg);
    }

    to {
      transform: rotate(360deg);
    }
  }

  .animate-spin-slow {
    animation: spin-slow 140s linear infinite;
  }

  @media (prefers-reduced-motion: reduce) {
    .animate-spin-slow {
      animation: none;
    }
  }
</style>
