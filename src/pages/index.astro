---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE_NAME, OG_IMAGE } from "../lib/constants";

const areas = [
  {
    title: "Technology & AI",
    description:
      "Using powerful tools in ways that strengthen judgment, creativity, learning, and human connection.",
  },
  {
    title: "Health & Daily Life",
    description:
      "How habits, relationships, movement, rest, and everyday choices compound into a better life.",
  },
  {
    title: "Organizations",
    description:
      "Creating the conditions for people to work together effectively, contribute meaningfully, and pursue shared goals.",
  },
  {
    title: "Accessibility",
    description:
      "Designing experiences and environments that enable more people to participate fully and independently.",
  },
  {
    title: "Creativity",
    description:
      "Making things, following ideas, and giving imagination a form that can be shared with others.",
  },
  {
    title: "Communities & Places",
    description:
      "How cities, public spaces, gardens, transportation, and local relationships shape the way people live.",
  },
];

const projects = [
  {
    title: "Mandalafy",
    description:
      "A creative project shaped by symmetry, color, attention, play, and the pleasure of encountering a compelling pattern.",
    href: "/projects/mandalafy/",
    theme: "Art and creativity",
  },
  {
    title: "LandingBio",
    description:
      "A different way for people to create a thoughtful, personal, and intentional presence on the web.",
    href: "/projects/landingbio/",
    theme: "Identity and connection",
  },
  {
    title: "ImagineThis.Site",
    description:
      "Ideas, examples, and practical resources for imagining and building websites that better reflect their purpose.",
    href: "/projects/imaginethis-site/",
    theme: "Websites and possibility",
  },
];

const currentQuestions = [
  "What kinds of environments help people and meaningful work flourish?",
  "How can AI strengthen our thinking without doing all of our thinking for us?",
  "What makes an organization effective, humane, and capable of pursuing its purpose?",
  "How do our habits and surroundings influence the lives we gradually build?",
  "What helps more people participate fully in our workplaces, communities, and shared spaces?",
  "How can we contribute to the internet without overwhelming it with disposable content?",
];

const pageTitle = `${SITE_NAME} | Exploring how we shape better lives`;

const pageDescription =
  "Ideas, projects, and conversations about technology, health, organizations, accessibility, creativity, and the environments we shape together.";
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  ogTitle={pageTitle}
  ogDescription={pageDescription}
  ogImage={OG_IMAGE}
>
  <!-- Hero -->
  <section
    class="relative overflow-hidden border-b border-gray-200 bg-white dark:border-gray-800 dark:bg-gray-900"
  >
    <div class="pointer-events-none absolute inset-0" aria-hidden="true">
      <div
        class="absolute -right-32 top-8 h-96 w-96 rounded-full bg-blue-100/70 blur-3xl dark:bg-blue-900/20"
      >
      </div>

      <div
        class="absolute -left-32 bottom-0 h-80 w-80 rounded-full bg-indigo-100/60 blur-3xl dark:bg-indigo-900/20"
      >
      </div>
    </div>

    <div
      class="relative mx-auto max-w-6xl px-4 py-20 sm:px-6 sm:py-28 lg:px-8 lg:py-32"
    >
      <div
        class="grid items-center gap-14 lg:grid-cols-[minmax(0,1.5fr)_minmax(240px,0.5fr)] lg:gap-16"
      >
        <div class="max-w-4xl">
          <p
            class="mb-6 text-sm font-semibold uppercase tracking-[0.18em] text-blue-600 dark:text-blue-400"
          >
            Dan Ryan Neff
          </p>

          <h1
            class="text-5xl font-bold leading-[1.02] tracking-tight text-gray-900 dark:text-white sm:text-6xl lg:text-7xl"
          >
            Exploring how we shape better lives.
          </h1>

          <div
            class="mt-8 max-w-3xl space-y-5 text-lg leading-8 text-gray-600 dark:text-gray-300 sm:text-xl"
          >
            <p>
              Technology, health, organizations, creativity, accessibility,
              cities, and community all influence what people are able to do
              and the lives we are able to build.
            </p>

            <p>
              This website brings together projects, ideas, resources, and
              conversations inspired by those connections.
            </p>

            <p>
              I hope you find something useful, something beautiful, or a new
              way of seeing what is possible.
            </p>
          </div>

          <div class="mt-10 flex flex-wrap gap-4">
            <a
              href="#explore"
              class="inline-flex items-center rounded-lg bg-blue-600 px-6 py-3 font-medium text-white transition-colors hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 dark:focus:ring-offset-gray-900"
            >
              Begin exploring
              <span class="ml-2" aria-hidden="true">↓</span>
            </a>

            <a
              href="/projects/"
              class="inline-flex items-center rounded-lg border border-gray-300 bg-white px-6 py-3 font-medium text-gray-800 transition-colors hover:border-blue-500 hover:text-blue-600 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 dark:border-gray-700 dark:bg-gray-900 dark:text-gray-200 dark:hover:border-blue-400 dark:hover:text-blue-400 dark:focus:ring-offset-gray-900"
            >
              View projects
            </a>
          </div>
        </div>

        <figure
          class="mx-auto w-full max-w-xs lg:mx-0 lg:max-w-none lg:justify-self-end"
        >
          <div
            class="relative overflow-hidden rounded-[2rem] border border-gray-200 bg-gray-100 shadow-lg shadow-gray-200/60 dark:border-gray-700 dark:bg-gray-800 dark:shadow-black/20"
          >
            <img
              src="/images/dan-ryan-neff.webp"
              alt="Dan Ryan Neff outdoors"
              class="aspect-[4/5] w-full object-cover object-center"
              width="640"
              height="800"
              loading="eager"
              decoding="async"
              fetchpriority="high"
            />
          </div>
        </figure>
      </div>
    </div>
  </section>

  <!-- Orientation -->
  <section id="explore" class="scroll-mt-24 bg-white dark:bg-gray-900">
    <div
      class="mx-auto grid max-w-6xl gap-8 px-4 py-20 sm:px-6 lg:grid-cols-[0.42fr_1fr] lg:px-8 lg:py-28"
    >
      <div>
        <p
          class="text-sm font-semibold uppercase tracking-[0.18em] text-blue-600 dark:text-blue-400"
        >
          A place to explore
        </p>
      </div>

      <div class="max-w-3xl">
        <h2
          class="text-3xl font-semibold leading-tight tracking-tight text-gray-900 dark:text-white sm:text-4xl"
        >
          Better lives are shaped by more than one decision, tool, or idea.
        </h2>

        <div
          class="mt-8 space-y-6 text-lg leading-8 text-gray-600 dark:text-gray-300"
        >
          <p>
            They emerge gradually through the habits we practice, the
            relationships we build, the technologies we adopt, the
            organizations we create, and the environments we share.
          </p>

          <p>
            I am interested in how these forces interact—and in the thoughtful,
            practical choices that can help people, communities, and meaningful
            work flourish.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Areas of interest -->
  <section
    class="border-y border-gray-200 bg-gray-50 dark:border-gray-800 dark:bg-gray-950"
  >
    <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 lg:px-8 lg:py-28">
      <div class="max-w-3xl">
        <p
          class="text-sm font-semibold uppercase tracking-[0.18em] text-blue-600 dark:text-blue-400"
        >
          Areas of interest
        </p>

        <h2
          class="mt-5 text-4xl font-bold tracking-tight text-gray-900 dark:text-white sm:text-5xl"
        >
          Different parts of one connected world.
        </h2>

        <p class="mt-6 text-lg leading-8 text-gray-600 dark:text-gray-300">
          These are some of the places where my attention tends to go. The
          boundaries between them are often less distinct than they first
          appear.
        </p>
      </div>

      <div class="mt-14 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {
          areas.map((area, index) => (
            <article class="rounded-2xl border border-gray-200 bg-white p-7 dark:border-gray-800 dark:bg-gray-900 sm:p-8">
              <div class="flex items-start gap-4">
                <span class="pt-1 font-mono text-xs text-gray-400 dark:text-gray-500">
                  {String(index + 1).padStart(2, "0")}
                </span>

                <div>
                  <h3 class="text-xl font-bold text-gray-900 dark:text-white">
                    {area.title}
                  </h3>

                  <p class="mt-4 leading-7 text-gray-600 dark:text-gray-300">
                    {area.description}
                  </p>
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Projects -->
  <section class="bg-white dark:bg-gray-900">
    <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 lg:px-8 lg:py-28">
      <div
        class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between"
      >
        <div class="max-w-3xl">
          <p
            class="text-sm font-semibold uppercase tracking-[0.18em] text-blue-600 dark:text-blue-400"
          >
            Selected projects
          </p>

          <h2
            class="mt-5 text-4xl font-bold tracking-tight text-gray-900 dark:text-white sm:text-5xl"
          >
            Some ideas become things you can visit.
          </h2>

          <p class="mt-6 text-lg leading-8 text-gray-600 dark:text-gray-300">
            These projects began in different ways, but each grew from
            something I wanted to make, understand, or contribute to the world.
          </p>
        </div>

        <a
          href="/projects/"
          class="font-medium text-blue-600 transition-colors hover:text-blue-700 dark:text-blue-400 dark:hover:text-blue-300"
        >
          View all projects
          <span class="ml-1" aria-hidden="true">→</span>
        </a>
      </div>

      <div class="mt-14 grid gap-6 lg:grid-cols-3">
        {
          projects.map((project) => (
            <a
              href={project.href}
              class="group flex min-h-80 flex-col justify-between rounded-2xl border border-gray-200 bg-gray-50 p-8 transition-all hover:-translate-y-1 hover:border-blue-300 hover:shadow-lg dark:border-gray-800 dark:bg-gray-950 dark:hover:border-blue-700"
            >
              <div>
                <p class="text-xs font-semibold uppercase tracking-[0.16em] text-blue-600 dark:text-blue-400">
                  {project.theme}
                </p>

                <h3 class="mt-5 text-3xl font-bold tracking-tight text-gray-900 dark:text-white">
                  {project.title}
                </h3>

                <p class="mt-5 leading-7 text-gray-600 dark:text-gray-300">
                  {project.description}
                </p>
              </div>

              <span class="mt-10 font-medium text-gray-900 dark:text-white">
                Explore project
                <span
                  class="ml-2 inline-block transition-transform group-hover:translate-x-1"
                  aria-hidden="true"
                >
                  →
                </span>
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Current questions -->
  <section class="bg-gray-900 text-white dark:bg-black">
    <div
      class="mx-auto grid max-w-6xl gap-12 px-4 py-20 sm:px-6 lg:grid-cols-[0.62fr_1fr] lg:px-8 lg:py-28"
    >
      <div>
        <p
          class="text-sm font-semibold uppercase tracking-[0.18em] text-blue-400"
        >
          Questions on my mind
        </p>

        <h2 class="mt-5 text-4xl font-bold tracking-tight sm:text-5xl">
          Curiosity is often a good place to begin.
        </h2>

        <p class="mt-6 max-w-xl text-lg leading-8 text-gray-300">
          These questions influence what I notice, what I make, and the
          conversations I find worthwhile.
        </p>
      </div>

      <ol class="border-t border-gray-700">
        {
          currentQuestions.map((question, index) => (
            <li class="grid grid-cols-[2rem_1fr] gap-4 border-b border-gray-700 py-6 sm:grid-cols-[3rem_1fr]">
              <span class="pt-1 font-mono text-xs text-gray-500">
                {String(index + 1).padStart(2, "0")}
              </span>

              <p class="text-xl leading-8 text-gray-200 sm:text-2xl">
                {question}
              </p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- About -->
  <section class="bg-white dark:bg-gray-900">
    <div
      class="mx-auto grid max-w-6xl gap-10 px-4 py-20 sm:px-6 lg:grid-cols-[0.45fr_1fr] lg:px-8 lg:py-28"
    >
      <div>
        <p
          class="text-sm font-semibold uppercase tracking-[0.18em] text-blue-600 dark:text-blue-400"
        >
          About Dan
        </p>
      </div>

      <div class="max-w-3xl">
        <h2
          class="text-3xl font-semibold leading-tight tracking-tight text-gray-900 dark:text-white sm:text-4xl"
        >
          My perspective has been shaped by work, curiosity, and experience
          across many different environments.
        </h2>

        <div
          class="mt-8 space-y-5 text-lg leading-8 text-gray-600 dark:text-gray-300"
        >
          <p>
            I spent more than two decades working in operations and people
            leadership. My work now also includes websites, AI, accessibility,
            nonprofit organizations, and independent creative projects.
          </p>

          <p>
            Across those experiences, I have become increasingly interested in
            how thoughtful decisions and well-designed systems can make people
            more able to participate, contribute, and pursue what matters to
            them.
          </p>
        </div>

        <a
          href="/about/"
          class="mt-8 inline-flex items-center font-medium text-blue-600 transition-colors hover:text-blue-700 dark:text-blue-400 dark:hover:text-blue-300"
        >
          Learn more about me
          <span class="ml-2" aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Invitation -->
  <section
    class="border-t border-gray-200 bg-gray-50 dark:border-gray-800 dark:bg-gray-950"
  >
    <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 lg:px-8 lg:py-28">
      <div
        class="rounded-3xl border border-gray-200 bg-white px-6 py-14 dark:border-gray-800 dark:bg-gray-900 sm:px-10 lg:px-14 lg:py-20"
      >
        <div class="max-w-4xl">
          <p
            class="text-sm font-semibold uppercase tracking-[0.18em] text-blue-600 dark:text-blue-400"
          >
            Continue exploring
          </p>

          <h2
            class="mt-5 text-4xl font-bold tracking-tight text-gray-900 dark:text-white sm:text-5xl"
          >
            Follow an idea. Visit a project. Start a conversation.
          </h2>

          <p
            class="mt-6 max-w-3xl text-lg leading-8 text-gray-600 dark:text-gray-300"
          >
            Something here may connect with a question you are considering, a
            project you are building, or work that matters to you. I welcome
            thoughtful conversations and opportunities to create something
            useful together.
          </p>

          <div class="mt-9 flex flex-wrap gap-4">
            <a
              href="/projects/"
              class="inline-flex items-center rounded-lg bg-blue-600 px-6 py-3 font-medium text-white transition-colors hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 dark:focus:ring-offset-gray-900"
            >
              Explore the projects
              <span class="ml-2" aria-hidden="true">→</span>
            </a>

            <a
              href="/contact/"
              class="inline-flex items-center rounded-lg border border-gray-300 bg-white px-6 py-3 font-medium text-gray-800 transition-colors hover:border-blue-500 hover:text-blue-600 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 dark:border-gray-700 dark:bg-gray-900 dark:text-gray-200 dark:hover:border-blue-400 dark:hover:text-blue-400 dark:focus:ring-offset-gray-900"
            >
              Start a conversation
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>