---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE_NAME, OG_IMAGE } from "../lib/constants";

// To feature another project later, add another object here.
const projects = [
  {
    title: "Mandalafy",
    description: "A playful exploration of mandalas, color, symmetry, and making something your own.",
    href: "/mandalafy/",
    image: "/images/mandala-woven-sunlight-660.webp",
    imageAlt: "Colorful geometric mandala with intricate radial patterns",
    imageClass: "object-contain p-5",
  },
  {
    title: "LandingBio",
    description: "A more personal and intentional way to make a home for yourself on the web.",
    href: "/landingbio/",
    image: "/images/landingbio-hero-personal-entry-page-v1.webp",
    imageAlt: "Personal webpage concept against a starry background",
    imageClass: "object-contain p-4",
  },
  {
    title: "ImagineThis.Site",
    description: "Website ideas, experiments, and practical inspiration for bringing possibilities to life.",
    href: "/imaginethis-site/",
    image: "/images/DOT_artist_with_ideas.webp",
    imageAlt: "Illustration of an artist surrounded by connected ideas",
    imageClass: "object-contain p-4",
  },
];

const pageTitle = `${SITE_NAME} | Practical help, creative projects, and new possibilities`;
const pageDescription =
  "Meet Dan Ryan Neff: daily money management, executive and administrative experience, creative projects, and practical explorations of technology and AI. Based in Madison, Wisconsin.";
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  ogTitle={pageTitle}
  ogDescription={pageDescription}
  ogImage={OG_IMAGE}
>
  <!-- Short introduction: who Dan is and where to go next. -->
  <section
    class="relative overflow-hidden border-b border-gray-200 bg-white dark:border-gray-800 dark:bg-gray-900"
    aria-labelledby="home-heading"
  >
    <div class="pointer-events-none absolute inset-0" aria-hidden="true">
      <div class="absolute -right-24 top-0 h-80 w-80 rounded-full bg-blue-100/70 blur-3xl dark:bg-blue-900/20"></div>
      <div class="absolute -left-24 bottom-0 h-64 w-64 rounded-full bg-indigo-100/60 blur-3xl dark:bg-indigo-900/20"></div>
    </div>
    <div class="relative mx-auto grid max-w-6xl items-center gap-10 px-4 py-14 sm:px-6 sm:py-20 lg:grid-cols-[minmax(0,1.3fr)_minmax(220px,0.65fr)] lg:gap-16 lg:px-8 lg:py-24">
      <div class="max-w-3xl">
        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-blue-700 dark:text-blue-400">
          Dan Ryan Neff · Madison, Wisconsin
        </p>
        <h1
          id="home-heading"
          class="mt-5 text-5xl font-bold leading-[1.04] tracking-tight text-gray-900 dark:text-white sm:text-6xl"
        >
          Hi, I'm Dan.
        </h1>
        <p class="mt-6 max-w-2xl text-xl font-semibold leading-8 text-gray-900 dark:text-gray-100 sm:text-2xl sm:leading-9">
          I help people stay organized, solve practical problems, and move good ideas forward.
        </p>
        <p class="mt-5 max-w-2xl text-lg leading-8 text-gray-700 dark:text-gray-300">
          I'm an executive assistant and daily money manager with a background in operations and coordination. I also make art, build digital projects, and explore how technology and AI can help people and organizations work better.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a
            href="#ways-to-work"
            class="inline-flex min-h-12 items-center justify-center rounded-lg bg-blue-700 px-6 py-3 font-semibold text-white transition-colors hover:bg-blue-800 hover:text-white focus-visible:outline focus-visible:outline-4 focus-visible:outline-offset-2 focus-visible:outline-blue-600 dark:bg-blue-500 dark:text-gray-950 dark:hover:bg-blue-400 dark:hover:text-gray-950"
          >
            How I can help
            <span class="ml-2" aria-hidden="true">↓</span>
          </a>
          <a
            href="/contact/"
            class="inline-flex min-h-12 items-center justify-center rounded-lg border border-gray-300 bg-white px-6 py-3 font-semibold text-gray-900 transition-colors hover:border-blue-500 hover:text-blue-700 focus-visible:outline focus-visible:outline-4 focus-visible:outline-offset-2 focus-visible:outline-blue-600 dark:border-gray-700 dark:bg-gray-900 dark:text-gray-100 dark:hover:border-blue-400 dark:hover:text-blue-300"
          >
            Get in touch
          </a>
        </div>
        <p class="mt-5 text-sm text-gray-600 dark:text-gray-400">
          Want to know more about my background? <a href="/about/" class="font-semibold underline underline-offset-4 hover:text-blue-700 dark:hover:text-blue-300">Read about me</a>.
        </p>
      </div>

      <!-- Retain the site's personal portrait and moving mandala. -->
      <figure class="relative mx-auto w-48 sm:w-60 lg:w-full lg:max-w-[19rem] lg:justify-self-end">
        <div class="pointer-events-none absolute -inset-12 flex items-center justify-center sm:-inset-16" aria-hidden="true">
          <img
            src="/images/mandala-red-fire-maze-660.webp"
            alt=""
            class="h-full w-full max-w-none animate-spin-slow object-contain opacity-45 dark:opacity-50"
            width="660"
            height="660"
            loading="eager"
            decoding="async"
          />
        </div>
        <div class="relative overflow-hidden rounded-[2rem] border border-gray-200 bg-gray-100 shadow-lg shadow-gray-200/60 dark:border-gray-700 dark:bg-gray-800 dark:shadow-black/20">
          <img
            src="/images/dan-ryan-neff.webp"
            alt="Dan Ryan Neff outdoors"
            class="aspect-[4/5] w-full object-cover object-center"
            width="640"
            height="800"
            loading="eager"
            decoding="async"
          />
        </div>
      </figure>
    </div>
  </section>

  <!-- Actual service first; other conversations are welcome without overstating an established offer. -->
  <section
    id="ways-to-work"
    class="scroll-mt-24 border-b border-gray-200 bg-gray-50 dark:border-gray-800 dark:bg-gray-950"
    aria-labelledby="work-heading"
  >
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:px-8 lg:py-20">
      <p class="text-sm font-semibold uppercase tracking-[0.18em] text-blue-700 dark:text-blue-400">Ways to work together</p>
      <h2 id="work-heading" class="mt-3 text-3xl font-bold tracking-tight text-gray-900 dark:text-white sm:text-4xl">
        How I can help
      </h2>
      <p class="mt-4 max-w-2xl text-lg leading-8 text-gray-700 dark:text-gray-300">
        Whether you need dependable assistance or have a project worth discussing, here's a place to start.
      </p>

      <div class="mt-9 grid gap-5 lg:grid-cols-2">
        <article class="flex flex-col rounded-2xl border border-blue-200 bg-white p-7 shadow-sm dark:border-blue-900 dark:bg-gray-900 sm:p-8">
          <div class="mb-5 h-1 w-12 rounded-full bg-blue-600 dark:bg-blue-400" aria-hidden="true"></div>
          <h3 class="text-2xl font-bold text-gray-900 dark:text-white">Daily Money Management</h3>
          <p class="mt-4 flex-1 text-base leading-7 text-gray-700 dark:text-gray-300">
            Help with bills, financial records, paperwork, and everyday financial responsibilities. I work especially with older adults and their families, and welcome inquiries from others who need reliable support.
          </p>
          <a href="/dmm/" class="mt-6 inline-flex w-fit items-center font-semibold text-blue-700 underline-offset-4 hover:underline dark:text-blue-400">
            Learn about this service <span class="ml-2" aria-hidden="true">→</span>
          </a>
        </article>

        <article class="flex flex-col rounded-2xl border border-gray-200 bg-white p-7 shadow-sm dark:border-gray-800 dark:bg-gray-900 sm:p-8">
          <div class="mb-5 h-1 w-12 rounded-full bg-indigo-400 dark:bg-indigo-500" aria-hidden="true"></div>
          <h3 class="text-2xl font-bold text-gray-900 dark:text-white">Operations, administration & technology</h3>
          <p class="mt-4 flex-1 text-base leading-7 text-gray-700 dark:text-gray-300">
            My experience includes executive support, coordination, and improving the way work gets done. I'm also interested in practical AI and digital tools. If you see a possible fit for a project or collaboration, let's talk.
          </p>
          <a href="/contact/" class="mt-6 inline-flex w-fit items-center font-semibold text-blue-700 underline-offset-4 hover:underline dark:text-blue-400">
            Discuss an opportunity <span class="ml-2" aria-hidden="true">→</span>
          </a>
        </article>
      </div>
    </div>
  </section>

  <!-- Keep the creative identity visible without turning the homepage into a project catalog. -->
  <section id="projects" class="scroll-mt-24 bg-white dark:bg-gray-900" aria-labelledby="projects-heading">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:px-8 lg:py-20">
      <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.18em] text-blue-700 dark:text-blue-400">Creative and digital work</p>
          <h2 id="projects-heading" class="mt-3 text-3xl font-bold tracking-tight text-gray-900 dark:text-white sm:text-4xl">
            Things I'm creating
          </h2>
          <p class="mt-4 max-w-2xl text-lg leading-8 text-gray-700 dark:text-gray-300">
            Art, experiments, and tools I'm developing along the way.
          </p>
        </div>
        <a href="/projects/" class="inline-flex shrink-0 items-center font-semibold text-blue-700 underline-offset-4 hover:underline dark:text-blue-400">
          All projects <span class="ml-2" aria-hidden="true">→</span>
        </a>
      </div>

      <div class="mt-9 grid gap-5 md:grid-cols-3">
        {projects.map((project) => (
          <a
            href={project.href}
            class="group overflow-hidden rounded-2xl border border-gray-200 bg-gray-50 transition-all hover:-translate-y-1 hover:border-blue-300 hover:shadow-md focus-visible:outline focus-visible:outline-4 focus-visible:outline-offset-2 focus-visible:outline-blue-600 dark:border-gray-800 dark:bg-gray-950 dark:hover:border-blue-700"
          >
            <div class="border-b border-gray-200 bg-gray-900 dark:border-gray-800">
              <img
                src={project.image}
                alt={project.imageAlt}
                class:list={["aspect-[16/9] w-full", project.imageClass]}
                width="660"
                height="371"
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="p-6">
              <h3 class="text-xl font-bold text-gray-900 dark:text-white">{project.title}</h3>
              <p class="mt-3 text-base leading-7 text-gray-700 dark:text-gray-300">{project.description}</p>
              <span class="mt-5 inline-flex items-center font-semibold text-blue-700 dark:text-blue-400">
                Explore project <span class="ml-2 transition-transform group-hover:translate-x-1" aria-hidden="true">→</span>
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- One direct human invitation, with email and the existing contact page. -->
  <section class="border-t border-gray-200 bg-gray-50 dark:border-gray-800 dark:bg-gray-950" aria-labelledby="connect-heading">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:px-8 lg:py-20">
      <div class="rounded-3xl border border-gray-200 bg-white px-6 py-10 dark:border-gray-800 dark:bg-gray-900 sm:px-10 sm:py-12">
        <div class="max-w-3xl">
          <p class="text-sm font-semibold uppercase tracking-[0.18em] text-blue-700 dark:text-blue-400">Let's connect</p>
          <h2 id="connect-heading" class="mt-3 text-3xl font-bold tracking-tight text-gray-900 dark:text-white sm:text-4xl">
            Have something in mind?
          </h2>
          <p class="mt-4 text-lg leading-8 text-gray-700 dark:text-gray-300">
            If you're looking for help, considering a collaboration, or curious about a project, I'd be glad to hear from you.
          </p>
          <div class="mt-7 flex flex-wrap items-center gap-x-6 gap-y-4">
            <a
              href="mailto:danryanneff@gmail.com"
              class="inline-flex min-h-12 items-center justify-center rounded-lg bg-blue-700 px-6 py-3 font-semibold text-white transition-colors hover:bg-blue-800 hover:text-white focus-visible:outline focus-visible:outline-4 focus-visible:outline-offset-2 focus-visible:outline-blue-600 dark:bg-blue-500 dark:text-gray-950 dark:hover:bg-blue-400 dark:hover:text-gray-950"
            >
              Email me
            </a>
            <a href="/contact/" class="font-semibold text-blue-700 underline-offset-4 hover:underline dark:text-blue-400">
              Other ways to get in touch <span class="ml-1" aria-hidden="true">→</span>
            </a>
          </div>
          <p class="mt-4 text-sm text-gray-600 dark:text-gray-400">danryanneff@gmail.com</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<!-- Restore the slow mandala rotation from the original homepage. -->
<style>
  @keyframes spin-slow {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  .animate-spin-slow {
    animation: spin-slow 140s linear infinite;
  }

  @media (prefers-reduced-motion: reduce) {
    .animate-spin-slow {
      animation: none;
    }
  }
</style>
