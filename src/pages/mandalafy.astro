---
import BaseLayout from "../layouts/BaseLayout.astro";
import { seoMetadata } from "../lib/constants";

const pageMetadata = seoMetadata["/mandalafy/"];
---

<BaseLayout
  title={pageMetadata.title}
  description={pageMetadata.description}
>
  <!-- Clear introduction and a direct path to the live project -->
  <section class="relative overflow-hidden border-b border-gray-200 bg-white dark:border-gray-800 dark:bg-gray-900">
    <div class="pointer-events-none absolute inset-0" aria-hidden="true">
      <div class="absolute -right-24 top-0 h-72 w-72 rounded-full bg-amber-100/60 blur-3xl dark:bg-amber-900/20"></div>
      <div class="absolute -left-24 bottom-0 h-64 w-64 rounded-full bg-blue-100/60 blur-3xl dark:bg-blue-900/20"></div>
    </div>

    <div class="relative mx-auto grid max-w-6xl items-center gap-10 px-4 py-14 sm:px-6 sm:py-20 lg:grid-cols-2 lg:gap-16 lg:px-8 lg:py-24">
      <div class="max-w-2xl">
        <p class="text-sm font-semibold uppercase tracking-[0.16em] text-blue-600 dark:text-blue-400">
          Creative project
        </p>
        <h1 class="mt-4 text-4xl font-bold tracking-tight text-gray-900 dark:text-white sm:text-5xl lg:text-6xl">
          Mandalafy
        </h1>
        <p class="mt-5 text-2xl font-medium leading-snug text-gray-900 dark:text-white sm:text-3xl">
          Make a mandala. See where it goes.
        </p>
        <p class="mt-5 max-w-xl text-lg leading-8 text-gray-600 dark:text-gray-300">
          Mandalafy is a free, hands-on mandala maker. Draw, explore color and symmetry, and watch your choices become a design of your own. You can download your artwork or try it on a product if you like.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a
            href="https://mandalafy.com/"
            target="_blank"
            rel="noopener noreferrer"
            class="mandalafy-action mandalafy-action--primary inline-flex items-center justify-center rounded-lg bg-blue-600 px-5 py-3 font-semibold text-white hover:bg-blue-700 hover:text-white focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 dark:focus:ring-offset-gray-900"
          >
            Try Mandalafy <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M7 17 17 7M8 7h9v9" /></svg>
          </a>
          <a
            href="https://mandalafy.com/mandala-designs/"
            target="_blank"
            rel="noopener noreferrer"
            class="mandalafy-action mandalafy-action--secondary inline-flex items-center justify-center rounded-lg border border-gray-300 px-5 py-3 font-medium text-gray-900 hover:bg-gray-100 dark:border-gray-700 dark:text-white dark:hover:bg-gray-800"
          >
            Browse designs <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M7 17 17 7M8 7h9v9" /></svg>
          </a>
        </div>
      </div>

      <figure class="mx-auto w-full max-w-sm rounded-3xl border border-gray-200 bg-gray-50 p-5 shadow-sm dark:border-gray-800 dark:bg-gray-950 sm:p-7">
        <img
          src="/images/mandala-woven-sunlight-660.webp"
          alt="An intricate mandala with golden color and layered geometric patterns"
          width="660"
          height="660"
          loading="eager"
          decoding="async"
          class="mx-auto block aspect-square h-auto w-full max-w-[340px] object-contain"
        />
        <figcaption class="mt-3 text-center text-sm text-gray-500 dark:text-gray-400">
          One of the designs in the Mandalafy collection
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- Show visitors what they can actually do -->
  <section class="bg-gray-50 py-14 dark:bg-gray-950 sm:py-20">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl">
        <h2 class="text-3xl font-bold tracking-tight text-gray-900 dark:text-white sm:text-4xl">
          Three ways to explore
        </h2>
        <p class="mt-4 text-lg leading-8 text-gray-600 dark:text-gray-300">
          Start wherever you like. Making something is free; buying a product is optional.
        </p>
      </div>

      <div class="mt-8 grid gap-5 md:grid-cols-3">
        <article class="flex flex-col rounded-2xl border border-gray-200 bg-white p-6 dark:border-gray-800 dark:bg-gray-900">
          <h3 class="text-xl font-bold text-gray-900 dark:text-white">Create your own</h3>
          <p class="mt-3 flex-1 leading-7 text-gray-600 dark:text-gray-300">
            Draw on a digital canvas and see each gesture repeated through symmetry.
          </p>
          <a class="mt-5 font-semibold" href="https://mandalafy.com/" target="_blank" rel="noopener noreferrer">
            Open the maker <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M7 17 17 7M8 7h9v9" /></svg>
          </a>
        </article>

        <article class="flex flex-col rounded-2xl border border-gray-200 bg-white p-6 dark:border-gray-800 dark:bg-gray-900">
          <h3 class="text-xl font-bold text-gray-900 dark:text-white">Find a design you like</h3>
          <p class="mt-3 flex-1 leading-7 text-gray-600 dark:text-gray-300">
            Explore existing mandalas if you'd rather begin with something already made.
          </p>
          <a class="mt-5 font-semibold" href="https://mandalafy.com/mandala-designs/" target="_blank" rel="noopener noreferrer">
            View the gallery <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M7 17 17 7M8 7h9v9" /></svg>
          </a>
        </article>

        <article class="flex flex-col rounded-2xl border border-gray-200 bg-white p-6 dark:border-gray-800 dark:bg-gray-900">
          <h3 class="text-xl font-bold text-gray-900 dark:text-white">Take it beyond the screen</h3>
          <p class="mt-3 flex-1 leading-7 text-gray-600 dark:text-gray-300">
            See how a mandala can look on a shirt, tote, or other product.
          </p>
          <a class="mt-5 font-semibold" href="https://mandalafy.com/" target="_blank" rel="noopener noreferrer">
            Explore products <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M7 17 17 7M8 7h9v9" /></svg>
          </a>
        </article>
      </div>
    </div>
  </section>

  <!-- Personal context, brief rather than a long essay -->
  <section class="border-t border-gray-200 bg-white py-14 dark:border-gray-800 dark:bg-gray-900 sm:py-20">
    <div class="mx-auto grid max-w-6xl items-center gap-8 px-4 sm:px-6 lg:grid-cols-[minmax(0,1fr)_minmax(0,0.7fr)] lg:gap-12 lg:px-8">
      <div class="max-w-2xl">
        <p class="text-sm font-semibold uppercase tracking-[0.16em] text-blue-600 dark:text-blue-400">Why I'm making it</p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight text-gray-900 dark:text-white sm:text-4xl">
          A tool that leaves room for you.
        </h2>
        <p class="mt-5 text-lg leading-8 text-gray-600 dark:text-gray-300">
          I like creative technology that invites participation instead of doing everything for us. Mandalafy supplies symmetry and an easy starting point, while the choices remain yours. I'm continuing to experiment with the experience and what people can do with their designs.
        </p>
      </div>
      <div class="mx-auto w-full max-w-xs rounded-2xl border border-gray-200 bg-gray-50 p-5 dark:border-gray-800 dark:bg-gray-950">
        <img
          src="/images/mandala2.webp"
          alt="A colorful radial mandala"
          width="900"
          height="900"
          loading="lazy"
          decoding="async"
          class="mx-auto block h-auto w-full max-w-[260px] object-contain"
        />
      </div>
    </div>
  </section>

  <!-- Simple invitation to participate or make contact -->
  <section class="border-t border-gray-200 bg-gray-50 py-14 dark:border-gray-800 dark:bg-gray-950 sm:py-16">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <div class="rounded-2xl border border-gray-200 bg-white p-7 dark:border-gray-800 dark:bg-gray-900 sm:p-10">
        <h2 class="text-2xl font-bold text-gray-900 dark:text-white sm:text-3xl">Give it a try—or get in touch.</h2>
        <p class="mt-3 max-w-2xl text-lg leading-8 text-gray-600 dark:text-gray-300">
          Explore the project yourself. If you have feedback, a question, or an idea for something we could make possible, I'd welcome a conversation.
        </p>
        <div class="mt-6 flex flex-wrap gap-4">
          <a class="mandalafy-action mandalafy-action--primary inline-flex items-center rounded-lg bg-blue-600 px-5 py-3 font-semibold text-white hover:bg-blue-700 hover:text-white" href="https://mandalafy.com/" target="_blank" rel="noopener noreferrer">
            Visit Mandalafy <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M7 17 17 7M8 7h9v9" /></svg>
          </a>
          <a class="mandalafy-action mandalafy-action--secondary inline-flex items-center rounded-lg border border-gray-300 px-5 py-3 font-medium text-gray-900 hover:bg-gray-100 dark:border-gray-700 dark:text-white dark:hover:bg-gray-800" href="/contact/">
            Contact me
          </a>
          <a class="inline-flex items-center px-1 py-3 font-medium" href="/projects/">Other projects</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* These rules make the CTAs legible even when site-wide link styling is present. */
  a.mandalafy-action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    min-height: 3.1rem;
    padding: 0.8rem 1.25rem !important;
    border-radius: 0.65rem;
    line-height: 1.25;
    text-decoration: none !important;
    white-space: nowrap;
    transition: background-color 160ms ease, border-color 160ms ease;
  }
  a.mandalafy-action--primary,
  a.mandalafy-action--primary:visited,
  a.mandalafy-action--primary:hover {
    color: #fff !important;
  }
  a.mandalafy-action--primary { background-color: #2563eb; }
  a.mandalafy-action--primary:hover { background-color: #1d4ed8; }
  a.mandalafy-action--secondary,
  a.mandalafy-action--secondary:visited { color: #111827 !important; }
  a.mandalafy-action--secondary:hover { background-color: #f3f4f6; }
  :global(.dark) a.mandalafy-action--secondary,
  :global(.dark) a.mandalafy-action--secondary:visited { color: #fff !important; }
  :global(.dark) a.mandalafy-action--secondary:hover { background-color: #1f2937; }
  a.mandalafy-action:focus-visible {
    outline: 3px solid #60a5fa;
    outline-offset: 3px;
  }
  a.mandalafy-action svg { flex: none; }
  /* Arrow icons in the three informational cards follow the text, not the baseline. */
  article a svg { display: inline-block; vertical-align: middle; margin-left: 0.3rem; }
</style>
