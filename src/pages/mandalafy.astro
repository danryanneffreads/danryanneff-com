---
import BaseLayout from '../layouts/BaseLayout.astro';
import { seoMetadata } from '../lib/constants';

const pageMetadata = seoMetadata['/mandalafy/'];

const dimensions = [
  {
    title: 'Attention',
    description:
      'Creating a mandala requires sustained focus on color, rhythm, balance, and the relationships among individual choices.',
  },
  {
    title: 'Constraint',
    description:
      'Symmetry limits what each mark can do, but those limits also create structure, coherence, and unexpected possibilities.',
  },
  {
    title: 'Expression',
    description:
      'The same tool can produce radically different results because the person making the choices remains central to the work.',
  },
  {
    title: 'Flow',
    description:
      'Repetition and immediate visual feedback can create a quiet, absorbing experience in which attention settles into the act of making.',
  },
];

const principles = [
  'The tool should make creativity more accessible without taking authorship away from the person using it.',
  'Complex systems can support an experience that feels simple, intuitive, and playful.',
  'Constraints do not merely restrict creativity. They can give it shape.',
  'Technology can create room for reflection and concentration, not only speed and productivity.',
];
---

<BaseLayout
  title={pageMetadata.title}
  description={pageMetadata.description}
>
  <!-- Hero -->
  <section
    class="relative overflow-hidden border-b border-gray-200 bg-white dark:border-gray-800 dark:bg-gray-900"
  >
    <div
      class="pointer-events-none absolute inset-0"
      aria-hidden="true"
    >
      <div
        class="absolute -right-24 top-4 h-96 w-96 rounded-full bg-fuchsia-100/70 blur-3xl dark:bg-fuchsia-900/20"
      >
      </div>

      <div
        class="absolute -left-24 bottom-0 h-80 w-80 rounded-full bg-amber-100/60 blur-3xl dark:bg-amber-900/20"
      >
      </div>
    </div>

    <div
      class="relative mx-auto grid max-w-6xl items-center gap-12 px-4 py-20 sm:px-6 sm:py-28 lg:grid-cols-[1fr_0.86fr] lg:gap-20 lg:px-8 lg:py-32"
    >
      <div class="max-w-3xl">
        <p
          class="text-sm font-semibold uppercase tracking-[0.18em] text-blue-600 dark:text-blue-400"
        >
          Creativity and attention
        </p>

        <h1
          class="mt-6 text-5xl font-bold leading-[1.04] tracking-tight text-gray-900 dark:text-white sm:text-6xl lg:text-7xl"
        >
          Mandalafy
        </h1>

        <p
          class="mt-7 max-w-2xl text-2xl leading-9 text-gray-700 dark:text-gray-300"
        >
          A digital environment for exploring symmetry, color, pattern, and
          the experience of making.
        </p>

        <p
          class="mt-6 max-w-2xl text-lg leading-8 text-gray-600 dark:text-gray-300"
        >
          Mandalafy began as a creative experiment. It has become an ongoing
          exploration of how technology can support concentration, expression,
          play, and human authorship.
        </p>

        <div class="mt-9 flex flex-wrap gap-4">
          <a
            href="https://mandalafy.com/"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center rounded-lg bg-blue-600 px-6 py-3 font-medium text-white transition-colors hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 dark:focus:ring-offset-gray-900"
          >
            Explore Mandalafy
            <span class="ml-2" aria-hidden="true">↗</span>
          </a>

          <a
            href="/projects/"
            class="inline-flex items-center rounded-lg border border-gray-300 px-6 py-3 font-medium text-gray-900 transition-colors hover:bg-gray-100 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 dark:border-gray-700 dark:text-white dark:hover:bg-gray-800 dark:focus:ring-offset-gray-900"
          >
            View all projects
          </a>
        </div>
      </div>

      <figure>
        <div
          class="overflow-hidden rounded-[2rem] border border-gray-200 bg-gray-50 p-4 shadow-xl shadow-gray-200/60 dark:border-gray-800 dark:bg-gray-950 dark:shadow-black/20 sm:p-6"
        >
          <img
            src="/images/mandala2.webp"
            alt="A colorful geometric mandala created with Mandalafy"
            class="aspect-square w-full rounded-2xl object-cover"
            width="900"
            height="900"
            loading="eager"
            decoding="async"
          />
        </div>
      </figure>
    </div>
  </section>

  <!-- The idea -->
  <section class="bg-white dark:bg-gray-900">
    <div
      class="mx-auto grid max-w-6xl gap-8 px-4 py-20 sm:px-6 lg:grid-cols-[0.42fr_1fr] lg:px-8 lg:py-28"
    >
      <div>
        <p
          class="text-sm font-semibold uppercase tracking-[0.18em] text-blue-600 dark:text-blue-400"
        >
          The idea
        </p>
      </div>

      <div class="max-w-3xl">
        <h2
          class="text-4xl font-bold tracking-tight text-gray-900 dark:text-white sm:text-5xl"
        >
          A simple tool can open a large creative space.
        </h2>

        <div
          class="mt-8 space-y-5 text-lg leading-8 text-gray-600 dark:text-gray-300"
        >
          <p>
            Mandalafy allows a person to draw within a system of rotational
            symmetry. Each movement is repeated around a shared center,
            transforming an ordinary line or shape into a larger visual
            pattern.
          </p>

          <p>
            The underlying mechanism is consistent, but the outcome is not
            predetermined. Color, placement, rhythm, density, restraint, and
            improvisation remain in the hands of the person creating.
          </p>

          <p>
            That balance is central to the project. The technology provides a
            structure that extends what a person can make, while leaving room
            for judgment, intuition, surprise, and individual expression.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Experience -->
  <section
    class="border-y border-gray-200 bg-gray-50 dark:border-gray-800 dark:bg-gray-950"
  >
    <div
      class="mx-auto max-w-6xl px-4 py-20 sm:px-6 lg:px-8 lg:py-28"
    >
      <div class="max-w-3xl">
        <p
          class="text-sm font-semibold uppercase tracking-[0.18em] text-blue-600 dark:text-blue-400"
        >
          The creative experience
        </p>

        <h2
          class="mt-5 text-4xl font-bold tracking-tight text-gray-900 dark:text-white sm:text-5xl"
        >
          More than producing an image.
        </h2>

        <p
          class="mt-6 text-lg leading-8 text-gray-600 dark:text-gray-300"
        >
          The value of the project is not limited to the completed mandala. It
          also lies in what happens while a person is making it.
        </p>
      </div>

      <div class="mt-14 grid gap-6 md:grid-cols-2">
        {
          dimensions.map((dimension) => (
            <article
              class="rounded-2xl border border-gray-200 bg-white p-7 dark:border-gray-800 dark:bg-gray-900 sm:p-8"
            >
              <h3
                class="text-2xl font-bold text-gray-900 dark:text-white"
              >
                {dimension.title}
              </h3>

              <p
                class="mt-4 leading-7 text-gray-600 dark:text-gray-300"
              >
                {dimension.description}
              </p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Human and tool -->
  <section class="bg-white dark:bg-gray-900">
    <div
      class="mx-auto grid max-w-6xl items-center gap-12 px-4 py-20 sm:px-6 lg:grid-cols-[0.88fr_1.12fr] lg:gap-20 lg:px-8 lg:py-28"
    >
      <figure>
        <div
          class="overflow-hidden rounded-3xl border border-gray-200 bg-gray-50 p-4 dark:border-gray-800 dark:bg-gray-950 sm:p-6"
        >
          <img
            src="/images/mandala-woven-sunlight-660.webp"
            alt="A detailed mandala with layered geometric patterns and warm colors"
            class="aspect-square w-full rounded-2xl object-cover"
            width="660"
            height="660"
            loading="lazy"
            decoding="async"
          />
        </div>
      </figure>

      <div>
        <p
          class="text-sm font-semibold uppercase tracking-[0.18em] text-blue-600 dark:text-blue-400"
        >
          Human and tool
        </p>

        <h2
          class="mt-5 text-4xl font-bold tracking-tight text-gray-900 dark:text-white sm:text-5xl"
        >
          The system contributes structure. The person contributes direction.
        </h2>

        <div
          class="mt-7 space-y-5 text-lg leading-8 text-gray-600 dark:text-gray-300"
        >
          <p>
            Mandalafy does not ask a person to describe an image and wait for a
            finished result. It asks them to participate continuously in the
            development of the work.
          </p>

          <p>
            Every mark changes the emerging composition. Each decision creates
            new possibilities and closes off others. The creator responds to
            what is already present, much as someone might respond to paint,
            clay, sound, or any other medium.
          </p>

          <p>
            The software increases the reach of each gesture, but it does not
            decide what the gesture should be. The work emerges from the
            relationship between the person, the tool, and the evolving image.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Principles -->
  <section class="bg-gray-900 text-white dark:bg-black">
    <div
      class="mx-auto grid max-w-6xl gap-12 px-4 py-20 sm:px-6 lg:grid-cols-[0.62fr_1fr] lg:px-8 lg:py-28"
    >
      <div>
        <p
          class="text-sm font-semibold uppercase tracking-[0.18em] text-blue-400"
        >
          What the project explores
        </p>

        <h2
          class="mt-5 text-4xl font-bold tracking-tight sm:text-5xl"
        >
          A small example of a larger relationship with technology.
        </h2>

        <p class="mt-6 max-w-xl text-lg leading-8 text-gray-300">
          Mandalafy reflects several ideas that also influence how I think
          about digital tools more broadly.
        </p>
      </div>

      <ol class="border-t border-gray-700">
        {
          principles.map((principle, index) => (
            <li
              class="grid grid-cols-[2rem_1fr] gap-4 border-b border-gray-700 py-6 sm:grid-cols-[3rem_1fr]"
            >
              <span class="pt-1 font-mono text-xs text-gray-500">
                {String(index + 1).padStart(2, '0')}
              </span>

              <p class="text-xl leading-8 text-gray-200 sm:text-2xl">
                {principle}
              </p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- From screen to object -->
  <section class="bg-white dark:bg-gray-900">
    <div
      class="mx-auto grid max-w-6xl items-center gap-12 px-4 py-20 sm:px-6 lg:grid-cols-[1fr_0.88fr] lg:gap-20 lg:px-8 lg:py-28"
    >
      <div>
        <p
          class="text-sm font-semibold uppercase tracking-[0.18em] text-blue-600 dark:text-blue-400"
        >
          Beyond the screen
        </p>

        <h2
          class="mt-5 text-4xl font-bold tracking-tight text-gray-900 dark:text-white sm:text-5xl"
        >
          A digital pattern can enter physical life.
        </h2>

        <div
          class="mt-7 space-y-5 text-lg leading-8 text-gray-600 dark:text-gray-300"
        >
          <p>
            Mandalas created digitally can also become objects: prints,
            clothing, notebooks, and other items that carry the pattern into an
            everyday environment.
          </p>

          <p>
            That movement from screen to object changes the relationship to the
            work. A temporary act of digital creation can become something
            visible, tangible, useful, or shared with another person.
          </p>

          <p>
            The project therefore moves among software, visual art, creative
            practice, and physical products rather than belonging entirely to
            any one category.
          </p>
        </div>
      </div>

      <figure>
        <div
          class="rounded-3xl border border-gray-200 bg-gray-50 p-6 dark:border-gray-800 dark:bg-gray-950 sm:p-8"
        >
          <img
            src="/images/SubtleCircles.webp"
            alt="An abstract arrangement of circular forms suggesting pattern and connection"
            class="mx-auto w-full max-w-lg"
            width="1200"
            height="675"
            loading="lazy"
            decoding="async"
          />
        </div>
      </figure>
    </div>
  </section>

  <!-- Ongoing -->
  <section
    class="border-t border-gray-200 bg-gray-50 dark:border-gray-800 dark:bg-gray-950"
  >
    <div
      class="mx-auto max-w-6xl px-4 py-20 sm:px-6 lg:px-8 lg:py-28"
    >
      <div
        class="rounded-3xl border border-gray-200 bg-white px-6 py-14 dark:border-gray-800 dark:bg-gray-900 sm:px-10 lg:px-14 lg:py-20"
      >
        <div class="max-w-4xl">
          <p
            class="text-sm font-semibold uppercase tracking-[0.18em] text-blue-600 dark:text-blue-400"
          >
            An ongoing practice
          </p>

          <h2
            class="mt-5 text-4xl font-bold tracking-tight text-gray-900 dark:text-white sm:text-5xl"
          >
            Mandalafy continues to evolve through use.
          </h2>

          <p
            class="mt-6 max-w-3xl text-lg leading-8 text-gray-600 dark:text-gray-300"
          >
            I continue to create with it, refine the experience, develop new
            designs, and explore how digital systems can invite people into
            active creation rather than passive consumption.
          </p>

          <div class="mt-9 flex flex-wrap gap-4">
            <a
              href="https://mandalafy.com/"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center rounded-lg bg-blue-600 px-6 py-3 font-medium text-white transition-colors hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 dark:focus:ring-offset-gray-900"
            >
              Visit Mandalafy
              <span class="ml-2" aria-hidden="true">↗</span>
            </a>

            <a
              href="/projects/"
              class="inline-flex items-center rounded-lg border border-gray-300 px-6 py-3 font-medium text-gray-900 transition-colors hover:bg-gray-100 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 dark:border-gray-700 dark:text-white dark:hover:bg-gray-800 dark:focus:ring-offset-gray-900"
            >
              Return to projects
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>