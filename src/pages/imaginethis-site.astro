---
import BaseLayout from "../layouts/BaseLayout.astro";

const explorationTypes = [
  {
    title: "Concepts",
    description:
      "Fictional businesses, organizations, places, and experiences developed far enough to reveal how they might work.",
  },
  {
    title: "Practical guides",
    description:
      "Resources for moving from a broad idea toward clearer choices, stronger plans, and better digital decisions.",
  },
  {
    title: "Thought experiments",
    description:
      "Questions that test assumptions, expose tradeoffs, and make room for alternatives that are easy to overlook.",
  },
  {
    title: "Early prototypes",
    description:
      "Initial versions of ideas that may later become websites, projects, tools, or something entirely different.",
  },
];

const explorationAreas = [
  {
    title: "Businesses and organizations",
    description:
      "Concepts for ventures, services, and institutions designed around real human needs.",
  },
  {
    title: "Technology",
    description:
      "Tools and digital systems that expand human capability without replacing human judgment.",
  },
  {
    title: "Communities and places",
    description:
      "Neighborhoods, public spaces, and organizations shaped around the people who use them.",
  },
  {
    title: "Learning and creativity",
    description:
      "Ways curiosity, experimentation, and making can help people develop new abilities.",
  },
  {
    title: "Accessibility",
    description:
      "Experiences shaped by imagining needs, perspectives, and ways of participating different from our own.",
  },
  {
    title: "Everyday life",
    description:
      "Smaller ideas that make ordinary experiences more useful, humane, or enjoyable.",
  },
];
---

<BaseLayout
  title="ImagineThis.Site | Dan Ryan Neff"
  description="ImagineThis.Site is an idea laboratory for exploring concepts, guides, thought experiments, fictional organizations, and possibilities that do not yet exist."
>
  <main>
    <!-- Hero -->
    <section
      class="relative overflow-hidden border-b border-gray-200 bg-white dark:border-gray-800 dark:bg-gray-900"
    >
      <div class="pointer-events-none absolute inset-0" aria-hidden="true">
        <div
          class="absolute -right-24 top-0 h-96 w-96 rounded-full bg-amber-100/70 blur-3xl dark:bg-amber-900/20"
        >
        </div>

        <div
          class="absolute -left-24 bottom-0 h-80 w-80 rounded-full bg-sky-100/60 blur-3xl dark:bg-sky-900/20"
        >
        </div>
      </div>

      <div
        class="relative mx-auto grid max-w-6xl items-center gap-12 px-4 py-20 sm:px-6 sm:py-28 lg:grid-cols-[1.05fr_0.95fr] lg:gap-20 lg:px-8 lg:py-32"
      >
        <div>
          <p
            class="text-sm font-semibold uppercase tracking-[0.18em] text-amber-700 dark:text-amber-400"
          >
            Project
          </p>

          <h1
            class="mt-6 text-5xl font-bold leading-[1.04] tracking-tight text-gray-900 dark:text-white sm:text-6xl lg:text-7xl"
          >
            ImagineThis.Site
          </h1>

          <p
            class="mt-7 max-w-3xl text-2xl leading-9 text-gray-700 dark:text-gray-300"
          >
            Exploring what could exist before it is built.
          </p>

          <p
            class="mt-6 max-w-2xl text-lg leading-8 text-gray-600 dark:text-gray-300"
          >
            ImagineThis.Site is an idea laboratory filled with concepts,
            practical guides, thought experiments, fictional organizations, and
            early explorations of businesses, communities, technology, and
            everyday life.
          </p>

          <div class="mt-9 flex flex-wrap gap-4">
            <a
              href="https://imaginethis.site/"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center rounded-lg bg-amber-600 px-6 py-3 font-medium text-white transition-colors hover:bg-amber-700 focus:outline-none focus:ring-2 focus:ring-amber-500 focus:ring-offset-2 dark:focus:ring-offset-gray-900"
            >
              Visit ImagineThis.Site
              <span class="ml-2" aria-hidden="true">↗</span>
            </a>

            <a
              href="/projects/"
              class="inline-flex items-center rounded-lg border border-gray-300 px-6 py-3 font-medium text-gray-900 transition-colors hover:bg-gray-100 focus:outline-none focus:ring-2 focus:ring-amber-500 focus:ring-offset-2 dark:border-gray-700 dark:text-white dark:hover:bg-gray-800 dark:focus:ring-offset-gray-900"
            >
              View all projects
            </a>
          </div>
        </div>

        <figure class="m-0">
          <img
            src="/images/DOT_artist_with_ideas.webp"
            alt="An artist surrounded by ideas and creative possibilities"
            class="w-full rounded-[2rem] border border-gray-200 shadow-xl shadow-gray-200/60 dark:border-gray-800 dark:shadow-black/20"
            loading="eager"
            decoding="async"
            fetchpriority="high"
          />
        </figure>
      </div>
    </section>

    <!-- What you'll find -->
    <section class="bg-white dark:bg-gray-900">
      <div
        class="mx-auto grid max-w-6xl gap-8 px-4 py-20 sm:px-6 lg:grid-cols-[0.42fr_1fr] lg:px-8 lg:py-28"
      >
        <div>
          <p
            class="text-sm font-semibold uppercase tracking-[0.18em] text-amber-700 dark:text-amber-400"
          >
            What you’ll find
          </p>
        </div>

        <div class="max-w-3xl">
          <h2
            class="text-4xl font-bold tracking-tight text-gray-900 dark:text-white sm:text-5xl"
          >
            Ideas in different stages of becoming.
          </h2>

          <div
            class="mt-8 space-y-5 text-lg leading-8 text-gray-600 dark:text-gray-300"
          >
            <p>
              Some entries begin as fictional concepts: a hotel, a coffee
              company, a health practice, an architecture studio, or a public
              event that does not yet exist.
            </p>

            <p>
              Others are practical guides for planning websites, clarifying
              business needs, or choosing tools with more intention.
            </p>

            <p>
              The project leaves room for both. A concept can help reveal what
              matters before a plan exists, while a guide can help turn a broad
              idea into practical decisions.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Inside the laboratory -->
    <section
      class="border-y border-gray-200 bg-gray-50 dark:border-gray-800 dark:bg-gray-950"
    >
      <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 lg:px-8 lg:py-28">
        <div class="max-w-3xl">
          <p
            class="text-sm font-semibold uppercase tracking-[0.18em] text-amber-700 dark:text-amber-400"
          >
            Inside the laboratory
          </p>

          <h2
            class="mt-5 text-4xl font-bold tracking-tight text-gray-900 dark:text-white sm:text-5xl"
          >
            Different ways to explore what might be possible.
          </h2>
        </div>

        <div class="mt-14 grid gap-6 md:grid-cols-2">
          {
            explorationTypes.map((item) => (
              <article
                class="rounded-2xl border border-gray-200 bg-white p-7 dark:border-gray-800 dark:bg-gray-900 sm:p-8"
              >
                <h3 class="text-2xl font-bold text-gray-900 dark:text-white">
                  {item.title}
                </h3>

                <p class="mt-4 leading-7 text-gray-600 dark:text-gray-300">
                  {item.description}
                </p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Areas of exploration -->
    <section class="bg-white dark:bg-gray-900">
      <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 lg:px-8 lg:py-28">
        <div class="max-w-3xl">
          <p
            class="text-sm font-semibold uppercase tracking-[0.18em] text-amber-700 dark:text-amber-400"
          >
            Areas of exploration
          </p>

          <h2
            class="mt-5 text-4xl font-bold tracking-tight text-gray-900 dark:text-white sm:text-5xl"
          >
            Ideas for how people might live, work, create, and participate.
          </h2>

          <p class="mt-6 text-lg leading-8 text-gray-600 dark:text-gray-300">
            The subjects vary, but the underlying questions are often similar:
            What do people need? What could work differently? What would make an
            experience more useful, accessible, or humane?
          </p>
        </div>

        <div class="mt-14 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {
            explorationAreas.map((area) => (
              <article
                class="rounded-2xl border border-gray-200 p-7 dark:border-gray-800 sm:p-8"
              >
                <h3 class="text-xl font-bold text-gray-900 dark:text-white">
                  {area.title}
                </h3>

                <p class="mt-4 leading-7 text-gray-600 dark:text-gray-300">
                  {area.description}
                </p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Why imagine -->
    <section
      class="border-y border-gray-200 bg-gray-50 dark:border-gray-800 dark:bg-gray-950"
    >
      <div
        class="mx-auto grid max-w-6xl items-center gap-12 px-4 py-20 sm:px-6 lg:grid-cols-[0.9fr_1.1fr] lg:gap-20 lg:px-8 lg:py-28"
      >
        <div
          class="rounded-3xl border border-gray-200 bg-gradient-to-br from-amber-50 via-white to-sky-50 p-8 dark:border-gray-800 dark:from-gray-950 dark:via-gray-900 dark:to-sky-950/30 sm:p-10"
        >
          <p
            class="text-sm font-semibold uppercase tracking-[0.18em] text-amber-700 dark:text-amber-400"
          >
            Why imagine?
          </p>

          <p
            class="mt-6 text-3xl font-bold leading-tight tracking-tight text-gray-900 dark:text-white sm:text-4xl"
          >
            Better questions often come before better answers.
          </p>
        </div>

        <div>
          <h2
            class="text-4xl font-bold tracking-tight text-gray-900 dark:text-white sm:text-5xl"
          >
            Imagination is one way we examine reality more closely.
          </h2>

          <div
            class="mt-7 space-y-5 text-lg leading-8 text-gray-600 dark:text-gray-300"
          >
            <p>
              Not every idea on ImagineThis.Site is intended to become a
              business, product, organization, or finished project.
            </p>

            <p>
              Imagining an alternative can still clarify values, reveal hidden
              assumptions, expose tradeoffs, and make opportunities easier to
              see.
            </p>

            <p>
              Even an idea that remains fictional can strengthen the judgment
              used to build something real.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Ideas do not need to become products -->
    <section class="bg-white dark:bg-gray-900">
      <div
        class="mx-auto grid max-w-6xl gap-8 px-4 py-20 sm:px-6 lg:grid-cols-[0.42fr_1fr] lg:px-8 lg:py-28"
      >
        <div>
          <p
            class="text-sm font-semibold uppercase tracking-[0.18em] text-amber-700 dark:text-amber-400"
          >
            Room to explore
          </p>
        </div>

        <div class="max-w-3xl">
          <h2
            class="text-4xl font-bold tracking-tight text-gray-900 dark:text-white sm:text-5xl"
          >
            An idea can be useful without becoming a product.
          </h2>

          <div
            class="mt-8 space-y-5 text-lg leading-8 text-gray-600 dark:text-gray-300"
          >
            <p>
              Sometimes developing an idea reveals that it should be pursued.
              Sometimes it exposes a better direction. Sometimes the exploration
              itself is enough.
            </p>

            <p>
              ImagineThis.Site gives unfinished ideas somewhere to live without
              requiring each one to become a company, platform, or completed
              project.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Why I built it -->
    <section class="bg-white dark:bg-gray-900">
      <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 lg:px-8 lg:py-28">
        <div
          class="rounded-3xl bg-amber-950 px-6 py-14 text-white sm:px-10 lg:px-14 lg:py-20"
        >
          <div class="max-w-4xl">
            <p
              class="text-sm font-semibold uppercase tracking-[0.18em] text-amber-300"
            >
              Why I built it
            </p>

            <h2 class="mt-5 text-4xl font-bold tracking-tight sm:text-5xl">
              A place for unfinished ideas.
            </h2>

            <div class="mt-7 space-y-5 text-lg leading-8 text-amber-100">
              <p>
                Throughout my career, I have found myself sketching websites,
                organizations, accessibility tools, community projects,
                business concepts, and educational experiences.
              </p>

              <p>
                I did not expect every idea to become real. Developing them
                helped me think more clearly about what people need, how systems
                work, and what might be designed differently.
              </p>

              <p>
                ImagineThis.Site became a place to collect those explorations
                and let them remain useful even when they never leave the page.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Closing -->
    <section
      class="border-t border-gray-200 bg-gray-50 dark:border-gray-800 dark:bg-gray-950"
    >
      <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 lg:px-8 lg:py-28">
        <div
          class="rounded-3xl border border-gray-200 bg-white px-6 py-14 dark:border-gray-800 dark:bg-gray-900 sm:px-10 lg:px-14 lg:py-20"
        >
          <div class="max-w-4xl">
            <p
              class="text-sm font-semibold uppercase tracking-[0.18em] text-amber-700 dark:text-amber-400"
            >
              Explore the project
            </p>

            <h2
              class="mt-5 text-4xl font-bold tracking-tight text-gray-900 dark:text-white sm:text-5xl"
            >
              See what begins with “What if?”
            </h2>

            <p
              class="mt-6 max-w-3xl text-lg leading-8 text-gray-600 dark:text-gray-300"
            >
              Visit ImagineThis.Site to browse concepts, practical guides,
              prototypes, and thought experiments about what people might build,
              change, or understand differently.
            </p>

            <div class="mt-9 flex flex-wrap gap-4">
              <a
                href="https://imaginethis.site/"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center rounded-lg bg-amber-600 px-6 py-3 font-medium text-white transition-colors hover:bg-amber-700 focus:outline-none focus:ring-2 focus:ring-amber-500 focus:ring-offset-2 dark:focus:ring-offset-gray-900"
              >
                Visit ImagineThis.Site
                <span class="ml-2" aria-hidden="true">↗</span>
              </a>

              <a
                href="/projects/"
                class="inline-flex items-center rounded-lg border border-gray-300 px-6 py-3 font-medium text-gray-900 transition-colors hover:bg-gray-100 focus:outline-none focus:ring-2 focus:ring-amber-500 focus:ring-offset-2 dark:border-gray-700 dark:text-white dark:hover:bg-gray-800 dark:focus:ring-offset-gray-900"
              >
                Return to projects
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>