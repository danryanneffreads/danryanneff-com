---
import BaseLayout from "../layouts/BaseLayout.astro";

const explorations = [
  {
    title: "Concept websites",
    description: "See how a business, organization, or experience might look and work before it exists in the real world.",
  },
  {
    title: "Practical guides",
    description: "Explore ways to clarify an idea, think through a website, and make more informed digital decisions.",
  },
  {
    title: "Thought experiments",
    description: "Follow questions that reveal different possibilities, useful tradeoffs, or a new way to approach a familiar problem.",
  },
];
---

<BaseLayout
  title="ImagineThis.Site | Dan Ryan Neff"
  description="ImagineThis.Site is Dan Ryan Neff's creative idea laboratory for exploring concept websites, practical guides, thought experiments, and what could be possible."
>
  <!-- Short introduction with a clearly defined destination -->
  <section class="relative overflow-hidden border-b border-gray-200 bg-white dark:border-gray-800 dark:bg-gray-900">
    <div class="pointer-events-none absolute inset-0" aria-hidden="true">
      <div class="absolute -right-24 top-0 h-72 w-72 rounded-full bg-amber-100/60 blur-3xl dark:bg-amber-900/20"></div>
      <div class="absolute -left-24 bottom-0 h-64 w-64 rounded-full bg-sky-100/60 blur-3xl dark:bg-sky-900/20"></div>
    </div>

    <div class="relative mx-auto grid max-w-6xl items-center gap-9 px-4 py-14 sm:px-6 sm:py-20 lg:grid-cols-[minmax(0,1fr)_minmax(0,0.8fr)] lg:gap-12 lg:px-8 lg:py-24">
      <div class="max-w-2xl">
        <p class="text-sm font-semibold uppercase tracking-[0.16em] text-amber-700 dark:text-amber-400">
          Creative &amp; digital project
        </p>
        <h1 class="mt-4 text-4xl font-bold tracking-tight text-gray-900 dark:text-white sm:text-5xl lg:text-6xl">
          ImagineThis.Site
        </h1>
        <p class="mt-5 text-2xl font-medium leading-snug text-gray-900 dark:text-white sm:text-3xl">
          A place to explore what could be.
        </p>
        <p class="mt-5 text-lg leading-8 text-gray-600 dark:text-gray-300">
          ImagineThis.Site brings imagined websites, fictional concepts, practical guides, and thought experiments together in one creative space. It's a way to make an idea more concrete, explore different directions, and discover possibilities worth considering.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a
            href="https://imaginethis.site/"
            target="_blank"
            rel="noopener noreferrer"
            class="imaginethis-action imaginethis-action--primary inline-flex items-center justify-center rounded-lg bg-blue-600 px-5 py-3 font-semibold text-white"
          >
            Explore ImagineThis.Site
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M7 17 17 7M8 7h9v9" /></svg>
          </a>
          <a
            href="/projects/"
            class="imaginethis-action imaginethis-action--secondary inline-flex items-center justify-center rounded-lg border border-gray-300 px-5 py-3 font-semibold text-gray-900 dark:border-gray-700 dark:text-white"
          >
            Other projects
          </a>
        </div>
      </div>

      <!-- Keep the original artwork at a comfortable desktop size. -->
      <figure class="mx-auto w-full max-w-[380px] overflow-hidden rounded-2xl border border-gray-200 bg-gray-50 p-3 shadow-sm dark:border-gray-700 dark:bg-gray-950 sm:p-4 lg:justify-self-end">
        <img
          src="/images/DOT_artist_with_ideas.webp"
          alt="An artist surrounded by images and ideas"
          class="imaginethis-art block h-auto w-full object-contain"
          loading="eager"
          decoding="async"
        />
      </figure>
    </div>
  </section>

  <!-- Three specific ways to understand what the project contains -->
  <section class="bg-gray-50 py-14 dark:bg-gray-950 sm:py-20">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <h2 class="text-3xl font-bold tracking-tight text-gray-900 dark:text-white sm:text-4xl">
          What you'll find
        </h2>
        <p class="mt-4 text-lg leading-8 text-gray-600 dark:text-gray-300">
          Some ideas are playful, some are practical, and some are simply worth exploring.
        </p>
      </div>
      <div class="mt-8 grid gap-5 md:grid-cols-3">
        {explorations.map((item) => (
          <article class="rounded-2xl border border-gray-200 bg-white p-6 dark:border-gray-800 dark:bg-gray-900">
            <h3 class="text-xl font-bold text-gray-900 dark:text-white">{item.title}</h3>
            <p class="mt-3 leading-7 text-gray-600 dark:text-gray-300">{item.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Personal reason for making it, without a long manifesto -->
  <section class="border-t border-gray-200 bg-white py-14 dark:border-gray-800 dark:bg-gray-900 sm:py-20">
    <div class="mx-auto grid max-w-6xl items-center gap-9 px-4 sm:px-6 lg:grid-cols-[minmax(0,1fr)_minmax(0,0.62fr)] lg:gap-14 lg:px-8">
      <div class="max-w-3xl">
        <p class="text-sm font-semibold uppercase tracking-[0.16em] text-amber-700 dark:text-amber-400">Why I made it</p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight text-gray-900 dark:text-white sm:text-4xl">
          Give an idea somewhere to begin.
        </h2>
        <p class="mt-5 text-lg leading-8 text-gray-600 dark:text-gray-300">
          I've often found that imagining a possible website, business, or experience makes it easier to see what works and what doesn't. ImagineThis.Site is a home for those experiments, including ideas that may never become finished products.
        </p>
        <p class="mt-4 text-lg leading-8 text-gray-600 dark:text-gray-300">
          I'm interested in the conversations and collaborations that can grow from sharing them.
        </p>
      </div>
      <figure class="mx-auto w-full max-w-[300px] overflow-hidden rounded-2xl border border-gray-200 bg-gray-50 p-3 dark:border-gray-800 dark:bg-gray-950 lg:justify-self-end">
        <img
          src="/images/VividRhythms.webp"
          alt="Colorful abstract artwork with layered shapes and patterns"
          class="imaginethis-secondary-art block h-auto w-full object-contain"
          loading="lazy"
          decoding="async"
        />
      </figure>
    </div>
  </section>

  <!-- Clear invitation to browse or connect -->
  <section class="border-t border-gray-200 bg-gray-50 py-14 dark:border-gray-800 dark:bg-gray-950 sm:py-16">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <div class="rounded-2xl border border-gray-200 bg-white p-7 dark:border-gray-800 dark:bg-gray-900 sm:p-10">
        <h2 class="text-2xl font-bold text-gray-900 dark:text-white sm:text-3xl">Take a look, or start a conversation.</h2>
        <p class="mt-3 max-w-2xl text-lg leading-8 text-gray-600 dark:text-gray-300">
          Browse ImagineThis.Site for ideas and examples. If something sparks a thought, or you'd like to explore a possibility together, I'd welcome hearing from you.
        </p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a href="https://imaginethis.site/" target="_blank" rel="noopener noreferrer" class="imaginethis-action imaginethis-action--primary inline-flex items-center rounded-lg bg-blue-600 px-5 py-3 font-semibold text-white">
            Visit ImagineThis.Site
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M7 17 17 7M8 7h9v9" /></svg>
          </a>
          <a href="/contact/" class="imaginethis-action imaginethis-action--secondary inline-flex items-center rounded-lg border border-gray-300 px-5 py-3 font-semibold text-gray-900 dark:border-gray-700 dark:text-white">
            Contact me
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Explicit bounds prevent oversized artwork on desktop and keep mobile proportional. */
  .imaginethis-art { display: block; width: 100%; height: auto; max-height: 330px; object-fit: contain; }
  .imaginethis-secondary-art { display: block; width: 100%; height: auto; max-height: 250px; object-fit: contain; }

  /* Stable button spacing and contrast, including when global link styles are applied. */
  a.imaginethis-action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    min-height: 3.1rem;
    padding: 0.8rem 1.25rem !important;
    border-radius: 0.65rem;
    line-height: 1.25;
    text-decoration: none !important;
    white-space: normal;
    transition: background-color 160ms ease, border-color 160ms ease;
  }
  a.imaginethis-action--primary,
  a.imaginethis-action--primary:visited,
  a.imaginethis-action--primary:hover { color: #fff !important; }
  a.imaginethis-action--primary { background-color: #2563eb; }
  a.imaginethis-action--primary:hover { background-color: #1d4ed8; }
  a.imaginethis-action--secondary,
  a.imaginethis-action--secondary:visited { color: #111827 !important; }
  a.imaginethis-action--secondary:hover { background-color: #f3f4f6; }
  :global(.dark) a.imaginethis-action--secondary,
  :global(.dark) a.imaginethis-action--secondary:visited { color: #fff !important; }
  :global(.dark) a.imaginethis-action--secondary:hover { background-color: #1f2937; }
  a.imaginethis-action:focus-visible { outline: 3px solid #60a5fa; outline-offset: 3px; }
  a.imaginethis-action svg { flex: none; }
</style>
