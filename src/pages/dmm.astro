---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE_NAME, OG_IMAGE } from "../lib/constants";

const pageTitle = `Daily Money Management | ${SITE_NAME}`;
const pageDescription =
  "Daily money management in Madison, Wisconsin, for older adults, families, and others seeking dependable help with bills, paperwork, budgeting, and financial organization.";

const emailAddress = "danryanneff@gmail.com";
const emailHref = `mailto:${emailAddress}?subject=${encodeURIComponent("Daily Money Management Inquiry")}`;
const aadmmStandardsUrl = "https://secure.aadmm.com/bylaws-and-policies/";

const services = [
  {
    title: "Bills and payments",
    description:
      "Organizing bills, tracking due dates, preparing payments for review and approval, and following up on billing questions.",
  },
  {
    title: "Financial records and paperwork",
    description:
      "Keeping statements, receipts, and important documents organized, including gathering information for tax preparers and other professionals.",
  },
  {
    title: "Budgeting and expenses",
    description:
      "Tracking income, spending, and recurring obligations, and developing practical ways to stay on top of everyday finances.",
  },
  {
    title: "Debt and outstanding obligations",
    description:
      "Organizing information about balances, payments, and deadlines, and helping with administrative follow-through.",
  },
  {
    title: "Coordination with others",
    description:
      "Working with authorized family members, powers of attorney, accountants, and other professionals to keep information and responsibilities moving forward.",
  },
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  ogTitle={pageTitle}
  ogDescription={pageDescription}
  ogImage={OG_IMAGE}
>
  <!-- Clear introduction and a direct way to inquire. -->
  <section class="relative overflow-hidden border-b border-gray-200 bg-white dark:border-gray-800 dark:bg-gray-900" aria-labelledby="dmm-heading">
    <div class="pointer-events-none absolute inset-0" aria-hidden="true">
      <div class="absolute -right-24 top-0 h-80 w-80 rounded-full bg-blue-100/70 blur-3xl dark:bg-blue-900/20"></div>
      <div class="absolute -left-24 bottom-0 h-64 w-64 rounded-full bg-indigo-100/60 blur-3xl dark:bg-indigo-900/20"></div>
    </div>
    <div class="relative mx-auto grid max-w-6xl items-center gap-10 px-4 py-14 sm:px-6 sm:py-20 lg:grid-cols-[minmax(0,1.3fr)_minmax(220px,0.65fr)] lg:gap-16 lg:px-8 lg:py-24">
      <div class="max-w-3xl">
        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-blue-700 dark:text-blue-400">
          Daily Money Management · Madison, Wisconsin
        </p>
        <h1 id="dmm-heading" class="mt-5 text-4xl font-bold leading-[1.08] tracking-tight text-gray-900 dark:text-white sm:text-5xl lg:text-6xl">
          Dependable help with everyday financial responsibilities.
        </h1>
        <p class="mt-6 max-w-2xl text-lg leading-8 text-gray-700 dark:text-gray-300">
          I'm Dan Ryan Neff. I provide daily money management and administrative support for individuals and families who want help staying organized and keeping important financial details on track.
        </p>
        <p class="mt-4 max-w-2xl text-lg leading-8 text-gray-700 dark:text-gray-300">
          I work particularly with older adults and their families, while welcoming others who could benefit from practical, ongoing assistance.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={emailHref} class="inline-flex min-h-12 items-center justify-center rounded-lg bg-blue-700 px-6 py-3 font-semibold text-white transition-colors hover:bg-blue-800 hover:text-white focus-visible:outline focus-visible:outline-4 focus-visible:outline-offset-2 focus-visible:outline-blue-600 dark:bg-blue-500 dark:text-gray-950 dark:hover:bg-blue-400 dark:hover:text-gray-950">
            Email Dan <span class="ml-2" aria-hidden="true">→</span>
          </a>
          <a href="/contact/" class="inline-flex min-h-12 items-center justify-center rounded-lg border border-gray-300 bg-white px-6 py-3 font-semibold text-gray-900 transition-colors hover:border-blue-500 hover:text-blue-700 focus-visible:outline focus-visible:outline-4 focus-visible:outline-offset-2 focus-visible:outline-blue-600 dark:border-gray-700 dark:bg-gray-900 dark:text-gray-100 dark:hover:border-blue-400 dark:hover:text-blue-300">
            Other contact options
          </a>
        </div>
        <p class="mt-5 text-sm leading-6 text-gray-600 dark:text-gray-400">
          Have a question or aren't sure what you need? A conversation is a good place to start.
        </p>
      </div>
      <figure class="mx-auto w-full max-w-[250px] sm:max-w-[290px] lg:justify-self-end">
        <div class="overflow-hidden rounded-[2rem] border border-gray-200 bg-gray-100 shadow-lg shadow-gray-200/60 dark:border-gray-700 dark:bg-gray-800 dark:shadow-black/20">
          <img src="/images/dan-ryan-neff.webp" alt="Dan Ryan Neff outdoors" class="aspect-[4/5] w-full object-cover object-center" width="640" height="800" loading="eager" decoding="async" />
        </div>
      </figure>
    </div>
  </section>

  <!-- Concrete services, with no implied legal, tax, or investment advice. -->
  <section class="border-b border-gray-200 bg-gray-50 dark:border-gray-800 dark:bg-gray-950" aria-labelledby="services-heading">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:px-8 lg:py-20">
      <p class="text-sm font-semibold uppercase tracking-[0.18em] text-blue-700 dark:text-blue-400">Practical assistance</p>
      <h2 id="services-heading" class="mt-3 text-3xl font-bold tracking-tight text-gray-900 dark:text-white sm:text-4xl">How I can help</h2>
      <p class="mt-4 max-w-3xl text-lg leading-8 text-gray-700 dark:text-gray-300">
        Daily money management focuses on the tasks that keep financial life organized. Depending on your needs, that might include:
      </p>
      <div class="mt-9 grid gap-5 md:grid-cols-2">
        {services.map((service) => (
          <article class="rounded-2xl border border-gray-200 bg-white p-6 shadow-sm dark:border-gray-800 dark:bg-gray-900 sm:p-7">
            <div class="mb-5 h-1 w-12 rounded-full bg-blue-600 dark:bg-blue-400" aria-hidden="true"></div>
            <h3 class="text-xl font-bold text-gray-900 dark:text-white">{service.title}</h3>
            <p class="mt-3 text-base leading-7 text-gray-700 dark:text-gray-300">{service.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Explain the nature of the working relationship, not just the tasks. -->
  <section class="border-b border-gray-200 bg-white dark:border-gray-800 dark:bg-gray-900" aria-labelledby="approach-heading">
    <div class="mx-auto grid max-w-6xl gap-8 px-4 py-16 sm:px-6 lg:grid-cols-[minmax(240px,0.75fr)_minmax(0,1.25fr)] lg:gap-16 lg:px-8 lg:py-20">
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-blue-700 dark:text-blue-400">Working together</p>
        <h2 id="approach-heading" class="mt-3 text-3xl font-bold tracking-tight text-gray-900 dark:text-white sm:text-4xl">
          Support that fits your life.
        </h2>
      </div>
      <div class="max-w-3xl space-y-4 text-lg leading-8 text-gray-700 dark:text-gray-300">
        <p>Some people need help getting organized or handling a particular situation. Others appreciate regular assistance from someone who comes to know their preferences and priorities.</p>
        <p>I value building dependable working relationships over time, with patience, clear communication, discretion, and careful follow-through.</p>
        <p>My role is to support your decisions and independence. If family members or other professionals are involved, I share information only with appropriate authorization.</p>
      </div>
    </div>
  </section>

  <!-- Keep the path from inquiry to an agreed engagement short and understandable. -->
  <section class="border-b border-gray-200 bg-gray-50 dark:border-gray-800 dark:bg-gray-950" aria-labelledby="start-heading">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:px-8 lg:py-20">
      <p class="text-sm font-semibold uppercase tracking-[0.18em] text-blue-700 dark:text-blue-400">Getting started</p>
      <h2 id="start-heading" class="mt-3 text-3xl font-bold tracking-tight text-gray-900 dark:text-white sm:text-4xl">Let's begin with a conversation.</h2>
      <p class="mt-4 max-w-3xl text-lg leading-8 text-gray-700 dark:text-gray-300">You don't need to have everything figured out before contacting me.</p>
      <ol class="mt-9 grid gap-6 md:grid-cols-3">
        <li class="border-t-2 border-blue-600 pt-5 dark:border-blue-400">
          <p class="text-sm font-semibold text-blue-700 dark:text-blue-300">01</p>
          <h3 class="mt-2 text-xl font-bold text-gray-900 dark:text-white">Talk about your needs</h3>
          <p class="mt-3 text-base leading-7 text-gray-700 dark:text-gray-300">We'll discuss what's happening, what matters to you, and how I may be able to help.</p>
        </li>
        <li class="border-t-2 border-blue-600 pt-5 dark:border-blue-400">
          <p class="text-sm font-semibold text-blue-700 dark:text-blue-300">02</p>
          <h3 class="mt-2 text-xl font-bold text-gray-900 dark:text-white">Agree on the details</h3>
          <p class="mt-3 text-base leading-7 text-gray-700 dark:text-gray-300">We'll clarify the services, responsibilities, fees, and written agreement before beginning work.</p>
        </li>
        <li class="border-t-2 border-blue-600 pt-5 dark:border-blue-400">
          <p class="text-sm font-semibold text-blue-700 dark:text-blue-300">03</p>
          <h3 class="mt-2 text-xl font-bold text-gray-900 dark:text-white">Establish a routine</h3>
          <p class="mt-3 text-base leading-7 text-gray-700 dark:text-gray-300">If ongoing assistance makes sense, we'll find an approach that works for you.</p>
        </li>
      </ol>
    </div>
  </section>

  <!-- A real person and a verifiable professional affiliation. -->
  <section class="border-b border-gray-200 bg-white dark:border-gray-800 dark:bg-gray-900" aria-labelledby="background-heading">
    <div class="mx-auto grid max-w-6xl gap-8 px-4 py-16 sm:px-6 lg:grid-cols-2 lg:gap-12 lg:px-8 lg:py-20">
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-blue-700 dark:text-blue-400">About Dan</p>
        <h2 id="background-heading" class="mt-3 text-3xl font-bold tracking-tight text-gray-900 dark:text-white sm:text-4xl">Experience with people, processes, and details.</h2>
        <p class="mt-4 text-lg leading-8 text-gray-700 dark:text-gray-300">
          I bring more than 20 years of professional experience in operations, coordination, and administrative work. That background has shaped how I communicate, solve problems, and follow through on important responsibilities.
        </p>
        <a href="/about/" class="mt-5 inline-flex font-semibold text-blue-700 underline-offset-4 hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-blue-600 dark:text-blue-400">
          More about me <span class="ml-2" aria-hidden="true">→</span>
        </a>
      </div>
      <div class="rounded-2xl border border-gray-200 bg-gray-50 p-6 dark:border-gray-800 dark:bg-gray-950 sm:p-8">
        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-blue-700 dark:text-blue-400">Professional affiliation</p>
        <h3 class="mt-3 text-2xl font-bold text-gray-900 dark:text-white">AADMM Member</h3>
        <p class="mt-3 text-base leading-7 text-gray-700 dark:text-gray-300">
          I'm a member of the American Association of Daily Money Managers (AADMM). I follow its Standards of Practice and Code of Ethics, including commitments to confidentiality, integrity, and respect for clients.
        </p>
        <a href={aadmmStandardsUrl} target="_blank" rel="noopener noreferrer" class="mt-6 inline-block max-w-full rounded-md focus-visible:outline focus-visible:outline-4 focus-visible:outline-offset-4 focus-visible:outline-blue-600" aria-label="Read the AADMM Standards of Practice and Code of Ethics">
          <img src="/images/AADMM-Member-Badge-300x60.png" alt="AADMM member badge" width="300" height="60" class="h-auto max-w-full" loading="lazy" decoding="async" />
        </a>
        <p class="mt-3 text-sm leading-6 text-gray-700 dark:text-gray-300">
          <a href={aadmmStandardsUrl} target="_blank" rel="noopener noreferrer" class="font-semibold text-blue-700 underline underline-offset-4 hover:text-blue-900 dark:text-blue-400 dark:hover:text-blue-300">Read the standards and code of ethics</a>
        </p>
      </div>
    </div>
  </section>

  <!-- Geographic flexibility without implying unrestricted travel. -->
  <section class="bg-gray-50 dark:bg-gray-950" aria-labelledby="area-heading">
    <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:px-8 lg:py-14">
      <h2 id="area-heading" class="text-2xl font-bold text-gray-900 dark:text-white">Based in Madison, Wisconsin</h2>
      <p class="mt-3 max-w-4xl text-base leading-7 text-gray-700 dark:text-gray-300">
        Depending on your needs, services may be provided in person, remotely, or through a combination of both. Arrangements outside the Madison area may also be considered.
      </p>
    </div>
  </section>

  <!-- Clear contact choices and a privacy reminder. -->
  <section class="border-t border-gray-200 bg-white dark:border-gray-800 dark:bg-gray-900" aria-labelledby="contact-heading">
    <div class="mx-auto max-w-4xl px-4 py-16 text-center sm:px-6 lg:px-8 lg:py-20">
      <p class="text-sm font-semibold uppercase tracking-[0.18em] text-blue-700 dark:text-blue-400">Get in touch</p>
      <h2 id="contact-heading" class="mt-3 text-3xl font-bold tracking-tight text-gray-900 dark:text-white sm:text-4xl">Let's talk about how I can help.</h2>
      <p class="mx-auto mt-4 max-w-2xl text-lg leading-8 text-gray-700 dark:text-gray-300">
        Whether you're inquiring for yourself or helping someone you care about, I'd welcome a conversation.
      </p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
        <a href={emailHref} class="inline-flex min-h-12 items-center justify-center rounded-lg bg-blue-700 px-6 py-3 font-semibold text-white transition-colors hover:bg-blue-800 hover:text-white focus-visible:outline focus-visible:outline-4 focus-visible:outline-offset-2 focus-visible:outline-blue-600 dark:bg-blue-500 dark:text-gray-950 dark:hover:bg-blue-400 dark:hover:text-gray-950">Email Dan <span class="ml-2" aria-hidden="true">→</span></a>
        <a href="/contact/" class="inline-flex min-h-12 items-center justify-center rounded-lg border border-gray-300 bg-white px-6 py-3 font-semibold text-gray-900 transition-colors hover:border-blue-500 hover:text-blue-700 focus-visible:outline focus-visible:outline-4 focus-visible:outline-offset-2 focus-visible:outline-blue-600 dark:border-gray-700 dark:bg-gray-900 dark:text-gray-100 dark:hover:border-blue-400 dark:hover:text-blue-300">More contact options</a>
      </div>
      <p class="mt-4 text-base text-gray-700 dark:text-gray-300">Or email <a href={emailHref} class="font-semibold text-blue-700 underline underline-offset-4 dark:text-blue-400">{emailAddress}</a>.</p>
      <p class="mx-auto mt-5 max-w-2xl text-sm leading-6 text-gray-600 dark:text-gray-400">Please don't include account numbers or other sensitive financial information in an initial email.</p>
      <p class="mx-auto mt-8 max-w-2xl border-t border-gray-200 pt-6 text-sm leading-6 text-gray-600 dark:border-gray-800 dark:text-gray-400">
        Daily money management is administrative assistance, not legal, tax, investment, or other specialized financial advice.
      </p>
    </div>
  </section>
</BaseLayout>
