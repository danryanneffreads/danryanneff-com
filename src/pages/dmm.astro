---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE_NAME, OG_IMAGE } from "../lib/constants";

const pageTitle = `Daily Money Management | ${SITE_NAME}`;
const pageDescription =
  "Daily money management and administrative support for older adults and families. Help with bills, records, budgeting, and everyday financial responsibilities. Based in Madison, Wisconsin.";

const emailAddress = "danryanneff@gmail.com";
const emailHref = `mailto:${emailAddress}?subject=Daily%20Money%20Management%20Inquiry`;

const services = [
  {
    number: "01",
    title: "Bills and payments",
    description:
      "Organizing bills, keeping track of due dates, preparing payments for your review and approval, and helping follow up on billing questions.",
  },
  {
    number: "02",
    title: "Financial records and paperwork",
    description:
      "Organizing statements, receipts, correspondence, and important documents, including gathering information for tax preparers and other professionals.",
  },
  {
    number: "03",
    title: "Budgeting and expenses",
    description:
      "Helping track income, expenses, and recurring obligations, and setting up practical ways to understand and manage everyday spending.",
  },
  {
    number: "04",
    title: "Debt and outstanding bills",
    description:
      "Helping organize balances, payment information, and outstanding obligations, with attention to deadlines and administrative follow-through.",
  },
  {
    number: "05",
    title: "Coordination with others",
    description:
      "Helping communicate and organize information with authorized family members, powers of attorney, accountants, and other professionals.",
  },
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  ogTitle={pageTitle}
  ogDescription={pageDescription}
  ogImage={OG_IMAGE}
>
  <!-- Introduction -->
  <section
    class="relative overflow-hidden border-b border-gray-200 bg-white dark:border-gray-800 dark:bg-gray-900"
    aria-labelledby="page-heading"
  >
    <div class="pointer-events-none absolute inset-0" aria-hidden="true">
      <div
        class="absolute -right-28 top-4 h-80 w-80 rounded-full bg-blue-100/70 blur-3xl dark:bg-blue-900/20"
      ></div>
      <div
        class="absolute -left-28 bottom-0 h-72 w-72 rounded-full bg-indigo-100/60 blur-3xl dark:bg-indigo-900/20"
      ></div>
    </div>

    <div
      class="relative mx-auto grid max-w-6xl items-center gap-12 px-4 py-16 sm:px-6 sm:py-24 lg:grid-cols-[minmax(0,1fr)_280px] lg:gap-16 lg:px-8"
    >
      <div class="max-w-3xl">
        <p
          class="text-sm font-semibold uppercase tracking-[0.18em] text-blue-600 dark:text-blue-400"
        >
          Personal and administrative support
        </p>
        <h1
          id="page-heading"
          class="mt-5 text-4xl font-bold leading-[1.1] tracking-tight text-gray-900 dark:text-white sm:text-5xl lg:text-6xl"
        >
          Daily Money Management
        </h1>
        <p
          class="mt-6 text-xl font-semibold leading-8 text-gray-800 dark:text-gray-100 sm:text-2xl"
        >
          Dependable help with bills, paperwork, and everyday financial responsibilities.
        </p>
        <div
          class="mt-6 max-w-2xl space-y-4 text-lg leading-8 text-gray-700 dark:text-gray-300"
        >
          <p>
            Managing day-to-day finances can become complicated. Whether you're
            looking for assistance yourself or helping someone you care about,
            having someone dependable to work with can make a difference.
          </p>
          <p>
            I'm Dan Ryan Neff, based in Madison, Wisconsin. I provide practical
            daily money management and administrative support, particularly for
            older adults and their families.
          </p>
        </div>
        <div class="mt-9 flex flex-wrap items-center gap-4">
          <a
            href={emailHref}
            class="inline-flex min-h-12 items-center justify-center rounded-full bg-blue-700 px-6 py-3 text-base font-semibold text-white transition-colors hover:bg-blue-800 hover:text-white focus-visible:outline focus-visible:outline-4 focus-visible:outline-offset-2 focus-visible:outline-blue-600 dark:bg-blue-500 dark:text-gray-950 dark:hover:bg-blue-400 dark:hover:text-gray-950"
          >
            Email Dan
          </a>
          <a
            href="/contact/"
            class="inline-flex min-h-12 items-center justify-center rounded-full border border-gray-400 px-6 py-3 text-base font-semibold text-gray-900 transition-colors hover:border-blue-600 hover:text-blue-700 focus-visible:outline focus-visible:outline-4 focus-visible:outline-offset-2 focus-visible:outline-blue-600 dark:border-gray-600 dark:text-white dark:hover:border-blue-400 dark:hover:text-blue-300"
          >
            Other contact options
          </a>
        </div>
      </div>

      <figure class="mx-auto w-full max-w-[280px] lg:justify-self-end">
        <div
          class="overflow-hidden rounded-[2rem] border border-gray-200 bg-gray-100 shadow-lg shadow-gray-200/60 dark:border-gray-700 dark:bg-gray-800 dark:shadow-black/20"
        >
          <img
            src="/images/dan-ryan-neff.webp"
            alt="Dan Ryan Neff outdoors"
            class="aspect-[4/5] w-full object-cover object-center"
            width="640"
            height="800"
            loading="eager"
            decoding="async"
          />
        </div>
        <figcaption class="mt-3 text-center text-sm text-gray-600 dark:text-gray-400">
          Dan Ryan Neff
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- What the service includes -->
  <section class="bg-white py-16 dark:bg-gray-900 sm:py-24" aria-labelledby="services-heading">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-blue-600 dark:text-blue-400">
          Practical assistance
        </p>
        <h2
          id="services-heading"
          class="mt-4 text-3xl font-bold tracking-tight text-gray-900 dark:text-white sm:text-4xl"
        >
          How I can help
        </h2>
        <p class="mt-5 text-lg leading-8 text-gray-700 dark:text-gray-300">
          Daily money management focuses on the practical details of everyday
          finances. Services can be tailored to what you need, whether that means
          getting organized or receiving regular assistance.
        </p>
      </div>

      <div class="mt-10 grid gap-5 md:grid-cols-2">
        {
          services.map((service) => (
            <article class="rounded-2xl border border-gray-200 bg-gray-50 p-6 dark:border-gray-700 dark:bg-gray-800/60 sm:p-7">
              <p class="text-sm font-semibold tracking-widest text-blue-700 dark:text-blue-300" aria-hidden="true">
                {service.number}
              </p>
              <h3 class="mt-3 text-xl font-semibold text-gray-900 dark:text-white sm:text-2xl">
                {service.title}
              </h3>
              <p class="mt-3 text-base leading-7 text-gray-700 dark:text-gray-300 sm:text-lg sm:leading-8">
                {service.description}
              </p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Relationship and approach -->
  <section
    class="border-y border-gray-200 bg-gray-50 py-16 dark:border-gray-800 dark:bg-gray-950 sm:py-24"
    aria-labelledby="approach-heading"
  >
    <div class="mx-auto grid max-w-6xl gap-8 px-4 sm:px-6 lg:grid-cols-[0.55fr_1fr] lg:gap-16 lg:px-8">
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-blue-600 dark:text-blue-400">
          My approach
        </p>
        <h2
          id="approach-heading"
          class="mt-4 text-3xl font-bold tracking-tight text-gray-900 dark:text-white sm:text-4xl"
        >
          Support that fits your life
        </h2>
      </div>
      <div class="max-w-3xl space-y-5 text-lg leading-8 text-gray-700 dark:text-gray-300">
        <p>
          Some people need help with a specific situation. Others benefit from
          consistent assistance over time. I'm interested in building dependable
          working relationships based on an understanding of each client's needs
          and preferences.
        </p>
        <p>
          My goal is to help clients stay organized while respecting their
          independence and decisions. I value patience, clear communication,
          discretion, and careful follow-through.
        </p>
        <p>
          When family members or other professionals are involved, I work with
          the client's wishes and appropriate authorizations in mind.
        </p>
      </div>
    </div>
  </section>

  <!-- Starting a relationship -->
  <section class="bg-white py-16 dark:bg-gray-900 sm:py-24" aria-labelledby="getting-started-heading">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-blue-600 dark:text-blue-400">
          Getting started
        </p>
        <h2
          id="getting-started-heading"
          class="mt-4 text-3xl font-bold tracking-tight text-gray-900 dark:text-white sm:text-4xl"
        >
          A simple way to get started
        </h2>
        <p class="mt-5 text-lg leading-8 text-gray-700 dark:text-gray-300">
          You don't need to know exactly which services you need before reaching
          out. We can start by talking about what's happening and what kind of
          assistance would be useful.
        </p>
      </div>
      <ol class="mt-10 grid gap-6 md:grid-cols-3">
        <li class="border-t-2 border-blue-600 pt-5 dark:border-blue-400">
          <p class="text-sm font-semibold text-blue-700 dark:text-blue-300">01</p>
          <h3 class="mt-3 text-xl font-semibold text-gray-900 dark:text-white">Talk about your needs</h3>
          <p class="mt-3 text-base leading-7 text-gray-700 dark:text-gray-300 sm:text-lg">
            We'll discuss your circumstances, questions, and priorities.
          </p>
        </li>
        <li class="border-t-2 border-blue-600 pt-5 dark:border-blue-400">
          <p class="text-sm font-semibold text-blue-700 dark:text-blue-300">02</p>
          <h3 class="mt-3 text-xl font-semibold text-gray-900 dark:text-white">Agree on an approach</h3>
          <p class="mt-3 text-base leading-7 text-gray-700 dark:text-gray-300 sm:text-lg">
            We'll clarify the work, responsibilities, fees, and written terms before services begin.
          </p>
        </li>
        <li class="border-t-2 border-blue-600 pt-5 dark:border-blue-400">
          <p class="text-sm font-semibold text-blue-700 dark:text-blue-300">03</p>
          <h3 class="mt-3 text-xl font-semibold text-gray-900 dark:text-white">Build a workable routine</h3>
          <p class="mt-3 text-base leading-7 text-gray-700 dark:text-gray-300 sm:text-lg">
            If ongoing help makes sense, we'll develop a rhythm that suits your needs.
          </p>
        </li>
      </ol>
    </div>
  </section>

  <!-- Background and geographic flexibility -->
  <section
    class="border-y border-gray-200 bg-gray-50 py-16 dark:border-gray-800 dark:bg-gray-950 sm:py-24"
    aria-labelledby="about-dan-heading"
  >
    <div class="mx-auto grid max-w-6xl gap-12 px-4 sm:px-6 lg:grid-cols-2 lg:gap-20 lg:px-8">
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-blue-600 dark:text-blue-400">
          About Dan
        </p>
        <h2
          id="about-dan-heading"
          class="mt-4 text-3xl font-bold tracking-tight text-gray-900 dark:text-white sm:text-4xl"
        >
          Experience built around people and details
        </h2>
        <p class="mt-5 text-lg leading-8 text-gray-700 dark:text-gray-300">
          I bring more than 20 years of professional experience in operations,
          coordination, and helping people work through complicated situations.
          Those years have strengthened my attention to detail, judgment,
          communication, and follow-through.
        </p>
        <p class="mt-4 text-lg leading-8 text-gray-700 dark:text-gray-300">
          I bring those skills to daily money management, with respect for each
          client's circumstances and priorities.
        </p>
        <a
          href="/about/"
          class="mt-5 inline-block text-base font-semibold underline underline-offset-4 focus-visible:outline focus-visible:outline-4 focus-visible:outline-offset-4 focus-visible:outline-blue-600"
        >
          More about me
        </a>
      </div>
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-blue-600 dark:text-blue-400">
          Service area
        </p>
        <h2 class="mt-4 text-3xl font-bold tracking-tight text-gray-900 dark:text-white sm:text-4xl">
          Based in Madison, Wisconsin
        </h2>
        <p class="mt-5 text-lg leading-8 text-gray-700 dark:text-gray-300">
          Depending on individual needs, services may be provided in person,
          remotely, or through a combination of both. Arrangements outside the
          Madison area may also be considered.
        </p>
        <p class="mt-4 text-lg leading-8 text-gray-700 dark:text-gray-300">
          Fees and service arrangements are discussed individually and confirmed
          in writing before work begins.
        </p>
      </div>
    </div>
  </section>

  <!-- AADMM professional membership -->
  <section
    class="bg-white py-16 dark:bg-gray-900 sm:py-24"
    aria-labelledby="aadmm-heading"
  >
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-blue-600 dark:text-blue-400">
          Professional affiliation
        </p>
        <h2
          id="aadmm-heading"
          class="mt-4 text-3xl font-bold tracking-tight text-gray-900 dark:text-white sm:text-4xl"
        >
          AADMM Member
        </h2>
        <p class="mt-5 text-lg leading-8 text-gray-700 dark:text-gray-300">
          I'm a member of the American Association of Daily Money Managers
          (AADMM). Members follow the association's Standards of Practice and
          Code of Ethics, including commitments to confidentiality, integrity,
          and respect for clients.
        </p>
        <a
          href="https://secure.aadmm.com/bylaws-and-policies/"
          class="mt-7 inline-block rounded-md focus-visible:outline focus-visible:outline-4 focus-visible:outline-offset-4 focus-visible:outline-blue-600"
          aria-label="Read the AADMM Standards of Practice and Code of Ethics"
        >
          <img
            src="/images/AADMM-Member-Badge-300x60.png"
            alt="AADMM member badge: background check, Standards of Practice, and Code of Ethics"
            width="300"
            height="60"
            loading="lazy"
            decoding="async"
            class="h-auto max-w-full"
          />
        </a>
        <p class="mt-4 text-base leading-7 text-gray-700 dark:text-gray-300">
          <a
            href="https://secure.aadmm.com/bylaws-and-policies/"
            class="font-semibold underline underline-offset-4 focus-visible:outline focus-visible:outline-4 focus-visible:outline-offset-4 focus-visible:outline-blue-600"
          >
            Read AADMM's Standards of Practice and Code of Ethics
          </a>
        </p>
      </div>
    </div>
  </section>

  <!-- Contact -->
  <section class="bg-white py-16 dark:bg-gray-900 sm:py-24" aria-labelledby="contact-heading">
    <div class="mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-[0.18em] text-blue-600 dark:text-blue-400">
        Get in touch
      </p>
      <h2
        id="contact-heading"
        class="mt-4 text-3xl font-bold tracking-tight text-gray-900 dark:text-white sm:text-4xl"
      >
        Let's start with a conversation
      </h2>
      <p class="mx-auto mt-5 max-w-2xl text-lg leading-8 text-gray-700 dark:text-gray-300">
        If you or someone you care about could benefit from daily money management,
        I'd welcome the opportunity to hear about your situation and discuss how
        I might help.
      </p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
        <a
          href={emailHref}
          class="inline-flex min-h-12 items-center justify-center rounded-full bg-blue-700 px-6 py-3 text-base font-semibold text-white transition-colors hover:bg-blue-800 hover:text-white focus-visible:outline focus-visible:outline-4 focus-visible:outline-offset-2 focus-visible:outline-blue-600 dark:bg-blue-500 dark:text-gray-950 dark:hover:bg-blue-400 dark:hover:text-gray-950"
        >
          Email Dan
        </a>
        <a
          href="/contact/"
          class="inline-flex min-h-12 items-center justify-center rounded-full border border-gray-400 px-6 py-3 text-base font-semibold text-gray-900 transition-colors hover:border-blue-600 hover:text-blue-700 focus-visible:outline focus-visible:outline-4 focus-visible:outline-offset-2 focus-visible:outline-blue-600 dark:border-gray-600 dark:text-white dark:hover:border-blue-400 dark:hover:text-blue-300"
        >
          Other contact options
        </a>
      </div>
      <p class="mt-5 text-base text-gray-700 dark:text-gray-300">
        Or write directly to
        <a
          href={emailHref}
          class="font-semibold underline underline-offset-4 break-all"
        >
          {emailAddress}
        </a>
      </p>
      <p class="mx-auto mt-5 max-w-2xl text-sm leading-6 text-gray-600 dark:text-gray-400">
        For your privacy, please don't include account numbers or other sensitive financial
        information in an initial email.
      </p>
      <p class="mx-auto mt-8 max-w-2xl border-t border-gray-200 pt-6 text-sm leading-6 text-gray-600 dark:border-gray-700 dark:text-gray-400">
        Daily money management provides administrative assistance and does not
        replace legal, tax, investment, or other specialized financial advice.
      </p>
    </div>
  </section>
</BaseLayout>
