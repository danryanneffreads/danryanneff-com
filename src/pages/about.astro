---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE_NAME, OG_IMAGE } from "../lib/constants";

const experience = [
  {
    title: "Operations and leadership",
    description:
      "More than two decades inside organizations taught me how much good work depends on clear expectations, thoughtful systems, sound judgment, and the ability of people to work well together.",
  },
  {
    title: "Accessibility",
    description:
      "Accessibility has deepened my understanding of participation. The same environment can support one person while excluding another, and thoughtful design often creates a better experience for everyone.",
  },
  {
    title: "Websites and digital places",
    description:
      "Building websites led me to see the internet not simply as a collection of tools, but as an environment people inhabit—one that shapes identity, attention, access, trust, and connection.",
  },
  {
    title: "Artificial intelligence",
    description:
      "AI has expanded how I learn, reason, create, and build. It has also made questions about judgment, authorship, dependence, inequality, and human agency more urgent.",
  },
];

const interests = [
  {
    title: "Technology",
    description:
      "How can technology make people more capable without weakening judgment, attention, confidence, or human connection?",
  },
  {
    title: "Health and daily life",
    description:
      "How do habits, relationships, movement, rest, food, and the environments within and around us compound over time?",
  },
  {
    title: "Organizations",
    description:
      "What helps people work together effectively, pursue meaningful goals, and adapt without losing sight of the human beings involved?",
  },
  {
    title: "Accessibility and participation",
    description:
      "What allows more people to enter, navigate, contribute to, and feel at home in the places and systems we create?",
  },
  {
    title: "Creativity",
    description:
      "What supports curiosity, experimentation, expression, and the confidence to turn an idea into something real?",
  },
  {
    title: "Cities and communities",
    description:
      "How do streets, public spaces, transportation, gardens, local institutions, and relationships shape everyday life?",
  },
];

const principles = [
  "Technology should expand human possibility without diminishing human life.",
  "Good systems should help people participate, contribute, and exercise judgment.",
  "Small decisions and supportive conditions can compound into meaningful change.",
  "The environments we create influence what people notice, believe, and become able to do.",
];

const pageTitle = `About | ${SITE_NAME}`;

const pageDescription =
  "About Dan Ryan Neff, whose work and interests span organizations, technology, accessibility, websites, creativity, health, cities, and community.";
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  ogTitle={pageTitle}
  ogDescription={pageDescription}
  ogImage={OG_IMAGE}
>
  <!-- Hero -->
  <section
    class="relative overflow-hidden border-b border-gray-200 bg-white dark:border-gray-800 dark:bg-gray-900"
  >
    <div class="pointer-events-none absolute inset-0" aria-hidden="true">
      <div
        class="absolute -right-32 top-8 h-96 w-96 rounded-full bg-indigo-100/70 blur-3xl dark:bg-indigo-900/20"
      >
      </div>

      <div
        class="absolute -left-24 bottom-0 h-72 w-72 rounded-full bg-blue-100/60 blur-3xl dark:bg-blue-900/20"
      >
      </div>
    </div>

    <div
      class="relative mx-auto grid max-w-6xl items-center gap-12 px-4 py-20 sm:px-6 sm:py-28 lg:grid-cols-[minmax(0,1fr)_320px] lg:gap-16 lg:px-8 lg:py-32"
    >
      <div class="max-w-4xl">
        <p
          class="text-sm font-semibold uppercase tracking-[0.18em] text-blue-600 dark:text-blue-400"
        >
          About
        </p>

        <h1
          class="mt-6 text-5xl font-bold leading-[1.06] tracking-tight text-gray-900 dark:text-white sm:text-6xl"
        >
          I am interested in how the worlds we create shape the lives we live.
        </h1>

        <div
          class="mt-8 max-w-3xl space-y-5 text-lg leading-8 text-gray-600 dark:text-gray-300 sm:text-xl"
        >
          <p>
            I’m Dan Ryan Neff. My work and interests move among organizations,
            technology, accessibility, websites, creativity, health, cities,
            community, and the everyday choices through which a life takes
            shape.
          </p>

          <p>
            These subjects do not always appear connected at first. I keep
            finding that they are: each influences what people can notice,
            understand, create, contribute, and become.
          </p>
        </div>
      </div>

      <figure class="mx-auto w-full max-w-xs lg:mx-0 lg:justify-self-end">
        <div
          class="overflow-hidden rounded-[2rem] border border-gray-200 bg-gray-100 shadow-lg shadow-gray-200/60 dark:border-gray-700 dark:bg-gray-800 dark:shadow-black/20"
        >
          <img
            src="/images/dan-ryan-neff.webp"
            alt="Dan Ryan Neff outdoors"
            class="aspect-[4/5] w-full object-cover object-center"
            width="640"
            height="800"
            loading="eager"
            decoding="async"
            fetchpriority="high"
          />
        </div>

        <figcaption
          class="mt-4 text-center text-sm text-gray-500 dark:text-gray-400 lg:text-left"
        >
          Dan Ryan Neff
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- Perspective -->
  <section class="bg-white dark:bg-gray-900">
    <div
      class="mx-auto grid max-w-6xl gap-8 px-4 py-20 sm:px-6 lg:grid-cols-[0.42fr_1fr] lg:px-8 lg:py-28"
    >
      <div>
        <p
          class="text-sm font-semibold uppercase tracking-[0.18em] text-blue-600 dark:text-blue-400"
        >
          A way of looking
        </p>
      </div>

      <div class="max-w-3xl">
        <h2
          class="text-3xl font-semibold leading-tight tracking-tight text-gray-900 dark:text-white sm:text-4xl"
        >
          Better lives rarely emerge from one dramatic answer.
        </h2>

        <div
          class="mt-8 space-y-5 text-lg leading-8 text-gray-600 dark:text-gray-300"
        >
          <p>
            They develop through many interacting conditions: health,
            relationships, habits, knowledge, tools, organizations, physical
            surroundings, digital environments, and the decisions we make
            repeatedly over time.
          </p>

          <p>
            I am drawn to those interactions. I want to understand what helps
            people and meaningful work flourish—and how thoughtful choices can
            improve the systems and environments in which life unfolds.
          </p>

          <p>
            That interest is practical as much as philosophical. It influences
            what I build, the work I take on, the questions I ask, and the
            conversations I value.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Experience -->
  <section
    class="border-y border-gray-200 bg-gray-50 dark:border-gray-800 dark:bg-gray-950"
  >
    <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 lg:px-8 lg:py-28">
      <div class="grid gap-12 lg:grid-cols-[0.55fr_1fr]">
        <div>
          <p
            class="text-sm font-semibold uppercase tracking-[0.18em] text-blue-600 dark:text-blue-400"
          >
            Experience
          </p>

          <h2
            class="mt-5 text-4xl font-bold tracking-tight text-gray-900 dark:text-white sm:text-5xl"
          >
            My perspective has grown through different kinds of work.
          </h2>

          <p
            class="mt-6 text-lg leading-8 text-gray-600 dark:text-gray-300"
          >
            I have spent years working where people, systems, tools, and
            changing conditions meet. That experience has taught me to look
            beyond isolated problems and pay attention to the environment
            around them.
          </p>
        </div>

        <div class="border-t border-gray-300 dark:border-gray-700">
          {
            experience.map((item, index) => (
              <article
                class="grid gap-4 border-b border-gray-300 py-8 dark:border-gray-700 sm:grid-cols-[3rem_1fr]"
              >
                <span
                  class="pt-1 font-mono text-xs text-gray-400 dark:text-gray-500"
                >
                  {String(index + 1).padStart(2, "0")}
                </span>

                <div>
                  <h3
                    class="text-2xl font-bold text-gray-900 dark:text-white"
                  >
                    {item.title}
                  </h3>

                  <p
                    class="mt-4 max-w-2xl leading-7 text-gray-600 dark:text-gray-300"
                  >
                    {item.description}
                  </p>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- Areas of interest -->
  <section class="bg-white dark:bg-gray-900">
    <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 lg:px-8 lg:py-28">
      <div class="max-w-3xl">
        <p
          class="text-sm font-semibold uppercase tracking-[0.18em] text-blue-600 dark:text-blue-400"
        >
          Areas of interest
        </p>

        <h2
          class="mt-5 text-4xl font-bold tracking-tight text-gray-900 dark:text-white sm:text-5xl"
        >
          I tend to follow the connections between things.
        </h2>

        <p class="mt-6 text-lg leading-8 text-gray-600 dark:text-gray-300">
          My interests continue to evolve, but these are some of the places
          where my attention regularly returns.
        </p>
      </div>

      <div class="mt-14 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {
          interests.map((interest, index) => (
            <article
              class="rounded-2xl border border-gray-200 bg-gray-50 p-7 dark:border-gray-800 dark:bg-gray-950 sm:p-8"
            >
              <div class="flex items-start gap-4">
                <span class="pt-1 font-mono text-xs text-gray-400 dark:text-gray-500">
                  {String(index + 1).padStart(2, "0")}
                </span>

                <div>
                  <h3
                    class="text-xl font-bold text-gray-900 dark:text-white"
                  >
                    {interest.title}
                  </h3>

                  <p
                    class="mt-4 leading-7 text-gray-600 dark:text-gray-300"
                  >
                    {interest.description}
                  </p>
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Principles -->
  <section class="bg-gray-900 text-white dark:bg-black">
    <div
      class="mx-auto grid max-w-6xl gap-12 px-4 py-20 sm:px-6 lg:grid-cols-[0.62fr_1fr] lg:px-8 lg:py-28"
    >
      <div>
        <p
          class="text-sm font-semibold uppercase tracking-[0.18em] text-blue-400"
        >
          Principles
        </p>

        <h2 class="mt-5 text-4xl font-bold tracking-tight sm:text-5xl">
          A few ideas guide how I approach the world.
        </h2>

        <p class="mt-6 max-w-xl text-lg leading-8 text-gray-300">
          These are not a fixed framework. They are durable ideas that continue
          to shape my judgment and work.
        </p>
      </div>

      <ol class="border-t border-gray-700">
        {
          principles.map((principle, index) => (
            <li
              class="grid grid-cols-[2rem_1fr] gap-4 border-b border-gray-700 py-6 sm:grid-cols-[3rem_1fr]"
            >
              <span class="pt-1 font-mono text-xs text-gray-500">
                {String(index + 1).padStart(2, "0")}
              </span>

              <p class="text-xl leading-8 text-gray-200 sm:text-2xl">
                {principle}
              </p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Work and projects -->
  <section class="bg-white dark:bg-gray-900">
    <div
      class="mx-auto grid max-w-6xl items-center gap-12 px-4 py-20 sm:px-6 lg:grid-cols-[1fr_0.8fr] lg:px-8 lg:py-28"
    >
      <div class="max-w-3xl">
        <p
          class="text-sm font-semibold uppercase tracking-[0.18em] text-blue-600 dark:text-blue-400"
        >
          Work and projects
        </p>

        <h2
          class="mt-5 text-4xl font-bold tracking-tight text-gray-900 dark:text-white sm:text-5xl"
        >
          Ideas often become clearer when they meet the world.
        </h2>

        <div
          class="mt-7 space-y-5 text-lg leading-8 text-gray-600 dark:text-gray-300"
        >
          <p>
            Sometimes that means building a website, developing a resource,
            improving a process, creating something visual, or helping an
            organization think through a complicated challenge.
          </p>

          <p>
            My projects arise from different interests and circumstances. Taken
            together, they show how I approach ideas: with curiosity, practical
            judgment, and a willingness to make something real.
          </p>
        </div>

        <a
          href="/projects/"
          class="mt-9 inline-flex items-center rounded-lg bg-blue-600 px-6 py-3 font-medium text-white transition-colors hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 dark:focus:ring-offset-gray-900"
        >
          Explore the projects
          <span class="ml-2" aria-hidden="true">→</span>
        </a>
      </div>

      <div class="flex justify-center lg:justify-end">
        <img
          src="/images/dot-compilation.webp"
          alt="A colorful collection of connected circular illustrations"
          class="w-full max-w-md"
          width="800"
          height="800"
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>
  </section>

  <!-- Invitation -->
  <section
    class="border-t border-gray-200 bg-gray-50 dark:border-gray-800 dark:bg-gray-950"
  >
    <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 lg:px-8 lg:py-28">
      <div
        class="rounded-3xl border border-gray-200 bg-white px-6 py-14 dark:border-gray-800 dark:bg-gray-900 sm:px-10 lg:px-14 lg:py-20"
      >
        <div class="max-w-4xl">
          <p
            class="text-sm font-semibold uppercase tracking-[0.18em] text-blue-600 dark:text-blue-400"
          >
            Continue the conversation
          </p>

          <h2
            class="mt-5 text-4xl font-bold tracking-tight text-gray-900 dark:text-white sm:text-5xl"
          >
            Good conversations can become ideas, projects, and useful work.
          </h2>

          <p
            class="mt-6 max-w-3xl text-lg leading-8 text-gray-600 dark:text-gray-300"
          >
            You may be building something, navigating change, reconsidering how
            an organization works, or exploring questions that overlap with my
            own. I welcome thoughtful conversations and unexpected points of
            connection.
          </p>

          <a
            href="/contact/"
            class="mt-9 inline-flex items-center rounded-lg bg-blue-600 px-6 py-3 font-medium text-white transition-colors hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 dark:focus:ring-offset-gray-900"
          >
            Start a conversation
            <span class="ml-2" aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>