---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE_NAME, OG_IMAGE } from "../lib/constants";

const pageTitle = `About | ${SITE_NAME}`;
const pageDescription =
  "Learn about Dan Ryan Neff: executive assistant, daily money manager, and creator working across operations, technology, and art in Madison, Wisconsin.";

const experience = [
  {
    title: "Operations and coordination",
    description:
      "I spent more than 20 years working in telecommunications operations, including supervision and coordinating day-to-day work. That experience taught me the value of clear communication, sound judgment, and steady follow-through.",
  },
  {
    title: "Executive assistance",
    description:
      "Today, I work as an executive assistant at the Wisconsin Council of the Blind and Visually Impaired, helping keep people, information, and administrative responsibilities organized.",
  },
  {
    title: "Daily money management",
    description:
      "I also help individuals and families with bills, financial paperwork, and everyday financial organization. I value trust, independence, and building dependable working relationships over time.",
  },
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  ogTitle={pageTitle}
  ogDescription={pageDescription}
  ogImage={OG_IMAGE}
>
  <!-- A clear introduction, with the site's existing portrait and visual language. -->
  <section
    class="relative overflow-hidden border-b border-gray-200 bg-white dark:border-gray-800 dark:bg-gray-900"
    aria-labelledby="about-heading"
  >
    <div class="pointer-events-none absolute inset-0" aria-hidden="true">
      <div class="absolute -right-24 top-0 h-80 w-80 rounded-full bg-blue-100/70 blur-3xl dark:bg-blue-900/20"></div>
      <div class="absolute -left-24 bottom-0 h-64 w-64 rounded-full bg-indigo-100/60 blur-3xl dark:bg-indigo-900/20"></div>
    </div>
    <div class="relative mx-auto grid max-w-6xl items-center gap-10 px-4 py-16 sm:px-6 sm:py-20 lg:grid-cols-[minmax(0,1.3fr)_minmax(220px,0.65fr)] lg:gap-16 lg:px-8 lg:py-24">
      <div class="max-w-3xl">
        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-blue-700 dark:text-blue-400">
          About Dan Ryan Neff
        </p>
        <h1 id="about-heading" class="mt-5 text-5xl font-bold leading-[1.04] tracking-tight text-gray-900 dark:text-white sm:text-6xl">
          A little about me.
        </h1>
        <p class="mt-6 max-w-2xl text-xl font-semibold leading-8 text-gray-900 dark:text-gray-100 sm:text-2xl sm:leading-9">
          I enjoy helping people navigate complex situations and exploring new possibilities.
        </p>
        <p class="mt-5 max-w-2xl text-lg leading-8 text-gray-700 dark:text-gray-300">
          I'm Dan, based in Madison, Wisconsin. My work includes executive assistance and daily money management, grounded in years of experience coordinating people, information, and everyday responsibilities.
        </p>
        <p class="mt-4 max-w-2xl text-lg leading-8 text-gray-700 dark:text-gray-300">
          I'm also an artist and a builder of digital projects. I'm interested in how technology, including AI, can help people create, work, and connect in better ways.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a
            href="/contact/"
            class="inline-flex min-h-12 items-center justify-center rounded-lg bg-blue-700 px-6 py-3 font-semibold text-white transition-colors hover:bg-blue-800 hover:text-white focus-visible:outline focus-visible:outline-4 focus-visible:outline-offset-2 focus-visible:outline-blue-600 dark:bg-blue-500 dark:text-gray-950 dark:hover:bg-blue-400 dark:hover:text-gray-950"
          >
            Get in touch
            <span class="ml-2" aria-hidden="true">→</span>
          </a>
          <a
            href="/projects/"
            class="inline-flex min-h-12 items-center justify-center rounded-lg border border-gray-300 bg-white px-6 py-3 font-semibold text-gray-900 transition-colors hover:border-blue-500 hover:text-blue-700 focus-visible:outline focus-visible:outline-4 focus-visible:outline-offset-2 focus-visible:outline-blue-600 dark:border-gray-700 dark:bg-gray-900 dark:text-gray-100 dark:hover:border-blue-400 dark:hover:text-blue-300"
          >
            Explore projects
          </a>
        </div>
      </div>
      <figure class="mx-auto w-full max-w-[280px] sm:max-w-[320px] lg:justify-self-end">
        <div class="overflow-hidden rounded-[2rem] border border-gray-200 bg-gray-100 shadow-lg shadow-gray-200/60 dark:border-gray-700 dark:bg-gray-800 dark:shadow-black/20">
          <img
            src="/images/dan-ryan-neff.webp"
            alt="Dan Ryan Neff outdoors"
            class="aspect-[4/5] w-full object-cover object-center"
            width="640"
            height="800"
            loading="eager"
            decoding="async"
          />
        </div>
      </figure>
    </div>
  </section>

  <!-- Relevant experience, without a long resume or an abstract manifesto. -->
  <section class="border-b border-gray-200 bg-gray-50 dark:border-gray-800 dark:bg-gray-950" aria-labelledby="experience-heading">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:px-8 lg:py-20">
      <p class="text-sm font-semibold uppercase tracking-[0.18em] text-blue-700 dark:text-blue-400">Professional background</p>
      <h2 id="experience-heading" class="mt-3 text-3xl font-bold tracking-tight text-gray-900 dark:text-white sm:text-4xl">
        Work shaped by people and practical details.
      </h2>
      <p class="mt-4 max-w-3xl text-lg leading-8 text-gray-700 dark:text-gray-300">
        My experience has taken different forms, but much of it comes down to making complicated responsibilities more manageable and working well with the people involved.
      </p>
      <div class="mt-9 grid gap-5 md:grid-cols-3">
        {experience.map((item) => (
          <article class="rounded-2xl border border-gray-200 bg-white p-6 shadow-sm dark:border-gray-800 dark:bg-gray-900 sm:p-7">
            <h3 class="text-xl font-bold text-gray-900 dark:text-white">{item.title}</h3>
            <p class="mt-4 text-base leading-7 text-gray-700 dark:text-gray-300">{item.description}</p>
            {item.title === "Daily money management" && (
              <a href="/dmm/" class="mt-5 inline-flex font-semibold text-blue-700 underline-offset-4 hover:underline dark:text-blue-400">
                Learn about this service <span class="ml-2" aria-hidden="true">→</span>
              </a>
            )}
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Room for personality and ambition, with a clear route to the projects. -->
  <section class="border-b border-gray-200 bg-white dark:border-gray-800 dark:bg-gray-900" aria-labelledby="creative-heading">
    <div class="mx-auto grid max-w-6xl items-center gap-10 px-4 py-16 sm:px-6 lg:grid-cols-[minmax(0,1.25fr)_minmax(230px,0.75fr)] lg:gap-16 lg:px-8 lg:py-20">
      <div class="max-w-3xl">
        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-blue-700 dark:text-blue-400">Creative work and technology</p>
        <h2 id="creative-heading" class="mt-3 text-3xl font-bold tracking-tight text-gray-900 dark:text-white sm:text-4xl">
          I'm curious about what else we can make and do.
        </h2>
        <p class="mt-5 text-lg leading-8 text-gray-700 dark:text-gray-300">
          I create artwork, experiment with websites and digital tools, and keep learning about emerging technology. AI is an important part of that exploration, but so are design, accessibility, and the experience of the people using what we build.
        </p>
        <p class="mt-4 text-lg leading-8 text-gray-700 dark:text-gray-300">
          This website is a home base for those projects and for the people and opportunities they may bring into my life. Some may become businesses; others are worth exploring because they are interesting or useful.
        </p>
        <a href="/projects/" class="mt-7 inline-flex font-semibold text-blue-700 underline-offset-4 hover:underline dark:text-blue-400">
          See what I'm creating <span class="ml-2" aria-hidden="true">→</span>
        </a>
      </div>
      <figure class="mx-auto w-full max-w-xs sm:max-w-sm lg:justify-self-end" aria-hidden="true">
        <img
          src="/images/dot-compilation.webp"
          alt=""
          class="h-auto w-full"
          width="800"
          height="800"
          loading="lazy"
          decoding="async"
        />
      </figure>
    </div>
  </section>

  <!-- A relationship-oriented invitation, aligned with the new Contact page. -->
  <section class="bg-gray-50 dark:bg-gray-950" aria-labelledby="connect-heading">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:px-8 lg:py-20">
      <div class="rounded-3xl border border-gray-200 bg-white px-6 py-10 dark:border-gray-800 dark:bg-gray-900 sm:px-10 sm:py-12 lg:px-12">
        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-blue-700 dark:text-blue-400">Let's connect</p>
        <h2 id="connect-heading" class="mt-3 text-3xl font-bold tracking-tight text-gray-900 dark:text-white sm:text-4xl">
          Good work often starts with a conversation.
        </h2>
        <p class="mt-5 max-w-3xl text-lg leading-8 text-gray-700 dark:text-gray-300">
          If you need practical help, see a possibility for collaboration, or just think we should meet, I'd be glad to hear from you.
        </p>
        <div class="mt-7 flex flex-wrap gap-3">
          <a
            href="/contact/"
            class="inline-flex min-h-12 items-center justify-center rounded-lg bg-blue-700 px-6 py-3 font-semibold text-white transition-colors hover:bg-blue-800 hover:text-white focus-visible:outline focus-visible:outline-4 focus-visible:outline-offset-2 focus-visible:outline-blue-600 dark:bg-blue-500 dark:text-gray-950 dark:hover:bg-blue-400 dark:hover:text-gray-950"
          >
            Start a conversation <span class="ml-2" aria-hidden="true">→</span>
          </a>
          <a
            href="mailto:danryanneff@gmail.com"
            class="inline-flex min-h-12 items-center justify-center rounded-lg border border-gray-300 bg-white px-6 py-3 font-semibold text-gray-900 transition-colors hover:border-blue-500 hover:text-blue-700 focus-visible:outline focus-visible:outline-4 focus-visible:outline-offset-2 focus-visible:outline-blue-600 dark:border-gray-700 dark:bg-gray-900 dark:text-gray-100 dark:hover:border-blue-400 dark:hover:text-blue-300"
          >
            Email Dan directly
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
