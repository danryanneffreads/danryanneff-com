---
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  SITE_NAME,
  OG_IMAGE,
} from '../lib/constants';

const pageTitle = `About | ${SITE_NAME}`;

const pageDescription =
  'About Dan Ryan Neff and his exploration of human capability, technology, accessibility, organizations, creativity, and the environments people inhabit.';

const interests = [
  {
    title: 'People and participation',
    description:
      'I pay attention to what helps people enter, navigate, contribute to, and feel at home in organizations, communities, and digital environments.',
  },
  {
    title: 'Technology and judgment',
    description:
      'I am interested in how technology expands what people can do, but also in how it shapes attention, confidence, dependence, decision-making, and the choices available to us.',
  },
  {
    title: 'Organizations and systems',
    description:
      'I tend to look beneath isolated problems toward the relationships among people, processes, tools, expectations, incentives, and the surrounding environment.',
  },
  {
    title: 'Creativity and learning',
    description:
      'I like following questions, experimenting with unfamiliar tools, building things, and finding ways to support curiosity, expression, understanding, and meaningful participation.',
  },
];

const experience = [
  {
    title: 'Operations and leadership',
    description:
      'More than two decades inside organizations taught me to see work as a living system. I learned to coordinate people, processes, information, expectations, and changing conditions while keeping the human consequences of decisions in view.',
  },
  {
    title: 'Accessibility',
    description:
      'Accessibility has made the importance of context impossible to ignore. A tool that is unnecessary for one person may be profoundly enabling for another, and thoughtful design often improves an experience for everyone.',
  },
  {
    title: 'Websites and digital places',
    description:
      'Building websites and digital projects has led me to think of the internet as a place people inhabit. Websites and platforms shape identity, access, attention, belonging, and what people believe they are able to do.',
  },
  {
    title: 'Artificial intelligence',
    description:
      'AI has expanded how I learn, reason, create, and build. It has also made questions about judgment, authorship, dependence, inequality, attention, environmental impact, and human capability more urgent.',
  },
];

const principles = [
  'Technology should expand human capability without diminishing human life.',
  'Accessibility is not a separate feature. It is part of whether people can participate at all.',
  'Efficiency matters, but it is not the same as effectiveness, wisdom, or care.',
  'Digital environments deserve the same thoughtful stewardship as physical ones.',
  'Good judgment depends on context, consequences, and the people affected.',
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  ogTitle={pageTitle}
  ogDescription={pageDescription}
  ogImage={OG_IMAGE}
>
  <!-- Hero -->
  <section
    class="relative overflow-hidden border-b border-gray-200 bg-white dark:border-gray-800 dark:bg-gray-900"
  >
    <div
      class="pointer-events-none absolute inset-0"
      aria-hidden="true"
    >
      <div
        class="absolute -right-32 top-8 h-96 w-96 rounded-full bg-indigo-100/70 blur-3xl dark:bg-indigo-900/20"
      >
      </div>

      <div
        class="absolute -left-24 bottom-0 h-72 w-72 rounded-full bg-blue-100/60 blur-3xl dark:bg-blue-900/20"
      >
      </div>
    </div>

    <div
      class="relative mx-auto grid max-w-6xl items-center gap-12 px-4 py-20 sm:px-6 sm:py-28 lg:grid-cols-[minmax(0,1fr)_320px] lg:gap-16 lg:px-8 lg:py-32"
    >
      <div class="max-w-4xl">
        <p
          class="text-sm font-semibold uppercase tracking-[0.18em] text-blue-600 dark:text-blue-400"
        >
          About
        </p>

        <h1
          class="mt-6 text-5xl font-bold leading-[1.06] tracking-tight text-gray-900 dark:text-white sm:text-6xl"
        >
          I am interested in what helps people become more capable.
        </h1>

        <div
          class="mt-8 max-w-3xl space-y-5 text-lg leading-8 text-gray-600 dark:text-gray-300 sm:text-xl"
        >
          <p>
            I’m Dan Ryan Neff. My work and interests move among organizations,
            technology, accessibility, creativity, learning, health, and the
            physical and digital environments people inhabit.
          </p>

          <p>
            The connection among them is a question I keep returning to: what
            helps people learn, create, participate, contribute, and live more
            fully?
          </p>
        </div>
      </div>

      <figure class="mx-auto w-full max-w-xs lg:mx-0 lg:justify-self-end">
        <div
          class="overflow-hidden rounded-[2rem] border border-gray-200 bg-gray-100 shadow-lg shadow-gray-200/60 dark:border-gray-700 dark:bg-gray-800 dark:shadow-black/20"
        >
          <img
            src="/images/dan-ryan-neff.webp"
            alt="Dan Ryan Neff outdoors"
            class="aspect-[4/5] w-full object-cover object-center"
            width="640"
            height="800"
            loading="eager"
            decoding="async"
          />
        </div>

        <figcaption
          class="mt-4 text-center text-sm text-gray-500 dark:text-gray-400 lg:text-left"
        >
          Dan Ryan Neff
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- Personal orientation -->
  <section class="bg-white dark:bg-gray-900">
    <div
      class="mx-auto grid max-w-6xl gap-8 px-4 py-20 sm:px-6 lg:grid-cols-[0.42fr_1fr] lg:px-8 lg:py-28"
    >
      <div>
        <p
          class="text-sm font-semibold uppercase tracking-[0.18em] text-blue-600 dark:text-blue-400"
        >
          How I see the work
        </p>
      </div>

      <div class="max-w-3xl">
        <p
          class="text-3xl font-semibold leading-tight tracking-tight text-gray-900 dark:text-white sm:text-4xl"
        >
          People do not become capable through effort alone.
        </p>

        <div
          class="mt-8 space-y-5 text-lg leading-8 text-gray-600 dark:text-gray-300"
        >
          <p>
            Capability is shaped by access, health, confidence, knowledge,
            relationships, tools, institutions, habits, and the design of the
            environments around us.
          </p>

          <p>
            A useful technology can extend perception, communication, memory,
            creativity, or movement. A good organization can help people
            coordinate their abilities and accomplish what no individual could
            do alone. A thoughtfully designed environment can turn frustration,
            exclusion, or confusion into participation.
          </p>

          <p>
            Those same systems can also diminish people. They can weaken
            judgment, exhaust attention, obscure responsibility, create
            dependency, or make participation unnecessarily difficult.
          </p>

          <p class="font-medium text-gray-900 dark:text-white">
            I am interested in the choices that determine which direction we
            move.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- What I pay attention to -->
  <section
    class="border-y border-gray-200 bg-gray-50 dark:border-gray-800 dark:bg-gray-950"
  >
    <div
      class="mx-auto max-w-6xl px-4 py-20 sm:px-6 lg:px-8 lg:py-28"
    >
      <div class="max-w-3xl">
        <p
          class="text-sm font-semibold uppercase tracking-[0.18em] text-blue-600 dark:text-blue-400"
        >
          What I pay attention to
        </p>

        <h2
          class="mt-5 text-4xl font-bold tracking-tight text-gray-900 dark:text-white sm:text-5xl"
        >
          The conditions beneath the visible experience.
        </h2>

        <p
          class="mt-6 text-lg leading-8 text-gray-600 dark:text-gray-300"
        >
          I tend to look past the surface of a problem and ask what is making
          the current situation possible.
        </p>
      </div>

      <div class="mt-14 grid gap-6 md:grid-cols-2">
        {
          interests.map((interest) => (
            <article
              class="rounded-2xl border border-gray-200 bg-white p-7 dark:border-gray-800 dark:bg-gray-900 sm:p-8"
            >
              <h3
                class="text-xl font-bold text-gray-900 dark:text-white"
              >
                {interest.title}
              </h3>

              <p
                class="mt-4 leading-7 text-gray-600 dark:text-gray-300"
              >
                {interest.description}
              </p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Patterns and environments -->
  <section class="overflow-hidden bg-white dark:bg-gray-900">
    <div
      class="mx-auto grid max-w-6xl items-center gap-12 px-4 py-20 sm:px-6 lg:grid-cols-[0.9fr_1.1fr] lg:px-8 lg:py-28"
    >
      <div
        class="rounded-3xl border border-gray-200 bg-gray-50 p-6 dark:border-gray-800 dark:bg-gray-950 sm:p-8"
      >
        <img
          src="/images/SubtleCircles.webp"
          alt="An abstract composition of circles, paths, and connected forms"
          class="mx-auto w-full max-w-xl"
          width="1200"
          height="675"
          loading="lazy"
          decoding="async"
        />
      </div>

      <div>
        <p
          class="text-sm font-semibold uppercase tracking-[0.18em] text-blue-600 dark:text-blue-400"
        >
          Patterns and environments
        </p>

        <h2
          class="mt-5 text-4xl font-bold tracking-tight text-gray-900 dark:text-white sm:text-5xl"
        >
          I like making relationships easier to see.
        </h2>

        <div
          class="mt-7 space-y-5 text-lg leading-8 text-gray-600 dark:text-gray-300"
        >
          <p>
            In organizations, I notice handoffs, responsibilities, informal
            expectations, bottlenecks, incentives, and the gaps between how work
            is described and how it actually happens.
          </p>

          <p>
            In physical environments, I notice paths, boundaries, gathering
            places, natural patterns, and the ways design guides movement and
            behavior.
          </p>

          <p>
            I bring the same attention to digital places. Websites, platforms,
            feeds, interfaces, and AI systems also contain pathways, barriers,
            defaults, incentives, and assumptions about the people using them.
          </p>

          <p>
            Sometimes I build within these systems. Sometimes I organize them.
            Sometimes I help someone see the situation clearly enough to decide
            what should change.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Experience -->
  <section
    class="border-y border-gray-200 bg-gray-50 dark:border-gray-800 dark:bg-gray-950"
  >
    <div
      class="mx-auto max-w-6xl px-4 py-20 sm:px-6 lg:px-8 lg:py-28"
    >
      <div class="grid gap-12 lg:grid-cols-[0.55fr_1fr]">
        <div>
          <p
            class="text-sm font-semibold uppercase tracking-[0.18em] text-blue-600 dark:text-blue-400"
          >
            Experience
          </p>

          <h2
            class="mt-5 text-4xl font-bold tracking-tight text-gray-900 dark:text-white sm:text-5xl"
          >
            Different kinds of work have shaped the same way of thinking.
          </h2>

          <p
            class="mt-6 text-lg leading-8 text-gray-600 dark:text-gray-300"
          >
            My perspective comes less from one discipline than from years spent
            moving among people, processes, tools, and real-world constraints.
          </p>
        </div>

        <div class="border-t border-gray-300 dark:border-gray-700">
          {
            experience.map((item, index) => (
              <article
                class="grid gap-4 border-b border-gray-300 py-8 dark:border-gray-700 sm:grid-cols-[3rem_1fr]"
              >
                <span
                  class="pt-1 font-mono text-xs text-gray-400 dark:text-gray-500"
                >
                  {String(index + 1).padStart(2, '0')}
                </span>

                <div>
                  <h3
                    class="text-2xl font-bold text-gray-900 dark:text-white"
                  >
                    {item.title}
                  </h3>

                  <p
                    class="mt-4 max-w-2xl leading-7 text-gray-600 dark:text-gray-300"
                  >
                    {item.description}
                  </p>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- Principles -->
  <section class="bg-gray-900 text-white dark:bg-black">
    <div
      class="mx-auto grid max-w-6xl gap-12 px-4 py-20 sm:px-6 lg:grid-cols-[0.62fr_1fr] lg:px-8 lg:py-28"
    >
      <div>
        <p
          class="text-sm font-semibold uppercase tracking-[0.18em] text-blue-400"
        >
          Principles
        </p>

        <h2
          class="mt-5 text-4xl font-bold tracking-tight sm:text-5xl"
        >
          A few ideas guide how I think and work.
        </h2>
      </div>

      <ol class="border-t border-gray-700">
        {
          principles.map((principle, index) => (
            <li
              class="grid grid-cols-[2rem_1fr] gap-4 border-b border-gray-700 py-6 sm:grid-cols-[3rem_1fr]"
            >
              <span class="pt-1 font-mono text-xs text-gray-500">
                {String(index + 1).padStart(2, '0')}
              </span>

              <p class="text-xl leading-8 text-gray-200 sm:text-2xl">
                {principle}
              </p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Projects connection -->
  <section class="bg-white dark:bg-gray-900">
    <div
      class="mx-auto grid max-w-6xl items-center gap-12 px-4 py-20 sm:px-6 lg:grid-cols-[1fr_0.8fr] lg:px-8 lg:py-28"
    >
      <div class="max-w-3xl">
        <p
          class="text-sm font-semibold uppercase tracking-[0.18em] text-blue-600 dark:text-blue-400"
        >
          How I explore
        </p>

        <h2
          class="mt-5 text-4xl font-bold tracking-tight text-gray-900 dark:text-white sm:text-5xl"
        >
          I learn by building, observing, and following questions.
        </h2>

        <div
          class="mt-7 space-y-5 text-lg leading-8 text-gray-600 dark:text-gray-300"
        >
          <p>
            Mandalafy explores creativity, attention, symmetry, play, and the
            experience of making.
          </p>

          <p>
            LandingBio explores identity, connection, and how people represent
            themselves online.
          </p>

          <p>
            ImagineThis.Site explores learning, expression, and helping people
            imagine and build a place of their own on the web.
          </p>

          <p>
            The projects are different, but each gives me a way to examine how
            tools and environments affect what people can create, understand,
            and share.
          </p>
        </div>

        <a
          href="/projects/"
          class="mt-9 inline-flex items-center rounded-lg bg-blue-600 px-6 py-3 font-medium text-white transition-colors hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 dark:focus:ring-offset-gray-900"
        >
          Explore the projects
          <span class="ml-2" aria-hidden="true">→</span>
        </a>
      </div>

      <div class="flex justify-center lg:justify-end">
        <img
          src="/images/dot-compilation.webp"
          alt="A colorful collection of connected circular illustrations"
          class="w-full max-w-md"
          width="800"
          height="800"
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>
  </section>

  <!-- Invitation -->
  <section
    class="border-t border-gray-200 bg-gray-50 dark:border-gray-800 dark:bg-gray-950"
  >
    <div
      class="mx-auto max-w-6xl px-4 py-20 sm:px-6 lg:px-8 lg:py-28"
    >
      <div
        class="rounded-3xl border border-gray-200 bg-white px-6 py-14 dark:border-gray-800 dark:bg-gray-900 sm:px-10 lg:px-14 lg:py-20"
      >
        <div class="max-w-4xl">
          <p
            class="text-sm font-semibold uppercase tracking-[0.18em] text-blue-600 dark:text-blue-400"
          >
            Continue the conversation
          </p>

          <h2
            class="mt-5 text-4xl font-bold tracking-tight text-gray-900 dark:text-white sm:text-5xl"
          >
            I welcome thoughtful conversations about people, systems, and
            possibility.
          </h2>

          <p
            class="mt-6 max-w-3xl text-lg leading-8 text-gray-600 dark:text-gray-300"
          >
            You may be building something, navigating change, trying to
            understand a complicated situation, or exploring questions similar
            to mine.
          </p>

          <a
            href="/contact/"
            class="mt-9 inline-flex items-center rounded-lg bg-blue-600 px-6 py-3 font-medium text-white transition-colors hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 dark:focus:ring-offset-gray-900"
          >
            Start a conversation
            <span class="ml-2" aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>