---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE_NAME, OG_IMAGE } from "../lib/constants";

const projects = [
  {
    title: "Mandalafy",
    category: "Interactive creativity",
    introduction:
      "Mandalafy is a guided creative tool for making a mandala one choice at a time.",
    body: [
      "Mandalas combine structure with freedom. Every choice influences the whole, yet the finished design can still feel surprising and distinctly your own.",
      "I created Mandalafy to make that kind of creative experience approachable. Rather than beginning with a blank canvas, you choose colors, shapes, patterns, and arrangements as the design gradually emerges.",
      "The experience provides a framework without taking over the creative decisions. You can experiment, revise, and watch the composition change through your participation.",
      "When the design is finished, you can save it or choose to place it on a product. Making the mandala is free, and buying something is entirely optional. The creative process comes first.",
    ],
    image: "/images/mandala-woven-sunlight-660.webp",
    imageAlt:
      "A colorful geometric mandala created with the Mandalafy design tool",
    href: "/mandalafy/",
    linkLabel: "Explore Mandalafy",
    accent: "Art, attention, and play",
  },
  {
    title: "LandingBio",
    category: "Personal websites",
    introduction:
      "LandingBio grew from a simple question: what if everyone had a thoughtful home on the web?",
    body: [
      "Most people now have an online presence, but much of it exists inside platforms built around feeds, follower counts, reactions, and continual posting.",
      "LandingBio offers a different model: a personal website organized around who you are, what you do, what matters to you, and what you want others to find.",
      "It can support professional work, creative projects, community involvement, personal interests, or simply a more intentional introduction to yourself.",
      "There is no social feed to maintain and no audience metric to chase. The goal is to help people create a digital place that feels more stable, personal, and genuinely their own.",
    ],
    image: "/images/dot-compilation.webp",
    imageAlt:
      "An abstract composition of colorful dots and connected forms",
    href: "/landingbio/",
    linkLabel: "Explore LandingBio",
    accent: "Identity, presence, and connection",
  },
  {
    title: "ImagineThis.Site",
    category: "Website ideas and guides",
    introduction:
      "Many people know they need a website long before they know what that website should become.",
    body: [
      "ImagineThis.Site explores that gap through concept websites, practical guides, and small experiments in digital design.",
      "The concept sites imagine fictional businesses, organizations, places, events, and services. By giving an idea a visual form, they make it easier to see how different choices might shape the experience.",
      "The guides help people think through questions such as what a website needs to accomplish, what visitors need to understand, which tools may fit, and how the finished site should feel.",
      "The project is both practical and imaginative: a place to learn about websites while also seeing what becomes possible when an idea is developed with care.",
    ],
    image: "/images/VividRhythms.webp",
    imageAlt:
      "An expressive abstract artwork with layered shapes and vivid visual rhythms",
    href: "/imaginethis-site/",
    linkLabel: "Explore ImagineThis.Site",
    accent: "Websites, imagination, and possibility",
  },
];

const pageTitle = `Projects | ${SITE_NAME}`;

const pageDescription =
  "Explore Mandalafy, LandingBio, and ImagineThis.Site—creative and practical projects by Dan Ryan Neff involving art, personal websites, digital identity, and thoughtful web design.";
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  ogTitle={pageTitle}
  ogDescription={pageDescription}
  ogImage={OG_IMAGE}
>
  <!-- Hero -->
  <section
    class="relative overflow-hidden border-b border-gray-200 bg-white dark:border-gray-800 dark:bg-gray-900"
  >
    <div class="pointer-events-none absolute inset-0" aria-hidden="true">
      <div
        class="absolute -right-32 top-8 h-96 w-96 rounded-full bg-blue-100/70 blur-3xl dark:bg-blue-900/20"
      >
      </div>

      <div
        class="absolute -left-24 bottom-0 h-72 w-72 rounded-full bg-indigo-100/60 blur-3xl dark:bg-indigo-900/20"
      >
      </div>
    </div>

    <div
      class="relative mx-auto max-w-6xl px-4 py-20 sm:px-6 sm:py-28 lg:px-8 lg:py-32"
    >
      <div class="max-w-4xl">
        <p
          class="text-sm font-semibold uppercase tracking-[0.18em] text-blue-600 dark:text-blue-400"
        >
          Projects
        </p>

        <h1
          class="mt-6 text-5xl font-bold leading-[1.04] tracking-tight text-gray-900 dark:text-white sm:text-6xl lg:text-7xl"
        >
          Projects are one way I explore ideas.
        </h1>

        <div
          class="mt-8 max-w-3xl space-y-5 text-lg leading-8 text-gray-600 dark:text-gray-300 sm:text-xl"
        >
          <p>
            Some questions are easiest to explore by making something.
          </p>

          <p>
            These projects combine curiosity, design, technology, creativity,
            and practical problem solving. Some are tools. Some are
            experiments. Each continues to evolve as I learn.
          </p>

          <p>
            Together, they show where several of my interests have taken
            concrete form.
          </p>
        </div>

        <div class="mt-10 flex flex-wrap gap-4">
          <a
            href="#mandalafy"
            class="inline-flex items-center rounded-lg bg-blue-600 px-6 py-3 font-medium text-white transition-colors hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 dark:focus:ring-offset-gray-900"
          >
            Explore the projects
            <span class="ml-2" aria-hidden="true">↓</span>
          </a>

          <a
            href="/contact/"
            class="inline-flex items-center rounded-lg border border-gray-300 bg-white px-6 py-3 font-medium text-gray-800 transition-colors hover:border-blue-500 hover:text-blue-600 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 dark:border-gray-700 dark:bg-gray-900 dark:text-gray-200 dark:hover:border-blue-400 dark:hover:text-blue-400 dark:focus:ring-offset-gray-900"
          >
            Start a conversation
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Project overview -->
  <section class="bg-white dark:bg-gray-900">
    <div
      class="mx-auto grid max-w-6xl gap-8 px-4 py-20 sm:px-6 lg:grid-cols-[0.42fr_1fr] lg:px-8 lg:py-28"
    >
      <div>
        <p
          class="text-sm font-semibold uppercase tracking-[0.18em] text-blue-600 dark:text-blue-400"
        >
          The workshop
        </p>
      </div>

      <div class="max-w-3xl">
        <h2
          class="text-3xl font-semibold leading-tight tracking-tight text-gray-900 dark:text-white sm:text-4xl"
        >
          Each project began with something I wanted to understand, improve, or
          bring into existence.
        </h2>

        <div
          class="mt-8 space-y-5 text-lg leading-8 text-gray-600 dark:text-gray-300"
        >
          <p>
            Mandalafy explores guided creativity. LandingBio explores identity
            and personal presence online. ImagineThis.Site explores how ideas
            become useful, expressive websites.
          </p>

          <p>
            They are different projects, but they share an approach: start with
            a worthwhile question, make something real, pay attention to what
            happens, and continue refining the idea.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Mandalafy -->
  <section
    id="mandalafy"
    class="scroll-mt-24 border-y border-gray-200 bg-gray-50 dark:border-gray-800 dark:bg-gray-950"
  >
    <div
      class="mx-auto grid max-w-6xl items-center gap-12 px-4 py-20 sm:px-6 lg:grid-cols-[1fr_0.88fr] lg:gap-20 lg:px-8 lg:py-28"
    >
      <div>
        <p
          class="text-sm font-semibold uppercase tracking-[0.18em] text-blue-600 dark:text-blue-400"
        >
          {projects[0].category}
        </p>

        <h2
          class="mt-5 text-4xl font-bold tracking-tight text-gray-900 dark:text-white sm:text-5xl"
        >
          {projects[0].title}
        </h2>

        <p
          class="mt-6 text-xl font-medium leading-8 text-gray-900 dark:text-white"
        >
          {projects[0].introduction}
        </p>

        <div
          class="mt-7 space-y-5 text-lg leading-8 text-gray-600 dark:text-gray-300"
        >
          {
            projects[0].body.map((paragraph) => (
              <p>{paragraph}</p>
            ))
          }
        </div>

        <div class="mt-9">
          <a
            href={projects[0].href}
            class="inline-flex items-center rounded-lg bg-blue-600 px-6 py-3 font-medium text-white transition-colors hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 dark:focus:ring-offset-gray-950"
          >
            {projects[0].linkLabel}
            <span class="ml-2" aria-hidden="true">→</span>
          </a>
        </div>
      </div>

      <figure>
        <div
          class="overflow-hidden rounded-3xl border border-gray-200 bg-white p-4 shadow-sm dark:border-gray-800 dark:bg-gray-900 sm:p-6"
        >
          <img
            src={projects[0].image}
            alt={projects[0].imageAlt}
            class="mx-auto aspect-square w-full max-w-lg rounded-2xl object-cover"
            width="660"
            height="660"
            loading="lazy"
            decoding="async"
          />
        </div>

        <figcaption
          class="mt-4 text-center text-sm text-gray-500 dark:text-gray-400"
        >
          {projects[0].accent}
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- LandingBio -->
  <section
    id="landingbio"
    class="scroll-mt-24 bg-white dark:bg-gray-900"
  >
    <div
      class="mx-auto grid max-w-6xl items-center gap-12 px-4 py-20 sm:px-6 lg:grid-cols-[0.88fr_1fr] lg:gap-20 lg:px-8 lg:py-28"
    >
      <figure class="order-2 lg:order-1">
        <div
          class="overflow-hidden rounded-3xl border border-gray-200 bg-gray-50 p-5 dark:border-gray-800 dark:bg-gray-950 sm:p-8"
        >
          <img
            src={projects[1].image}
            alt={projects[1].imageAlt}
            class="mx-auto w-full max-w-lg"
            width="800"
            height="800"
            loading="lazy"
            decoding="async"
          />
        </div>

        <figcaption
          class="mt-4 text-center text-sm text-gray-500 dark:text-gray-400"
        >
          {projects[1].accent}
        </figcaption>
      </figure>

      <div class="order-1 lg:order-2">
        <p
          class="text-sm font-semibold uppercase tracking-[0.18em] text-blue-600 dark:text-blue-400"
        >
          {projects[1].category}
        </p>

        <h2
          class="mt-5 text-4xl font-bold tracking-tight text-gray-900 dark:text-white sm:text-5xl"
        >
          {projects[1].title}
        </h2>

        <p
          class="mt-6 text-xl font-medium leading-8 text-gray-900 dark:text-white"
        >
          {projects[1].introduction}
        </p>

        <div
          class="mt-7 space-y-5 text-lg leading-8 text-gray-600 dark:text-gray-300"
        >
          {
            projects[1].body.map((paragraph) => (
              <p>{paragraph}</p>
            ))
          }
        </div>

        <div class="mt-9">
          <a
            href={projects[1].href}
            class="inline-flex items-center rounded-lg bg-blue-600 px-6 py-3 font-medium text-white transition-colors hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 dark:focus:ring-offset-gray-900"
          >
            {projects[1].linkLabel}
            <span class="ml-2" aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ImagineThis.Site -->
  <section
    id="imaginethis-site"
    class="scroll-mt-24 border-y border-gray-200 bg-gray-50 dark:border-gray-800 dark:bg-gray-950"
  >
    <div
      class="mx-auto grid max-w-6xl items-center gap-12 px-4 py-20 sm:px-6 lg:grid-cols-[1fr_0.88fr] lg:gap-20 lg:px-8 lg:py-28"
    >
      <div>
        <p
          class="text-sm font-semibold uppercase tracking-[0.18em] text-blue-600 dark:text-blue-400"
        >
          {projects[2].category}
        </p>

        <h2
          class="mt-5 text-4xl font-bold tracking-tight text-gray-900 dark:text-white sm:text-5xl"
        >
          {projects[2].title}
        </h2>

        <p
          class="mt-6 text-xl font-medium leading-8 text-gray-900 dark:text-white"
        >
          {projects[2].introduction}
        </p>

        <div
          class="mt-7 space-y-5 text-lg leading-8 text-gray-600 dark:text-gray-300"
        >
          {
            projects[2].body.map((paragraph) => (
              <p>{paragraph}</p>
            ))
          }
        </div>

        <div class="mt-9">
          <a
            href={projects[2].href}
            class="inline-flex items-center rounded-lg bg-blue-600 px-6 py-3 font-medium text-white transition-colors hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 dark:focus:ring-offset-gray-950"
          >
            {projects[2].linkLabel}
            <span class="ml-2" aria-hidden="true">→</span>
          </a>
        </div>
      </div>

      <figure>
        <div
          class="overflow-hidden rounded-3xl border border-gray-200 bg-white p-5 shadow-sm dark:border-gray-800 dark:bg-gray-900 sm:p-8"
        >
          <img
            src={projects[2].image}
            alt={projects[2].imageAlt}
            class="mx-auto w-full max-w-lg rounded-2xl"
            width="1200"
            height="900"
            loading="lazy"
            decoding="async"
          />
        </div>

        <figcaption
          class="mt-4 text-center text-sm text-gray-500 dark:text-gray-400"
        >
          {projects[2].accent}
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- Future projects -->
  <section class="bg-white dark:bg-gray-900">
    <div
      class="mx-auto grid max-w-6xl gap-8 px-4 py-20 sm:px-6 lg:grid-cols-[0.42fr_1fr] lg:px-8 lg:py-28"
    >
      <div>
        <p
          class="text-sm font-semibold uppercase tracking-[0.18em] text-blue-600 dark:text-blue-400"
        >
          What comes next
        </p>
      </div>

      <div class="max-w-3xl">
        <h2
          class="text-3xl font-semibold leading-tight tracking-tight text-gray-900 dark:text-white sm:text-4xl"
        >
          There will always be another project.
        </h2>

        <div
          class="mt-8 space-y-5 text-lg leading-8 text-gray-600 dark:text-gray-300"
        >
          <p>
            Some ideas become websites. Others become tools, conversations,
            essays, artwork, resources, or entirely new directions I have not
            anticipated yet.
          </p>

          <p>
            This collection reflects where my curiosity has led so far—not
            where it ends.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Invitation -->
  <section
    class="border-t border-gray-200 bg-gray-50 dark:border-gray-800 dark:bg-gray-950"
  >
    <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 lg:px-8 lg:py-28">
      <div
        class="rounded-3xl border border-gray-200 bg-white px-6 py-14 dark:border-gray-800 dark:bg-gray-900 sm:px-10 lg:px-14 lg:py-20"
      >
        <div class="max-w-4xl">
          <p
            class="text-sm font-semibold uppercase tracking-[0.18em] text-blue-600 dark:text-blue-400"
          >
            Ideas can connect
          </p>

          <h2
            class="mt-5 text-4xl font-bold tracking-tight text-gray-900 dark:text-white sm:text-5xl"
          >
            A project may begin with one person’s question and grow through
            conversation.
          </h2>

          <p
            class="mt-6 max-w-3xl text-lg leading-8 text-gray-600 dark:text-gray-300"
          >
            Something here may connect with an idea you are developing, a
            challenge you are considering, or work you would like to bring into
            the world. I welcome thoughtful conversations and unexpected
            possibilities.
          </p>

          <a
            href="/contact/"
            class="mt-9 inline-flex items-center rounded-lg bg-blue-600 px-6 py-3 font-medium text-white transition-colors hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 dark:focus:ring-offset-gray-900"
          >
            Start a conversation
            <span class="ml-2" aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
