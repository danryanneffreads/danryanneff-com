---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE_NAME, OG_IMAGE } from "../lib/constants";

// Add another project here when it is ready to share.
// The cards below will automatically expand to include it.
const projects = [
  {
    id: "mandalafy",
    name: "Mandalafy",
    category: "Art & interactive creativity",
    headline: "Making mandalas more playful and personal.",
    description:
      "Mandalafy explores an inviting way to create mandalas through color, pattern, and experimentation.",
    detail:
      "I'm also interested in making it easy to turn a finished design into something tangible, such as a product you can enjoy or share.",
    image: "/images/mandala-woven-sunlight-660.webp",
    imageAlt: "Colorful geometric mandala with intricate radial patterns",
    imageWidth: 660,
    imageHeight: 660,
    href: "/mandalafy/",
    linkText: "Explore Mandalafy",
  },
  {
    id: "landingbio",
    name: "LandingBio",
    category: "Personal presence online",
    headline: "A more intentional home on the web.",
    description:
      "LandingBio considers how a personal website can introduce someone beyond a social profile or a stream of posts.",
    detail:
      "The idea is to help people show what matters to them and create clearer, more personal ways for others to connect.",
    image: "/images/dot-compilation.webp",
    imageAlt: "An abstract composition of colorful dots and connected forms",
    imageWidth: 800,
    imageHeight: 800,
    href: "/landingbio/",
    linkText: "Explore LandingBio",
  },
  {
    id: "imaginethis-site",
    name: "ImagineThis.Site",
    category: "Websites & imagination",
    headline: "Helping people picture what a website could be.",
    description:
      "ImagineThis.Site explores ideas through concept websites, visual examples, and practical guidance.",
    detail:
      "It's a place to experiment with how websites might look, feel, and work before committing to a particular direction.",
    image: "/images/VividRhythms.webp",
    imageAlt: "Expressive abstract artwork with vivid colors and layered forms",
    imageWidth: 1200,
    imageHeight: 900,
    href: "/imaginethis-site/",
    linkText: "Explore ImagineThis.Site",
  },
];

const pageTitle = `Projects | ${SITE_NAME}`;
const pageDescription =
  "Explore creative and digital projects by Dan Ryan Neff, including Mandalafy, LandingBio, and ImagineThis.Site, and get in touch about ideas or collaborations.";
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  ogTitle={pageTitle}
  ogDescription={pageDescription}
  ogImage={OG_IMAGE}
>
  <!-- A direct introduction instead of an extended explanation of the philosophy. -->
  <section
    class="relative overflow-hidden border-b border-gray-200 bg-white dark:border-gray-800 dark:bg-gray-900"
    aria-labelledby="projects-heading"
  >
    <div class="pointer-events-none absolute inset-0" aria-hidden="true">
      <div class="absolute -right-24 top-0 h-80 w-80 rounded-full bg-blue-100/70 blur-3xl dark:bg-blue-900/20"></div>
      <div class="absolute -left-24 bottom-0 h-64 w-64 rounded-full bg-indigo-100/60 blur-3xl dark:bg-indigo-900/20"></div>
    </div>

    <div class="relative mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20 lg:px-8 lg:py-24">
      <div class="max-w-3xl">
        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-blue-700 dark:text-blue-400">
          Creative &amp; digital work
        </p>
        <h1
          id="projects-heading"
          class="mt-5 text-5xl font-bold leading-[1.04] tracking-tight text-gray-900 dark:text-white sm:text-6xl"
        >
          Projects I'm building.
        </h1>
        <p class="mt-6 max-w-2xl text-xl font-semibold leading-8 text-gray-900 dark:text-gray-100 sm:text-2xl sm:leading-9">
          Art, technology, and ideas made tangible.
        </p>
        <p class="mt-5 max-w-2xl text-lg leading-8 text-gray-700 dark:text-gray-300">
          Some of these projects are creative experiences; others explore new ways to use the web. They continue to evolve as I learn and build.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a
            href="#project-list"
            class="inline-flex min-h-12 items-center justify-center rounded-lg bg-blue-700 px-6 py-3 font-semibold text-white transition-colors hover:bg-blue-800 focus-visible:outline focus-visible:outline-4 focus-visible:outline-offset-2 focus-visible:outline-blue-600 dark:bg-blue-500 dark:text-gray-950 dark:hover:bg-blue-400"
          >
            Explore the projects <span class="ml-2" aria-hidden="true">↓</span>
          </a>
          <a
            href="/contact/"
            class="inline-flex min-h-12 items-center justify-center rounded-lg border border-gray-300 bg-white px-6 py-3 font-semibold text-gray-900 transition-colors hover:border-blue-500 hover:text-blue-700 focus-visible:outline focus-visible:outline-4 focus-visible:outline-offset-2 focus-visible:outline-blue-600 dark:border-gray-700 dark:bg-gray-900 dark:text-gray-100 dark:hover:border-blue-400 dark:hover:text-blue-300"
          >
            Get in touch
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Compact project previews: artwork and description appear side by side on desktop. -->
  <section
    id="project-list"
    class="scroll-mt-24 border-b border-gray-200 bg-gray-50 dark:border-gray-800 dark:bg-gray-950"
    aria-label="Featured projects"
  >
    <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:px-8 lg:py-14">
      <div class="space-y-5">
        {projects.map((project) => (
          <article
            id={project.id}
            aria-labelledby={`${project.id}-heading`}
            class="project-card scroll-mt-24 overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-sm dark:border-gray-800 dark:bg-gray-900"
          >
            <div class="project-art bg-gray-100 dark:bg-gray-950">
              <img
                src={project.image}
                alt={project.imageAlt}
                width={project.imageWidth}
                height={project.imageHeight}
                loading="lazy"
                decoding="async"
                class="project-art-image"
              />
            </div>

            <div class="project-content">
              <p class="text-xs font-semibold uppercase tracking-[0.14em] text-blue-700 dark:text-blue-400 sm:text-sm">
                {project.category}
              </p>
              <h2
                id={`${project.id}-heading`}
                class="mt-2 text-3xl font-bold tracking-tight text-gray-900 dark:text-white"
              >
                {project.name}
              </h2>
              <p class="mt-3 text-lg font-semibold leading-7 text-gray-900 dark:text-gray-100">
                {project.headline}
              </p>
              <p class="mt-3 text-base leading-7 text-gray-700 dark:text-gray-300">
                {project.description}
              </p>
              <p class="mt-2 text-base leading-7 text-gray-700 dark:text-gray-300">
                {project.detail}
              </p>
              <a
                href={project.href}
                class="mt-5 inline-flex min-h-11 w-fit items-center font-semibold text-blue-700 underline-offset-4 hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-blue-600 dark:text-blue-400"
              >
                {project.linkText} <span class="ml-2" aria-hidden="true">→</span>
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Encourage a genuine interaction without promising a product or service not yet available. -->
  <section class="bg-white dark:bg-gray-900" aria-labelledby="project-contact-heading">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:px-8 lg:py-20">
      <div class="rounded-3xl border border-gray-200 bg-gray-50 px-6 py-10 dark:border-gray-800 dark:bg-gray-950 sm:px-10 sm:py-12">
        <div class="max-w-3xl">
          <p class="text-sm font-semibold uppercase tracking-[0.18em] text-blue-700 dark:text-blue-400">Let's connect</p>
          <h2 id="project-contact-heading" class="mt-3 text-3xl font-bold tracking-tight text-gray-900 dark:text-white sm:text-4xl">
            See something worth exploring together?
          </h2>
          <p class="mt-4 text-lg leading-8 text-gray-700 dark:text-gray-300">
            I'd welcome feedback, a fresh perspective, or a conversation about collaborating on one of these projects. New ideas are welcome, too.
          </p>
          <div class="mt-7 flex flex-wrap items-center gap-x-6 gap-y-3">
            <a
              href="/contact/"
              class="inline-flex min-h-12 items-center justify-center rounded-lg bg-blue-700 px-6 py-3 font-semibold text-white transition-colors hover:bg-blue-800 focus-visible:outline focus-visible:outline-4 focus-visible:outline-offset-2 focus-visible:outline-blue-600 dark:bg-blue-500 dark:text-gray-950 dark:hover:bg-blue-400"
            >
              Start a conversation
            </a>
            <a href="mailto:danryanneff@gmail.com" class="font-semibold text-blue-700 underline-offset-4 hover:underline dark:text-blue-400">
              Email me directly <span class="ml-1" aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Explicit CSS grid instead of a complex generated Tailwind grid class.
     This fixes the tall, full-width image panels in the desktop layout. */
  .project-card {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }

  .project-art {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 220px;
    padding: 24px;
    overflow: hidden;
  }

  .project-art-image {
    display: block;
    width: auto;
    height: auto;
    max-width: min(100%, 250px);
    max-height: 240px;
    object-fit: contain;
  }

  .project-content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-width: 0;
    padding: 26px;
  }

  @media (min-width: 640px) {
    .project-content {
      padding: 34px;
    }
  }

  @media (min-width: 900px) {
    .project-card {
      grid-template-columns: minmax(260px, 34%) minmax(0, 1fr);
    }

    .project-art {
      min-height: 320px;
      padding: 28px;
    }

    .project-art-image {
      max-width: min(100%, 260px);
      max-height: 260px;
    }

    .project-content {
      padding: 34px 40px;
    }
  }
</style>
