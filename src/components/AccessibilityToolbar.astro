---
// Floating display controls. No dependencies and no changes to the existing theme toggle.
---

<div id="drn-accessibility-toolbar" role="group" aria-label="Accessibility display options">
  <button
    id="drn-contrast-button"
    class="drn-toolbar-button"
    type="button"
    aria-label="Turn on high contrast"
    aria-pressed="false"
    title="High contrast"
  >
    <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24" width="23" height="23">
      <circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="1.8" />
      <path d="M12 3a9 9 0 0 0 0 18Z" fill="currentColor" />
    </svg>
  </button>
  <button
    id="drn-text-button"
    class="drn-toolbar-button"
    type="button"
    aria-label="Increase text size; currently 100 percent"
    title="Increase text size"
  >
    <span class="drn-text-icon" aria-hidden="true">A<sup>+</sup></span>
  </button>
  <span id="drn-accessibility-status" class="drn-visually-hidden" aria-live="polite" aria-atomic="true"></span>
</div>

<style is:global>
  /* Fixed pixel dimensions keep the toolbar usable while the site's rem-based text scales. */
  #drn-accessibility-toolbar {
    position: fixed;
    top: 50%;
    right: 0;
    transform: translateY(-50%);
    z-index: 60;
    width: 51px;
    padding: 4px 4px 4px 5px;
    display: flex;
    flex-direction: column;
    gap: 3px;
    border: 1px solid #777;
    border-right: 0;
    border-radius: 9px 0 0 9px;
    background: #fff;
    color: #151515;
    box-shadow: 0 2px 10px rgb(0 0 0 / 18%);
  }
  #drn-accessibility-toolbar .drn-toolbar-button {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 41px;
    height: 44px;
    flex: none;
    padding: 0;
    border: 1px solid transparent;
    border-radius: 5px;
    background: #fff;
    color: #151515;
    cursor: pointer;
  }
  #drn-accessibility-toolbar .drn-toolbar-button:hover {
    background: #e5e7eb;
    border-color: #444;
  }
  #drn-accessibility-toolbar .drn-toolbar-button[aria-pressed="true"] {
    background: #151515;
    color: #fff;
    border-color: #151515;
  }
  #drn-accessibility-toolbar .drn-toolbar-button:focus-visible {
    outline: 3px solid #1d4ed8;
    outline-offset: 2px;
  }
  #drn-accessibility-toolbar .drn-text-icon {
    font: 700 24px/1 Arial, sans-serif;
    letter-spacing: -1px;
  }
  #drn-accessibility-toolbar .drn-text-icon sup {
    position: relative;
    top: -3px;
    font: 700 15px/1 Arial, sans-serif;
  }
  #drn-accessibility-toolbar .drn-visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  /* Tailwind's text-size utilities use rem, so changing the root size scales the text. */
  html[data-drn-text-scale="1"] { font-size: 125% !important; }
  html[data-drn-text-scale="2"] { font-size: 150% !important; }
  html[data-drn-text-scale="3"] { font-size: 175% !important; }
  html[data-drn-text-scale="4"] { font-size: 200% !important; }

  /* Contrast mode is independent of the existing light/dark preference. */
  html.drn-high-contrast { color-scheme: light; }
  html.drn-high-contrast body { background: #fff !important; color: #000 !important; }
  html.drn-high-contrast body :is(header, nav, main, footer, section, article, aside, form, blockquote) {
    background-color: #fff !important;
    background-image: none !important;
    color: #000 !important;
  }
  html.drn-high-contrast body [class*="bg-"] {
    background-color: #fff !important;
    background-image: none !important;
  }
  html.drn-high-contrast body :is(h1, h2, h3, h4, h5, h6, p, li, span, small, strong, em, label, figcaption, dt, dd) {
    color: #000 !important;
    text-shadow: none !important;
  }
  html.drn-high-contrast body :is(a, a:visited) {
    color: #000 !important;
    text-decoration: underline !important;
    text-decoration-thickness: 2px !important;
  }
  html.drn-high-contrast body :is(button, input, select, textarea) {
    color: #000 !important;
    background-color: #fff !important;
    border-color: #000 !important;
  }
  html.drn-high-contrast body :is(header, nav, main, footer, section, article, aside, div, a, button, input, select, textarea) {
    border-color: #000 !important;
    box-shadow: none !important;
  }
  html.drn-high-contrast body a[class*="bg-"] {
    outline: 2px solid #000;
    outline-offset: 0;
  }
  html.drn-high-contrast body :is(a, button, input, select, textarea):focus-visible {
    outline: 3px solid #000 !important;
    outline-offset: 3px !important;
  }
  html.drn-high-contrast body .blur-3xl { display: none !important; }

  /* Preserve clear button states inside the toolbar even when contrast overrides are active. */
  html.drn-high-contrast #drn-accessibility-toolbar {
    background: #fff !important;
    color: #000 !important;
    border: 2px solid #000 !important;
    border-right: 0 !important;
    box-shadow: 0 2px 8px rgb(0 0 0 / 22%) !important;
  }
  html.drn-high-contrast #drn-accessibility-toolbar .drn-toolbar-button[aria-pressed="true"] {
    background: #000 !important;
    color: #fff !important;
    border-color: #000 !important;
  }
  html.drn-high-contrast #drn-accessibility-toolbar .drn-toolbar-button:focus-visible {
    outline-color: #000 !important;
  }
</style>

<script>
  const storageKey = 'drn-a11y-v2';
  const percentages = [100, 125, 150, 175, 200];

  function readPreferences() {
    try {
      const saved = JSON.parse(localStorage.getItem(storageKey) || '{}');
      return {
        highContrast: saved.highContrast === true,
        sizeIndex: [0, 1, 2, 3, 4].includes(saved.sizeIndex) ? saved.sizeIndex : 0,
      };
    } catch {
      return { highContrast: false, sizeIndex: 0 };
    }
  }

  function setupAccessibilityToolbar() {
    const toolbar = document.getElementById('drn-accessibility-toolbar');
    if (!toolbar || toolbar.dataset.initialized === 'true') return;

    const contrast = toolbar.querySelector<HTMLButtonElement>('#drn-contrast-button');
    const text = toolbar.querySelector<HTMLButtonElement>('#drn-text-button');
    const status = toolbar.querySelector<HTMLElement>('#drn-accessibility-status');
    if (!contrast || !text || !status) return;
    toolbar.dataset.initialized = 'true';

    const prefs = readPreferences();

    function update() {
      const root = document.documentElement;
      root.classList.toggle('drn-high-contrast', prefs.highContrast);
      root.dataset.drnTextScale = String(prefs.sizeIndex);

      contrast.setAttribute('aria-pressed', String(prefs.highContrast));
      const contrastLabel = prefs.highContrast ? 'Turn off high contrast' : 'Turn on high contrast';
      contrast.setAttribute('aria-label', contrastLabel);
      contrast.title = contrastLabel;

      const current = percentages[prefs.sizeIndex];
      const textLabel = prefs.sizeIndex === percentages.length - 1
        ? 'Reset text size to 100 percent'
        : `Increase text size; currently ${current} percent`;
      text.setAttribute('aria-label', textLabel);
      text.title = `${textLabel.replace('percent', '%')}`;
    }

    function save() {
      try {
        localStorage.setItem(storageKey, JSON.stringify(prefs));
      } catch {
        // Storage may be blocked; the controls still work for this page.
      }
    }

    contrast.addEventListener('click', () => {
      prefs.highContrast = !prefs.highContrast;
      update();
      save();
      status.textContent = prefs.highContrast ? 'High contrast on' : 'High contrast off';
    });
    text.addEventListener('click', () => {
      prefs.sizeIndex = (prefs.sizeIndex + 1) % percentages.length;
      update();
      save();
      status.textContent = `Text size ${percentages[prefs.sizeIndex]} percent`;
    });

    update();
  }

  setupAccessibilityToolbar();
  document.addEventListener('astro:page-load', setupAccessibilityToolbar);
</script>
